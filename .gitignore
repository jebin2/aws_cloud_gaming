# Holds a Tailscale auth key and your alert addresses. Never commit it.
# The wildcards matter: setup writes .env.bak-<timestamp> backups, and a plain
# ".env" rule does not match those - they carry exactly the same secrets.
.env
.env.*
!.env.example

# EC2 private keys.
*.pem

# AWS hands you credentials as a .csv download (CLI_accessKeys.csv,
# *_credentials.csv). If one is ever dropped in here, do not let it be
# committed - a leaked access key is an open door to the whole account.
*.csv

# Personal scratch.
clauderesumeid.txt

# Cached Cost Explorer figures, so cg status can show the month without
# paying $0.01 per call. Local, regenerable, and account-specific.
.cg-cache/

# The ntfy URL, written beside the host scripts for a box. Never in the repo: on
# ntfy.sh the topic is all it takes to read and post.
host/notify.url

# Python bytecode. A .pyc of lib/choose-games.py was committed once by accident.
__pycache__/
*.pyc

# The Stitch design export: the screens are kept, the zip they came in is not.
stitch_design/design.zip

# Electron app dependencies, and what electron-builder produces: a 200 MB
# unpacked Chromium per build.
app/node_modules/
app/dist/

# Identity and bank documents. Three of these were found sitting in the working
# tree during the AWS account verification of September 2026 - a statement, an
# unlocked copy of it, and a photo ID. `git add -A` would have published them to
# a public repo, permanently. They belong outside the checkout; these rules are
# the second line of defence, not the first.
*.pdf
Acct_Statement*
/stitch_design/*.png
