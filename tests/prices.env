# The prices the suites run with: fixed, so every figure they check is the same
# on every run and nothing asks AWS. The product reads none of these - it asks
# AWS's Price List API (lib/prices.py). Tax 0 keeps the expected rupee figures
# plain; tests/prices.sh checks GST on its own.
CG_S3_USD_GB_MONTH=0.025
CG_EBS_USD_GB_MONTH=0.0912
CG_SNAPSHOT_USD_GB_MONTH=0.05
CG_EGRESS_USD_GB=0.1093
CG_CE_CALL_USD=0.01
CG_XREGION_USD_GB=0.086
CG_IPV4_USD_HOUR=0.005
CG_EGRESS_FREE_GB=100
CG_TAX_PCT=0
