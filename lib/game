#!/usr/bin/env bash
# Reached through `cg`, not run directly. Layer 1: local control. Start, stream, and stop the instance as one action.
set -euo pipefail

cd "$(dirname "$0")/.."   # repo root: every path below is relative to it

# .env is written by provision.sh. Anything already exported wins over it.
if [[ -f .env ]]; then
  while IFS='=' read -r k v; do
    [[ $k == GAME_* && -z ${!k:-} ]] && export "$k=$v"
  done < .env
fi

INSTANCE_ID="${GAME_INSTANCE_ID:-i-CHANGEME}"
REGION="${GAME_REGION:-ap-south-2}"
TS_HOST="${GAME_TS_HOST:-gamevps}"
# The tailnet name can differ from the AWS resource name when a stale node held
# the hostname; setup records the real one. AWS resources still use TS_HOST.
TS_NODE="${GAME_TS_NODE:-$TS_HOST}"
APP="${GAME_APP:-Desktop}"

ec2() { aws ec2 "$@" --region "$REGION"; }

# shellcheck source=lib/common.sh
source lib/common.sh

state() {
  ec2 describe-instances --instance-ids "$INSTANCE_ID" \
    --query 'Reservations[0].Instances[0].State.Name' --output text
}

box() { # run a command on the host over the tailnet
  ssh -i "$HOME/.ssh/${TS_HOST}.pem" -o StrictHostKeyChecking=accept-new \
      -o ConnectTimeout=10 -o BatchMode=yes "ubuntu@$(tailscale ip -4 "$TS_NODE")" "$@"
}

disks() {
  # Root cannot be shrunk once grown, so its usage is the number worth watching;
  # /scratch is local NVMe and holds the games, and is wiped on every stop - the
  # S3 mirror is what makes that survivable (cg library).
  box 'df -h --output=target,used,size,pcent / /scratch 2>/dev/null | sed "s/^/  /"' \
    2>/dev/null || echo "  (host unreachable - box stopped?)"
}

wait_for() { # wait_for <desc> <tries> <cmd...>
  local desc=$1 tries=$2; shift 2
  printf '%s' "$desc"
  for _ in $(seq 1 "$tries"); do
    if "$@" &>/dev/null; then printf ' ok\n'; return 0; fi
    printf '.'; sleep 2
  done
  printf ' TIMEOUT\n'; return 1
}

# A persistent spot request goes to `disabled` when YOU stop its instance, and
# AWS refuses to start a stopped spot instance from there. This was tested and
# written up in docs/troubleshooting.md long before it was handled here, so
# `cg open` met it as a raw API error:
#
#   IncorrectSpotRequestState ... the associated Spot Instance request is not
#   in an appropriate state to support start
#
# which says nothing about what to do, nor that the now-unusable box keeps
# billing for its root volume.
spot_request_state() {
  aws ec2 describe-spot-instance-requests --region "$REGION" \
    --filters "Name=instance-id,Values=$INSTANCE_ID" \
    --query 'SpotInstanceRequests[0].State' --output text 2>/dev/null || echo unknown
}
instance_lifecycle() {
  ec2 describe-instances --instance-ids "$INSTANCE_ID" \
    --query 'Reservations[0].Instances[0].InstanceLifecycle' --output text 2>/dev/null || echo none
}

up() {
  if [[ $(state) == running ]]; then
    echo "instance already running"
  else
    # Checked BEFORE calling start, so the explanation replaces the API error
    # rather than following it.
    if [[ $(instance_lifecycle) == spot ]]; then
      local srs; srs=$(spot_request_state)
      if [[ $srs != active ]]; then
        echo
        echo "This box cannot be started again."
        echo
        echo "  It is a SPOT instance and its spot request is '$srs'. Stopping a spot"
        echo "  instance yourself disables its request, and AWS refuses to start an"
        echo "  instance whose request is not active. There is no way to re-enable it."
        echo
        echo "  Meanwhile the stopped box still bills for its root volume."
        echo
        echo "  Your games are in S3, so throwing this box away costs nothing:"
        echo
        echo "      cg destroy && cg init          # rebuild, ~6 min, games restored"
        echo
        echo "  To get stop/start back, build on demand instead - dearer per hour,"
        echo "  but it can be stopped and restarted as often as you like:"
        echo
        echo "      cg destroy && GAME_SPOT=0 cg init"
        echo
        die "spot request is '$srs'"
      fi
    fi
    echo "starting $INSTANCE_ID ..."
    ec2 start-instances --instance-ids "$INSTANCE_ID" >/dev/null
    wait_instance_state "$REGION" "$INSTANCE_ID" running
  fi

  # Arm layer 3 only now. Outside a session the box is idle for legitimate
  # reasons (setup, updates) and an armed alarm would stop it mid-task.
  ec2_cw() { aws cloudwatch "$@" --region "$REGION"; }
  ec2_cw enable-alarm-actions --alarm-names "${TS_HOST}-idle-stop" 2>/dev/null || true

  wait_for "waiting for tailscale" 60 tailscale ping -c 1 --timeout 2s "$TS_NODE"

  # Confirm the path is direct. A relayed path adds tens of ms.
  local path
  path=$(tailscale ping -c 1 "$TS_NODE" 2>/dev/null | tail -1)
  echo "  $path"
  [[ $path == *relay* ]] && echo "  WARNING: relayed, not direct - latency will suffer"

  local ip; ip=$(tailscale ip -4 "$TS_NODE")
  wait_for "waiting for sunshine" 60 \
    timeout 2 bash -c ">/dev/tcp/$ip/47989"

  echo "disk:"; disks

  local t0=$SECONDS
  # Stream settings come from .env as launch flags rather than by rewriting
  # Moonlight's config: the flags win for this session and leave whatever you
  # set in the GUI untouched. A variable left unset passes no flag at all, so
  # Moonlight's own saved setting remains the default.
  local mlf=()
  [[ -n ${GAME_RES:-} ]]          && mlf+=(--resolution "$GAME_RES") || true
  [[ -n ${GAME_FPS:-} ]]          && mlf+=(--fps "$GAME_FPS") || true
  [[ -n ${GAME_BITRATE_KBPS:-} ]] && mlf+=(--bitrate "$GAME_BITRATE_KBPS") || true
  [[ -n ${GAME_DISPLAY_MODE:-} ]] && mlf+=(--display-mode "$GAME_DISPLAY_MODE") || true
  [[ -n ${GAME_VIDEO_CODEC:-} ]]  && mlf+=(--video-codec "$GAME_VIDEO_CODEC") || true
  [[ ${GAME_PERF_OVERLAY:-0} == 1 ]] && mlf+=(--performance-overlay) || true
  (( ${#mlf[@]} )) && echo "    stream: ${mlf[*]}" || true
  moonlight stream ${mlf[@]+"${mlf[@]}"} "$ip" "$APP" || true
  printf 'session ended after %dm\n' $(( (SECONDS - t0) / 60 ))

  end_session
}

# How a session ends, for both `cg stop` and the prompt above - one function so
# the two cannot drift apart.
#
# On spot there is no stop worth offering. A one-time request cannot be stopped
# at all (AWS only allows it for persistent requests), and a persistent one that
# is stopped becomes permanently unstartable while its root volume keeps
# billing. Either way the answer is destroy, and that is free of consequence now
# that the games are mirrored to S3 - which is exactly why the purchase model
# could be changed to one-time in the first place.
end_session() {
  local a
  if [[ $(instance_lifecycle) == spot ]]; then
    echo
    echo "This is a SPOT instance, so there is nothing useful to stop:"
    echo "  - a one-time spot instance cannot be stopped at all"
    echo "  - stopping a persistent one disables its request, and it can then"
    echo "    NEVER start again while its root volume keeps billing"
    echo
    echo "Your games are mirrored to S3, so destroying costs a ~6 min rebuild"
    echo "and nothing else."
    echo
    read -rp "[d] destroy (recommended)  [n] leave it running: " a
    case "${a:-d}" in
      d|D|"") exec ./cg destroy ;;
      *)      echo "left running - it is STILL BILLING by the hour" ;;
    esac
    return
  fi
  read -rp "stop instance now? [Y/n] " a
  [[ ${a:-Y} =~ ^[Nn]$ ]] || down
}

# The mirror is written HERE, in the one function every stop path goes through:
# `cg stop`, the "stop instance now?" prompt at the end of `cg open`, and the
# pre-image stop in destroy. There is no timer and no pre-shutdown hook on the
# box, deliberately - so if this does not run, the instance store is wiped and
# the games are gone. That is why a failure aborts the stop instead of printing
# a warning beside it.
mirror_library() {
  tailscale ip -4 "$TS_NODE" >/dev/null 2>&1 || {
    log "box is not reachable over the tailnet - cannot mirror the library"; return 1; }
  say "mirroring the game library to S3 (the instance store is wiped on stop)"
  box '/usr/local/bin/cg-library push' 2>&1 | sed 's/^/      /'
  return "${PIPESTATUS[0]}"
}

down() {
  [[ $(state) == stopped ]] && { echo "already stopped"; return; }
  if ! mirror_library; then
    if [[ ${CG_FORCE:-0} != 1 ]]; then
      echo
      echo "  The push from here failed - usually ssh cannot reach the box."
      echo "  cg-library-shutdown.service mirrors from ON the box as it shuts"
      echo "  down and needs no ssh, so --force is usually safe. Check after:"
      echo "      cg library list"
      echo
      die "not mirrored from here - see above, then: cg stop --force"
    fi
    log "WARNING: stopping without a mirror (--force) - games will be re-downloaded"
  fi
  ec2 stop-instances --instance-ids "$INSTANCE_ID" >/dev/null
  wait_instance_state "$REGION" "$INSTANCE_ID" stopped
  log "billing has ended"
}

destroy() {
  local s; s=$(state)
  [[ $s == terminated ]] && { echo "already terminated"; return; }

  local vol_gb
  vol_gb=$(ec2 describe-instances --instance-ids "$INSTANCE_ID" \
    --query 'Reservations[0].Instances[0].BlockDeviceMappings[0].Ebs.VolumeId' --output text)
  vol_gb=$(ec2 describe-volumes --volume-ids "$vol_gb" --query 'Volumes[0].Size' --output text 2>/dev/null || echo "?")

  echo "This deletes $INSTANCE_ID and its ${vol_gb} GB disk. Everything on it goes."
  read -rp "terminate? [y/N] " a
  [[ ${a:-N} =~ ^[Yy]$ ]] || { echo "cancelled"; return; }

  # Worth saving when the box holds a working setup you would rather not rebuild;
  # not worth it for a scratch box or a build you intend to redo from scratch.
  # An image costs roughly a tenth of the live volume per month.
  echo
  echo "An image keeps the installed desktop so `cg init` can restore it in minutes"
  echo "instead of rebuilding (~20 min). It costs ~10% of the volume's monthly price."
  read -rp "save an image first? [Y/n] " snap
  if [[ ! ${snap:-Y} =~ ^[Nn]$ ]]; then
    # A stopped instance gives a consistent image without --no-reboot games.
    [[ $s == running ]] && down
    local name ami
    name="${TS_HOST}-$(date -u +%Y%m%d-%H%M%S)"
    echo "creating image $name (several minutes) ..."
    ami=$(ec2 create-image --instance-id "$INSTANCE_ID" --name "$name" \
      --description "cloud_gaming saved desktop" \
      --tag-specifications "ResourceType=image,Tags=[{Key=Name,Value=${TS_HOST}-image}]" \
      --query ImageId --output text)
    echo "  $ami"
    wait_image_available "$REGION" "$ami"
    echo "  image ready; cg init will restore from it"
  fi

  # A persistent spot request launches a replacement the moment its instance
  # is terminated, so it has to go first.
  local req
  req=$(ec2 describe-spot-instance-requests \
    --filters "Name=instance-id,Values=$INSTANCE_ID" \
    --query 'SpotInstanceRequests[0].SpotInstanceRequestId' --output text 2>/dev/null || echo None)
  if [[ -n $req && $req != None ]]; then
    echo "cancelling spot request $req"
    ec2 cancel-spot-instance-requests --spot-instance-request-ids "$req" >/dev/null
  fi

  echo "terminating ..."
  ec2 terminate-instances --instance-ids "$INSTANCE_ID" >/dev/null
  wait_instance_state "$REGION" "$INSTANCE_ID" terminated
  sed -i '/^GAME_INSTANCE_ID=/d' .env 2>/dev/null || true
  echo "terminated; disk deleted. Only the saved image (if any) still bills."
}

status() {
  echo "instance: $(state)"
  echo "disk:"; disks
}

clean() {
  [[ $(state) == running ]] || { echo "box is not running; start it first"; return 1; }
  echo "This clears temp files and browser downloads on /scratch."
  echo "Installed games are in /scratch/steam and are NOT touched."
  read -rp "continue? [y/N] " a
  [[ ${a:-N} =~ ^[Yy]$ ]] || { echo "cancelled"; return; }
  # NAMED directories only. This used to wipe everything directly under
  # /scratch, which was safe when the games lived on a separate volume and is
  # now the fastest way to delete a 140 GB library - the mirror would then
  # faithfully propagate the deletion to S3 at the next push.
  box 'sudo rm -rf /scratch/tmp /scratch/downloads && \
       sudo /usr/local/bin/mount-scratch.sh && echo "  /scratch/tmp and /scratch/downloads cleared"'
  echo "after:"; disks
}

case "${1:-up}" in
  up)          up ;;
  stop|down)   end_session ;;
  status)      status ;;
  clean)       clean ;;
  destroy)     destroy ;;
  *) echo "usage: game [up|stop|status|clean|destroy]" >&2; exit 1 ;;
esac

# Explicit exit, and not decoration. Bash does not load a script - it reads a
# command, runs it, then SEEKS BACK to read the next one. After the final
# command completes it returns to read again, and if the file changed in the
# meantime (an edit, a git pull, a git checkout) that read lands at a stale byte
# offset, mid-statement:
#
#     ./lib/game: line N: syntax error near unexpected token `;;'
#
# which is what a 5-minute `game destroy` did when the file was edited underneath
# it. Every real step had already completed; the error came from bash looking
# for more input after the dispatch finished. `exit` means it never looks.
# (The `exec` branches were always immune - exec replaces the process.)
exit
