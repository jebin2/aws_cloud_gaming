{
  "name": "ayis-app",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop viewer for ayis - the scripts stay the engine",
  "main": "main/index.js",
  "scripts": {
    "start": "npm run build:ayis && npm run build:css && electron .",
    "test": "node --test test/*.test.mjs",
    "build:css": "tailwindcss -i renderer/src.css -o renderer/tailwind.css --minify",
    "dist": "npm run build:ayis && npm run build:css && electron-builder",
    "pack": "npm run build:ayis && npm run build:css && electron-builder --dir",
    "build:ayis": "node scripts/build-ayis.js"
  },
  "devDependencies": {
    "electron": "^39.2.4",
    "tailwindcss": "^3.4.19",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.ayis.desktop",
    "productName": "Ayis",
    "asar": true,
    "files": [
      "main/**",
      "renderer/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "pacman",
        "tar.gz"
      ],
      "category": "Game",
      "icon": "build/icon.png",
      "synopsis": "Ayis: All Yours, Instantly Streamed",
      "description": "Runs ayis, a single program, and renders what it says. It holds no AWS logic of its own.",
      "maintainer": "jebin2 <noreply@users.noreply.github.com>",
      "extraResources": [
        {
          "from": "../ayis",
          "to": "ayis/ayis"
        }
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games",
      "icon": "build/icon.png",
      "artifactName": "ayis-${version}-mac-${arch}.${ext}",
      "identity": null,
      "extraResources": [
        {
          "from": "../ayis",
          "to": "ayis/ayis"
        }
      ]
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.png",
      "artifactName": "ayis-${version}-win-portable.${ext}",
      "extraResources": [
        {
          "from": "../ayis.exe",
          "to": "ayis/ayis.exe"
        }
      ]
    },
    "executableName": "ayis",
    "extraResources": [
      {
        "from": "../.env.example",
        "to": "ayis/.env.example"
      }
    ],
    "pacman": {
      "depends": [
        "gtk3",
        "nss",
        "alsa-lib",
        "libcups",
        "libdrm",
        "mesa"
      ]
    }
  },
  "author": "jebin2",
  "homepage": "https://github.com/jebin2/ayis",
  "repository": {
    "type": "git",
    "url": "https://github.com/jebin2/ayis.git"
  },
  "license": "MIT"
}
