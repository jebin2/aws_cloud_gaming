{
  "name": "cg-app",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop viewer for cg - the scripts stay the engine",
  "main": "main/index.js",
  "scripts": {
    "start": "npm run build:css && electron .",
    "test": "node --test test/*.test.mjs",
    "build:css": "tailwindcss -i renderer/src.css -o renderer/tailwind.css --minify",
    "dist": "npm run build:css && electron-builder",
    "pack": "npm run build:css && electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^39.2.4",
    "tailwindcss": "^3.4.19",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.cg.desktop",
    "productName": "cg",
    "asar": true,
    "files": [
      "main/**",
      "renderer/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "executableName": "cg"
  },
  "author": "jebin2"
}
