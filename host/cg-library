#!/usr/bin/env bash
# The game library, on the box: local NVMe, mirrored to S3 PER GAME.
#
#   pull [--apps <csv|all|none>]   S3 -> /scratch/steam   (at boot, in parallel)
#   push [--force|--verify]        /scratch/steam -> S3   (at stop and destroy)
#   list                           what is archived, and how big
#   forget <appid>                 delete one game from the archive
#   check                          would a push transfer anything?
#   status                         local vs archive
#
# WHY PER GAME. A g6.xlarge holds 229 GB and two modern titles do not fit
# together, so the archive has to hold more than the disk does. The old whole-
# tree sync could not: it mirrored the disk with --delete, so installing one
# game deleted the other from S3. It also made "push an empty disk" a live
# threat that a size guard had to catch. Syncing each app into its own prefix,
# and never touching an app that is not installed, removes both - the second one
# by construction rather than by vigilance.
#
# The cost is that the archive no longer shrinks on its own: `forget` exists
# because otherwise you pay for games you stopped playing.
#
# LAYOUT. Unchanged from the whole-tree version, so nothing had to be migrated -
# it is the same paths, synced in four pieces per app:
#
#   steamapps/appmanifest_<id>.acf
#   steamapps/common/<installdir>/        (installdir comes from the manifest)
#   steamapps/compatdata/<id>/            (the Proton prefix: saves, registry)
#   steamapps/shadercache/<id>/
#
# plus two things outside any app:
#   steam/index.json               appid, name, installdir, bytes, pushed
#   steam/meta/symlinks-<id>.tsv   S3 cannot store a symlink; see restore_symlinks
set -uo pipefail

[[ -r /etc/cg-library.conf ]] && . /etc/cg-library.conf

LIB="${CG_LIB_DIR:-/scratch/steam}"
BUCKET="${CG_S3_BUCKET:-}"
PREFIX="${CG_S3_PREFIX:-steam}"
STATE="${CG_STATE_DIR:-/var/lib/cg-library}"
S5="${CG_S5CMD:-/usr/local/bin/s5cmd}"
# Which apps this boot should restore. Chosen on the laptop before launch and
# baked into /etc/cg-library.conf, because the restore runs here at boot with no
# terminal to ask at.
APPS="${CG_APPS:-all}"

# s5cmd holds roughly workers x concurrency x part-size in memory. The defaults
# (256 x 5 x 50 MB) want tens of GB. 64 x 4 x 16 MB measured at 323 MB peak.
# The Steam account lives on the ROOT disk, not in the library: config.vdf holds
# the refresh token, loginusers.vdf the remembered account, registry.vdf the
# machine identity Steam Guard checks. All three die with the box unless they
# are archived, which is why every new instance asked for Steam Guard again.
STEAM_BASE="${CG_STEAM_BASE:-$HOME}"
STEAM_DIR="${CG_STEAM_DIR:-.local/share/Steam}"
# Best-effort `steam -shutdown` before archiving. Steam rewrites config.vdf as
# it exits, so a clean exit archives the settled file rather than a mid-session
# one. Set 0 to archive whatever is on disk right now.
STEAM_SHUTDOWN="${CG_STEAM_SHUTDOWN:-1}"

WORKERS="${CG_WORKERS:-64}"
CONCURRENCY="${CG_CONCURRENCY:-4}"
PART_MB="${CG_PART_MB:-16}"
# --no-follow-symlinks is not a nicety. A Proton prefix contains
# dosdevices/z: -> / and s: -> the library itself, so a symlink-following walk
# descends into the whole filesystem AND into itself: 12 GB resident and an OOM
# kill on a 2.9 GB library. Worker tuning changed nothing, because the file list
# was exploding, not the transfer buffers.
TUNE=(--concurrency "$CONCURRENCY" --part-size "$PART_MB" --no-follow-symlinks)
EXCLUDES=(--exclude "downloading/*" --exclude "temp/*")

log() { echo "$(date -Iseconds) cg-library: $*"; }
die() { log "error: $*" >&2; exit 1; }
hb()  { numfmt --to=iec --suffix=B "${1:-0}" 2>/dev/null || echo "${1:-0}B"; }

[[ -n $BUCKET ]] || die "no bucket configured (expected CG_S3_BUCKET in /etc/cg-library.conf)"
[[ -x $S5 ]] || die "s5cmd not installed at $S5"
mkdir -p "$STATE" 2>/dev/null || true

S3="s3://$BUCKET/$PREFIX"

# The marker records WHICH boot restored the library, not merely that some boot
# did: /var/lib is on the root volume and survives a reboot, /scratch does not.
BOOT_ID_FILE="${CG_BOOT_ID_FILE:-/proc/sys/kernel/random/boot_id}"
boot_id() { cat "$BOOT_ID_FILE" 2>/dev/null || echo unknown; }
mark_restored() { boot_id > "$STATE/restored"; }
restored() {
  [[ -f "$STATE/restored" ]] || return 1
  [[ "$(cat "$STATE/restored" 2>/dev/null)" == "$(boot_id)" ]]
}

# --- what is installed here --------------------------------------------------
# appid<TAB>installdir<TAB>name, one per line, from the manifests on disk.
# Proton, the Steam Linux Runtimes and the anti-cheat/redistributable runtimes
# are tools, not games. It was decided on 2026-09-13 not to mirror them - Steam
# re-fetches them in under a minute - but Steam sometimes installs them into
# /scratch/steam, and on 2026-09-14 a push archived four of them (3.2 GB) as if
# they were games. Per-game archiving never removes an absent app, so once in,
# they stayed. Matched by installdir, so new Proton versions are covered too.
is_steam_tool() { # is_steam_tool <appid> <installdir>
  # "Proton " with the space: every real one is "Proton 9.0", "Proton - Experimental",
  # "Proton Voice Files"... while a bare Proton* would also swallow a game
  # installed as "ProtonHunter".
  case "$2" in Proton|"Proton "*|SteamLinuxRuntime*) return 0 ;; esac
  # Steamworks Common Redistributables, Proton EasyAntiCheat, Proton BattlEye.
  case "$1" in 228980|1826330|1161040) return 0 ;; esac
  return 1
}

local_apps() {
  local f id dir name flags
  for f in "$LIB"/steamapps/appmanifest_*.acf; do
    [[ -f $f ]] || continue
    id=$(basename "$f" .acf); id=${id#appmanifest_}
    dir=$(sed -n 's/.*"installdir"[[:space:]]*"\(.*\)".*/\1/p' "$f" | head -1)
    name=$(sed -n 's/.*"name"[[:space:]]*"\(.*\)".*/\1/p' "$f" | head -1)
    flags=$(sed -n 's/.*"StateFlags"[[:space:]]*"\([0-9]*\)".*/\1/p' "$f" | head -1)
    [[ -n $id && -n $dir ]] || continue
    if is_steam_tool "$id" "$dir"; then
      # stderr: this runs inside $(...), and a log on stdout would become an app.
      log "not archiving $name ($id) - a Steam tool, re-downloaded in under a minute" >&2
      continue
    fi
    printf '%s\t%s\t%s\t%s\n' "$id" "$dir" "${name:-$dir}" "${flags:-0}"
  done
}

# Steam's own verdict on whether a game is whole.
#
# StateFlags 4 is FullyInstalled. Anything with UpdateStarted (1024),
# UpdateRequired (2), FilesMissing (32), FilesCorrupt (128) or UpdatePaused
# (512) set is a game mid-flight, and archiving one means pushing a partial copy
# over a complete archive - with --delete, which removes what is missing.
#
# The size guard does not catch this: it fires below HALF the archive, and a
# game 54% restored and mid-repair sails through. Steam knows the answer exactly,
# so ask Steam rather than inferring it from bytes.
app_is_whole() {   # app_is_whole <stateflags>
  local n=$((${1:-0}))
  (( n & 4 )) || return 1                      # not fully installed
  (( n & (1024 | 2 | 32 | 128 | 512) )) && return 1
  return 0
}

app_bytes() { # app_bytes <installdir> <appid>
  local total=0 d
  for d in "$LIB/steamapps/common/$1" "$LIB/steamapps/compatdata/$2" "$LIB/steamapps/shadercache/$2"; do
    [[ -d $d ]] || continue
    total=$(( total + $(du -sb --exclude=downloading --exclude=temp "$d" 2>/dev/null | cut -f1 || echo 0) ))
  done
  echo "$total"
}

# --- the index ---------------------------------------------------------------
# One small object so the laptop can show sizes without listing 300k keys before
# the box even exists. Read with the AWS CLI on the laptop, s5cmd here.
index_get() { "$S5" cat "$S3/index.json" 2>/dev/null || echo '{"apps":[]}'; }

index_put() { # index_put <json>
  local t; t=$(mktemp)
  printf '%s\n' "$1" > "$t"
  "$S5" cp "$t" "$S3/index.json" >/dev/null 2>&1 || log "WARNING: could not write the index"
  rm -f "$t"
}

# Merge the apps just pushed into whatever the index already holds, so pushing
# one game does not erase the record of the others - the same rule the object
# sync follows.
index_merge() { # index_merge <appid> <installdir> <name> <bytes>
  index_get | python3 -c '
import json,sys,time
appid,installdir,name,size = sys.argv[1:5]
try:    d=json.load(sys.stdin)
except Exception: d={"apps":[]}
apps=[a for a in d.get("apps",[]) if str(a.get("appid"))!=appid]
apps.append({"appid":appid,"name":name,"installdir":installdir,
             "bytes":int(size),"pushed":time.strftime("%Y-%m-%dT%H:%M:%SZ",time.gmtime())})
apps.sort(key=lambda a:-a["bytes"])
print(json.dumps({"apps":apps},indent=1))' "$1" "$2" "$3" "$4"
}

index_drop() { # index_drop <appid>
  index_get | python3 -c '
import json,sys
appid=sys.argv[1]
try:    d=json.load(sys.stdin)
except Exception: d={"apps":[]}
print(json.dumps({"apps":[a for a in d.get("apps",[]) if str(a.get("appid"))!=appid]},indent=1))' "$1"
}

# --- symlinks ----------------------------------------------------------------
# S3 has no symlinks and --no-follow-symlinks skips them, which is right for the
# Proton runtime (Steam rebuilds its own trees) and WRONG for a game's prefix:
# Proton sees a current version file, never recreates dosdevices/c: or z:, and a
# prefix with an empty dosdevices cannot resolve one Windows path - the game
# simply does not start. Recorded per app, so restoring one game brings back its
# links and leaves another game's records untouched.
symlinks_record() { # symlinks_record <appid> <installdir>
  local out; out=$(mktemp)
  ( cd "$LIB" && find "steamapps/common/$2" "steamapps/compatdata/$1" \
      "steamapps/shadercache/$1" -type l -printf '%p\t%l\n' 2>/dev/null ) > "$out"
  if [[ -s $out ]]; then
    "$S5" cp "$out" "$S3/meta/symlinks-$1.tsv" >/dev/null 2>&1 \
      && log "  recorded $(grep -c . "$out") symlinks"
  else
    "$S5" rm "$S3/meta/symlinks-$1.tsv" >/dev/null 2>&1 || true
  fi
  rm -f "$out"
}

symlinks_restore() { # symlinks_restore <appid>
  local f made=0 skipped=0 link target
  f=$(mktemp)
  if ! "$S5" cp "$S3/meta/symlinks-$1.tsv" "$f" >/dev/null 2>&1 || [[ ! -s $f ]]; then
    rm -f "$f"; return 0
  fi
  while IFS=$'\t' read -r link target; do
    [[ -n ${link:-} && -n ${target:-} ]] || continue
    if [[ -e "$LIB/$link" || -L "$LIB/$link" ]]; then skipped=$((skipped+1)); continue; fi
    mkdir -p "$(dirname "$LIB/$link")" 2>/dev/null
    ln -sfn "$target" "$LIB/$link" 2>/dev/null && made=$((made+1))
  done < "$f"
  rm -f "$f"
  log "  symlinks: $made recreated, $skipped already present"
}

# --- pull --------------------------------------------------------------------
cmd_pull() {
  local want="${1:-$APPS}"
  local parent; parent=$(dirname "$LIB")
  # Never restore onto the root disk: if /scratch failed to mount, the games
  # would land on the 50 GB root volume and fill it.
  mountpoint -q "$parent" || die "$parent is not a mountpoint - refusing to restore onto the root disk"
  mkdir -p "$LIB/steamapps"

  # Before anything else, and regardless of which games were chosen: the login
  # lives on the root disk, so it is gone on every new box, and a boot that
  # restores no games at all still wants Steam signed in.
  account_pull

  if [[ $want == none ]]; then
    log "CG_APPS=none - restoring nothing by request (the box is for something else)"
    mark_restored
    return 0
  fi

  local idx; idx=$(index_get)
  local chosen
  chosen=$(printf '%s' "$idx" | python3 -c '
import json,sys
want=sys.argv[1]
try:    apps=json.load(sys.stdin).get("apps",[])
except Exception: apps=[]
if want=="all": sel=apps
else:
    ids={w.strip() for w in want.split(",") if w.strip()}
    sel=[a for a in apps if str(a.get("appid")) in ids]
for a in sel: print("%s\t%s\t%s\t%s" % (a["appid"], a.get("installdir",""), a.get("name",""), a.get("bytes",0)))' "$want")

  if [[ -z ${chosen//[[:space:]]/} ]]; then
    log "archive holds nothing to restore for '$want' (first run, or an unknown appid)"
    mark_restored
    return 0
  fi

  # Capacity, enforced HERE and not only in the laptop prompt. CG_APPS can say
  # "all" from an older .env, from a scripted run, or from a prompt that was
  # skipped - and an archive larger than the disk would then fill /scratch
  # mid-restore, which fails in the least legible way possible: a half-restored
  # game that Steam reports as installed.
  local avail_kb avail
  avail_kb=$(df --output=avail -k "$LIB" 2>/dev/null | tail -1 | tr -d ' ')
  avail=$(( ${avail_kb:-0} * 1024 ))
  # CG_RESERVE_GB because a g6.2xlarge has 450 GB and this should not assume a
  # g6.xlarge; CG_DISK_BUDGET to set the ceiling outright, which is how the
  # tests exercise the skip path without a 300 GB sandbox.
  local reserve=$(( ${CG_RESERVE_GB:-20} * 1024 * 1024 * 1024 ))
  local budget=${CG_DISK_BUDGET:-$(( avail - reserve ))}
  (( budget < 0 )) && budget=0
  log "disk budget $(hb "$budget") ($(hb "$avail") free, $(hb "$reserve") reserved)"

  local t0 dt id dir name total=0 skipped=0 used=0 want_bytes incomplete=0
  t0=$(date +%s)
  while IFS=$'\t' read -r id dir name bytes; do
    [[ -n ${id:-} ]] || continue
    want_bytes=${bytes:-0}
    # What is ALREADY here counts against what still has to be fetched.
    #
    # The bootstrap ends with a reboot, which kills the restore mid-transfer by
    # design - so the run that matters is usually a RESUME. Comparing the game's
    # full size against free space double-counts whatever the interrupted run
    # already wrote: 44 GB landed, the next run saw 173 GB free, subtracted the
    # 20 GB reserve and refused to fetch a "159 GB" game that actually needed
    # 115 GB more. The game was then skipped while its manifest was already on
    # disk, so Steam reported it installed with a quarter of its files.
    local have need
    have=$(du -sb --exclude=downloading --exclude=temp \
      "$LIB/steamapps/common/$dir" "$LIB/steamapps/compatdata/$id" \
      "$LIB/steamapps/shadercache/$id" 2>/dev/null | awk '{t+=$1} END{print t+0}')
    need=$(( want_bytes - ${have:-0} )); (( need < 0 )) && need=0
    if (( used + need > budget )); then
      log "SKIPPING $name ($id): needs $(hb "$need") more, only $(hb $(( budget - used ))) left"
      (( ${have:-0} > 0 )) && log "  ($(hb "$have") of $(hb "$want_bytes") is already here)"
      log "  restore it on its own later: cg library pull --apps $id"
      skipped=$((skipped+1))
      continue
    fi
    used=$(( used + need ))
    log "restoring $name ($id, $(hb "$want_bytes"))"
    # No manifest means push never completed for this game (it is written last,
    # on purpose). Restoring the files without it would leave Steam with an
    # unreferenced directory; restoring a manifest that was never written is
    # impossible. Either way the honest answer is that the game is not there.
    if ! "$S5" cp "$S3/steamapps/appmanifest_$id.acf" "$LIB/steamapps/" >/dev/null 2>&1; then
      log "  SKIPPING $name - no manifest in the archive, so it was never fully pushed"
      skipped=$((skipped+1)); used=$(( used - want_bytes ))
      continue
    fi
    local src dst
    # NO `|| true` here. It used to swallow every failure, so a sync that died
    # partway still reported success, still set the restored marker, and handed
    # Steam a game with 73 GB of 158.7 GB present - which Steam reports as
    # "unable to retrieve necessary data" and repairs by downloading the rest.
    # A restore that silently half-works is worse than one that fails, because
    # the failure is discovered by the game instead of by the tool.
    local rc=0
    for pair in "common/$dir" "compatdata/$id" "shadercache/$id"; do
      src="$S3/steamapps/$pair/*"; dst="$LIB/steamapps/$pair/"
      mkdir -p "$dst"
      # stderr is kept: an s5cmd error in the journal is the only clue to why.
      if ! "$S5" --numworkers "$WORKERS" sync --size-only "${TUNE[@]}" "$src" "$dst" 2>&1 \
           | grep -vE '^$' | tail -5 | sed 's/^/    s5cmd: /'; then :; fi
      # PIPESTATUS[0], not $?, which is the sed at the end of that pipeline.
      (( ${PIPESTATUS[0]:-0} == 0 )) || { rc=1; log "  FAILED syncing $pair"; }
    done
    symlinks_restore "$id"

    # Measure what actually landed, and compare it with what the index promised.
    # The old completion line printed the INDEX size whatever happened on disk -
    # it would have said "restored 158.7 GB" over a 73 GB directory.
    local got; got=$(du -sb --exclude=downloading --exclude=temp \
      "$LIB/steamapps/common/$dir" "$LIB/steamapps/compatdata/$id" \
      "$LIB/steamapps/shadercache/$id" 2>/dev/null | awk '{t+=$1} END{print t+0}')
    if (( want_bytes > 0 )) && (( got * 100 < want_bytes * 98 )); then
      rc=1
      log "  INCOMPLETE: $(hb "$got") on disk of $(hb "$want_bytes") archived"
      log "  Steam will report missing data and re-download the rest."
    fi
    if (( rc )); then incomplete=$((incomplete+1)); fi
    total=$((total+1))
  done <<< "$chosen"

  # Shared, tiny, and needed for Steam to accept the folder as a library.
  "$S5" cp "$S3/steamapps/libraryfolder.vdf" "$LIB/steamapps/" >/dev/null 2>&1 || true
  dt=$(( $(date +%s) - t0 )); (( dt > 0 )) || dt=1
  log "restored $total game(s) in ${dt}s"
  (( skipped )) && log "$skipped game(s) skipped for space - see above"
  if (( incomplete )); then
    # No marker: a partial local copy must never be pushed over a complete
    # archive. Steam will repair the install by downloading the remainder; once
    # it has, `cg library push --force` is the way to archive the repaired copy.
    log "$incomplete game(s) restored INCOMPLETE - not marking this boot as restored"
    log "  the archive is intact; push is blocked until you pass --force"
    return 1
  fi
  mark_restored
}

# --- the Steam account (login, not games) ------------------------------------
# One small tarball, not an s5cmd sync: these are a handful of files whose modes
# matter (config.vdf is 0600 and Steam cares), and a tarball lands atomically -
# a half-synced login directory is worse than no login at all.
ACCOUNT_OBJ="$S3/account/steam-account.tgz"
# Caches, not credentials: regenerated on demand, and they dwarf what is worth
# keeping. These bite on userdata/, which IS walked as a directory - librarycache
# alone is megabytes of box art. config/ is not walked (account_members names its
# two files), so htmlcache and avatarcache are belt-and-braces against that list
# ever becoming a directory, not load-bearing today.
ACCOUNT_EXCLUDES=(--exclude=htmlcache --exclude=avatarcache --exclude=librarycache
                  --exclude=shaderhitcache --exclude=depotcache --exclude='*.crash')
ACCOUNT_MAX=$(( 64 * 1024 * 1024 ))

steam_running() { pgrep -x steam >/dev/null 2>&1; }

# The paths that carry the login, relative to $STEAM_BASE so tar can restore
# them into a different home in tests. Only those that exist are returned:
# tar fails the whole archive on one missing member, and ssfn* is legacy - a
# modern Steam has none, and demanding it would break every push.
account_members() {
  local m
  for m in "$STEAM_DIR/local.vdf" \
           "$STEAM_DIR/config/config.vdf" "$STEAM_DIR/config/loginusers.vdf" \
           "$STEAM_DIR/userdata" ".steam/registry.vdf"; do
    [[ -e "$STEAM_BASE/$m" ]] && printf '%s\n' "$m"
  done
  # Steam Guard sentry files, when this Steam is old enough to use them.
  for m in "$STEAM_BASE/$STEAM_DIR"/ssfn*; do
    [[ -f $m ]] && printf '%s\n' "${m#$STEAM_BASE/}"
  done
  return 0
}

account_push() {
  # The token is in local.vdf, under MachineUserConfigStore -> ConnectCache - NOT
  # in config.vdf. The first version of this guard only required config.vdf to be
  # non-empty, and a signed-out Steam writes a 21 KB config.vdf all the same: the
  # archive held the account list and no token, and the next box asked for a
  # login. Found on 2026-09-14 by diffing what Steam wrote when signing in.
  local store="$STEAM_BASE/$STEAM_DIR/local.vdf"
  if ! grep -q '"ConnectCache"' "$store" 2>/dev/null; then
    log "steam account: not signed in (no ConnectCache in local.vdf) - leaving the archived login alone"
    return 0
  fi

  if steam_running; then
    if (( STEAM_SHUTDOWN )); then
      log "steam account: asking Steam to exit so the login file settles"
      steam -shutdown >/dev/null 2>&1 || true
      local i
      for i in $(seq 1 20); do steam_running || break; sleep 1; done
    fi
    steam_running && log "steam account: Steam is still running - archiving the file as it stands"
  fi

  local members; members=$(account_members)
  if [[ -z ${members//[[:space:]]/} ]]; then
    log "steam account: nothing to archive"
    return 0
  fi

  local tmp; tmp=$(mktemp -t steam-account.XXXXXX.tgz) || return 0
  # No -h. userdata/ is walked as a directory, and Steam puts symlinks in it -
  # the same hazard that OOM-killed the library sync at 12 GB resident when a
  # Proton prefix pointed dosdevices/z: at /. Store links as links.
  # Bounded on purpose. This is a few megabytes and takes under a second, but it
  # runs on the shutdown path, and a walk that never finishes would hold the
  # machine open indefinitely - a symlink loop under userdata/ does exactly that
  # to a dereferencing tar. If it ever takes two minutes, something is wrong and
  # giving up beats hanging the shutdown.
  if ! timeout 120 tar -czf "$tmp" -C "$STEAM_BASE" "${ACCOUNT_EXCLUDES[@]}" $members 2>/dev/null; then
    log "steam account: could not build the archive - the saved login is unchanged"
    rm -f "$tmp"; return 0
  fi

  local sz; sz=$(stat -c %s "$tmp" 2>/dev/null || echo 0)
  if (( sz == 0 || sz > ACCOUNT_MAX )); then
    log "steam account: archive is $(hb "$sz") - refusing to upload (expected well under $(hb "$ACCOUNT_MAX"))"
    rm -f "$tmp"; return 0
  fi

  if "$S5" cp "$tmp" "$ACCOUNT_OBJ" >/dev/null 2>&1; then
    log "steam account: archived $(hb "$sz") (login, controller config, cloud staging)"
  else
    log "steam account: upload failed - the saved login is unchanged"
  fi
  rm -f "$tmp"
}

account_pull() {
  # Restoring over a running Steam would be overwritten the moment it exits, and
  # could log the session out mid-game.
  if steam_running; then
    log "steam account: Steam is running - not touching the login files"
    return 0
  fi

  local tmp; tmp=$(mktemp -t steam-account.XXXXXX.tgz) || return 0
  if ! "$S5" cp "$ACCOUNT_OBJ" "$tmp" >/dev/null 2>&1; then
    log "steam account: none archived yet - you will sign in to Steam once, and the next push saves it"
    rm -f "$tmp"; return 0
  fi

  mkdir -p "$STEAM_BASE/$STEAM_DIR/config" "$STEAM_BASE/.steam" 2>/dev/null || true
  if tar -xzf "$tmp" -C "$STEAM_BASE" 2>/dev/null; then
    # Steam refuses a token file the rest of the world can read.
    chmod 600 "$STEAM_BASE/$STEAM_DIR/config/config.vdf" "$STEAM_BASE/$STEAM_DIR/local.vdf" 2>/dev/null || true
    # .steam/steam is how Steam finds its own root; it is a symlink, so it is
    # not in the tarball and has to be recreated when this is a fresh box.
    [[ -e "$STEAM_BASE/.steam/steam" ]] || \
      ln -s "$STEAM_BASE/$STEAM_DIR" "$STEAM_BASE/.steam/steam" 2>/dev/null || true
    log "steam account: restored - Steam should start already signed in"
  else
    log "steam account: archive would not extract - you will sign in manually"
  fi
  rm -f "$tmp"
}

# --- push --------------------------------------------------------------------
# One push at a time. Two can otherwise overlap - AWS terminating the box while
# the idle watchdog is mid-push, or `cg destroy` pushing over ssh at the same
# moment - and each would upload the same files and rewrite index.json from its
# own stale read, dropping the other's entry. The second WAITS rather than
# giving up: the shutdown push must still run once the first is killed, and it
# resumes from whatever the first already landed. The lock is released when the
# process exits, however it exits.
push_lock() {
  if ! exec 9>>"$STATE/push.lock"; then
    log "WARNING: cannot open $STATE/push.lock - pushing without a lock"
    return 0
  fi
  if ! flock -n 9; then
    log "another push is running - waiting for it to finish"
    flock 9
  fi
}

cmd_push() {
  local force=0 verify=0 a
  for a in "$@"; do
    case $a in
      --force)  force=1 ;;
      --verify) verify=1 ;;
      *) die "unknown option '$a' for push" ;;
    esac
  done
  push_lock
  [[ -d $LIB ]] || die "$LIB does not exist - nothing to push"
  mountpoint -q "$(dirname "$LIB")" || die "$(dirname "$LIB") is not a mountpoint - refusing to push"

  # Deliberately ahead of the restored-this-boot guard below. That guard exists
  # to stop a half-restored GAME overwriting a complete one; the login has no
  # such hazard - it is one small file with its own "does it exist" check - and
  # a session that restored no games is exactly the one whose login is new.
  account_push

  # The library must have been restored on THIS boot. Weaker than it was, now
  # that an absent app is never deleted - but it still stops a half-restored
  # game overwriting a complete one.
  if ! restored && (( ! force )); then
    die "the library was not restored on this boot; push would overwrite the archive with a partial copy (--force overrides)"
  fi

  local apps; apps=$(local_apps)
  if [[ -z ${apps//[[:space:]]/} ]]; then
    log "no games installed - nothing to push (the archive is left alone)"
    return 0
  fi

  local strategy=(--size-only)
  (( verify )) && strategy=()
  # Read once: the index is re-written inside the loop, and re-reading it per
  # app would compare against a figure this same push just updated.
  local idx_cache; idx_cache=$(index_get)
  local id dir name bytes archived t0 n=0
  t0=$(date +%s)
  while IFS=$'\t' read -r id dir name flags; do
    [[ -n ${id:-} ]] || continue
    if ! app_is_whole "${flags:-0}"; then
      log "SKIPPING $name ($id): Steam says StateFlags=$flags - downloading, validating"
      log "  or needing repair. Pushing it would overwrite a complete archive with"
      log "  a partial copy. It will archive itself once Steam finishes."
      continue
    fi
    bytes=$(app_bytes "$dir" "$id")
    # Per-app size guard. The whole-tree version had one because pushing an
    # empty disk could empty the whole archive; per-app prefixes make that
    # impossible, but a single game that is half-present locally can still
    # overwrite its own complete copy. Same protection, scoped to one game.
    archived=$(printf '%s' "$idx_cache" | python3 -c '
import json,sys
appid=sys.argv[1]
try:    apps=json.load(sys.stdin).get("apps",[])
except Exception: apps=[]
print(next((a.get("bytes",0) for a in apps if str(a.get("appid"))==appid), 0))' "$id")
    if (( ${archived:-0} > 0 )) && (( bytes * 2 < archived )) && (( ! force )); then
      log "SKIPPING $name ($id): local $(hb "$bytes") is less than half the archived $(hb "$archived")"
      log "  that looks like a broken install, not an uninstall. --force overrides;"
      log "  to remove it deliberately: cg library forget $id"
      continue
    fi
    log "pushing $name ($id, $(hb "$bytes"))"
    # The manifest goes LAST, after every file it describes. Pushed first, an
    # interrupted upload leaves an archive whose manifest says StateFlags 4 -
    # fully installed - beside a quarter of the files. Restoring that gives
    # Steam a game it believes is complete and which fails at launch, and the
    # repair is a verify pass that re-downloads the lot. Manifest last means an
    # interrupted push leaves no manifest, so the game simply is not there.
    local ok=1 src
    for pair in "common/$dir" "compatdata/$id" "shadercache/$id"; do
      src="$LIB/steamapps/$pair"
      [[ -d $src ]] || continue
      # --delete INSIDE this app's prefix only. A file removed from the game is
      # propagated; a game that is not installed is never touched.
      "$S5" --numworkers "$WORKERS" sync --delete "${strategy[@]}" "${TUNE[@]}" \
        "${EXCLUDES[@]}" "$src/" "$S3/steamapps/$pair/" >/dev/null 2>&1 \
        || { ok=0; log "  WARNING: $pair did not sync cleanly"; }
    done
    symlinks_record "$id" "$dir"
    if (( ok )); then
      "$S5" cp "$LIB/steamapps/appmanifest_$id.acf" "$S3/steamapps/" >/dev/null 2>&1 || ok=0
    fi
    if (( ok )); then
      index_put "$(index_merge "$id" "$dir" "$name" "$bytes")"
      n=$((n+1))
    else
      # No manifest and no index entry: the half-uploaded files are wasted
      # space, not a trap. The next push completes them; `forget` clears them.
      "$S5" rm "$S3/steamapps/appmanifest_$id.acf" >/dev/null 2>&1 || true
      log "  $name is NOT archived - files uploaded but the manifest was withheld"
      log "  (a partial game that Steam thinks is installed is worse than none)"
    fi
  done <<< "$apps"

  "$S5" cp "$LIB/steamapps/libraryfolder.vdf" "$S3/steamapps/" >/dev/null 2>&1 || true
  date -Iseconds > "$STATE/last-push"
  log "pushed $n game(s) in $(( $(date +%s) - t0 ))s"
}

# --- list --------------------------------------------------------------------
cmd_list() {
  index_get | python3 -c '
import json,sys
try:    apps=json.load(sys.stdin).get("apps",[])
except Exception: apps=[]
if not apps:
    print("  the archive is empty"); sys.exit()
GB=1073741824.0
print("  %-10s %-34s %9s  %s" % ("APPID","GAME","SIZE","ARCHIVED"))
tot=0
for a in apps:
    tot+=a.get("bytes",0)
    print("  %-10s %-34s %6.1f GB  %s" % (a["appid"], a.get("name","?")[:34],
          a.get("bytes",0)/GB, a.get("pushed","?")[:16].replace("T"," ")))
print("  %-10s %-34s %6.1f GB   $%.2f/month (INR %.0f)"
      % ("", "total", tot/GB, tot/GB*0.025, tot/GB*0.025*88))'
}

# --- forget ------------------------------------------------------------------
# The archive no longer shrinks by itself, so this is how a game leaves it. A
# typed word, because it is as unrecoverable as `cg destroy --all`: there is no
# versioning behind the bucket.
cmd_forget() {
  local id="${1:-}" yes="${2:-}"
  [[ -n $id ]] || die "usage: cg-library forget <appid>"
  local row
  row=$(index_get | python3 -c '
import json,sys
appid=sys.argv[1]
try:    apps=json.load(sys.stdin).get("apps",[])
except Exception: apps=[]
for a in apps:
    if str(a.get("appid"))==appid:
        print("%s\t%s\t%s" % (a.get("name","?"), a.get("installdir",""), a.get("bytes",0)))
        break' "$id")
  [[ -n ${row//[[:space:]]/} ]] || die "appid $id is not in the archive (see: cg library list)"
  local name dir bytes; IFS=$'\t' read -r name dir bytes <<<"$row"
  echo "This permanently deletes $name ($id, $(hb "$bytes")) from the archive."
  echo "No undo, no versioning. Playing it again means downloading it from Steam,"
  echo "which at the 379 Mbps measured on this instance type is about an hour for"
  echo "160 GB, against ~11 min to restore it. The saves and shader cache in the"
  echo "Proton prefix are not re-downloadable at all."
  if [[ $yes != --yes ]]; then
    local a; read -r -p "type FORGET to confirm: " a
    [[ $a == FORGET ]] || { echo "aborted - nothing was deleted"; return 1; }
  fi
  local pair
  for pair in "common/$dir" "compatdata/$id" "shadercache/$id"; do
    "$S5" rm "$S3/steamapps/$pair/*" >/dev/null 2>&1 || true
  done
  "$S5" rm "$S3/steamapps/appmanifest_$id.acf" >/dev/null 2>&1 || true
  "$S5" rm "$S3/meta/symlinks-$id.tsv" >/dev/null 2>&1 || true
  index_put "$(index_drop "$id")"
  log "forgot $name ($id) - $(hb "$bytes") of storage stops billing"
}

# --- status / check ----------------------------------------------------------
cmd_status() {
  local lb; lb=$(du -sb --exclude=downloading --exclude=temp "$LIB" 2>/dev/null | cut -f1 || echo 0)
  echo "  bucket    $S3"
  echo "  local     $(hb "$lb")  at $LIB"
  local dl; dl=$(du -sb "$LIB/steamapps/downloading" 2>/dev/null | cut -f1)
  [[ ${dl:-0} -gt 104857600 ]] && \
    echo "  +$(hb "$dl") downloading - excluded until Steam finishes and moves it"
  echo "  restored  $(restored && echo "yes (this boot)" || echo "NO - push will refuse")"
  echo "  this boot $(printf '%s' "${APPS}")"
  echo "  last push $(cat "$STATE/last-push" 2>/dev/null || echo never)"
  if "$S5" ls "$ACCOUNT_OBJ" >/dev/null 2>&1; then
    echo "  steam login archived - a new box starts signed in"
  else
    echo "  steam login NOT archived - a new box will ask for Steam Guard"
  fi
  echo "  archive:"
  cmd_list
}

cmd_check() {
  local apps; apps=$(local_apps)
  [[ -n ${apps//[[:space:]]/} ]] || { log "no games installed - nothing to push"; return 0; }
  local id dir name flags pending=0 out
  while IFS=$'\t' read -r id dir name flags; do
    [[ -n ${id:-} ]] || continue
    for pair in "common/$dir" "compatdata/$id" "shadercache/$id"; do
      [[ -d "$LIB/steamapps/$pair" ]] || continue
      out=$("$S5" --dry-run --numworkers "$WORKERS" sync --delete --size-only \
              "${TUNE[@]}" "${EXCLUDES[@]}" "$LIB/steamapps/$pair/" \
              "$S3/steamapps/$pair/" 2>/dev/null)
      [[ -n ${out//[[:space:]]/} ]] && pending=$((pending + $(grep -c . <<<"$out")))
    done
  done <<< "$apps"
  if (( pending == 0 )); then log "library is mirrored - nothing to push"; return 0; fi
  log "NOT mirrored: $pending object(s) differ from the archive"
  return 1
}

case "${1:-status}" in
  pull|restore)
    shift
    # `--apps 123,456`, or a bare csv, or nothing (use CG_APPS from the config
    # that the laptop wrote before launch).
    want="$APPS"
    while [[ $# -gt 0 ]]; do
      case $1 in
        --apps) want="${2:-}"; shift 2 ;;
        *)      want="$1"; shift ;;
      esac
    done
    cmd_pull "$want" ;;
  push|sync)    shift; cmd_push "$@" ;;
  account)      shift
                case "${1:-}" in
                  push) account_push ;;
                  pull|restore) account_pull ;;
                  *) echo "usage: cg-library account push|pull" >&2; exit 1 ;;
                esac ;;
  list)         cmd_list ;;
  forget)       shift; cmd_forget "$@" ;;
  check)        cmd_check ;;
  status|"")    cmd_status ;;
  *) echo "usage: cg-library [pull [--apps <csv|all|none>]|push|account push|pull|list|forget <appid>|check|status]" >&2; exit 1 ;;
esac

# See the note at the end of cg: bash reads a script incrementally and returns
# for more input after the last command, so a file edited while this runs can
# resume at a stale offset. An explicit exit ends the read.
exit
