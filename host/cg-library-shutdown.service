[Unit]
Description=Mirror the Steam library to S3 before the machine goes down
# This is what makes the box safe to stop AUTOMATICALLY. Three things stop it
# without anyone typing a command - the on-host idle watchdog's `shutdown -h`,
# the CloudWatch alarm, and the cloud watchdog - and the last two ask AWS
# to terminate (or, on demand, stop) the instance, which AWS turns into a
# graceful OS shutdown. All three therefore arrive here, which is why one unit
# covers all of them.
#
# There is deliberately no periodic timer beside it: this only ever runs when
# the machine is already going away, never while you are playing.
#
# DefaultDependencies=no keeps systemd from ordering this after the very
# shutdown targets it has to run before.
DefaultDependencies=no
Requires=scratch-disk.service
After=scratch-disk.service network-online.target cg-library-restore.service
Before=shutdown.target umount.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=ubuntu
Group=ubuntu
# Nothing happens at start. The work is in ExecStop, which systemd runs as the
# machine goes down, while the network is still up.
ExecStart=/bin/true
ExecStop=/usr/local/bin/cg-library push
# The backstop, for stops this box did not initiate - an external StopInstances,
# a console terminate. The on-host watchdog now pushes BEFORE calling shutdown,
# where there is no timeout at all, because a first upload of a 140 GB game
# cannot fit in any shutdown window: measured at 104 GB in the 15 minutes
# systemd allowed, then killed with ~72 GB of 140 landed.
#
# Still bounded, because a doomed upload should not hang a shutdown forever, and
# after an explicit `cg stop` or a watchdog push there is nothing left to send -
# seconds, not minutes. 30 minutes is room for a session's worth of new files
# when an external guard terminates the box. AWS may power off an instance it
# was asked to terminate before this runs out, and a spot interruption gives
# two minutes whatever this says.
#
# If the idle watchdog's own push is still running when the shutdown begins,
# systemd stops it and this push waits on cg-library's lock, then carries on
# from the files already uploaded.
#
# A box still going down an hour later, whatever started it, is forced by the
# cloud watchdog - by then this has had its 30 minutes.
TimeoutStopSec=1800

[Install]
WantedBy=multi-user.target
