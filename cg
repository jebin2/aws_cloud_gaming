#!/usr/bin/env bash
# One front door for the whole rig. A dispatcher, deliberately: `setup` and
# `game` keep working, and almost every odd-looking line in them is a scar from
# a real failure. Re-implementing that logic here would quietly lose it, so this
# calls into them and only implements what they never had - snapshot listing,
# logs, ssh, ping and the guard view.
set -euo pipefail
cd "$(dirname "$0")"

source lib/common.sh

# --- global flags, before the subcommand ---------------------------------------
JSON=0; WATCH=0
while [[ ${1:-} == -* ]]; do
  case $1 in
    --json)    JSON=1; shift ;;
    --watch)   WATCH=1; shift ;;
    --region)  export GAME_REGION="$2"; shift 2 ;;
    --host)    export GAME_TS_HOST="$2"; shift 2 ;;
    -h|--help) set -- help; break ;;
    # An app driving cg needs to know what it is driving: the commit it runs,
    # and the event contract that goes with it.
    # Which commands cannot run beside anything else, and the questions cg can
    # ask. Both were written down in the app instead - the scheduling list
    # twice, in two processes, which disagreed three times before anyone
    # noticed, because a command that is never started looks exactly like one
    # that returned nothing.
    #
    # It is cg that takes the locks, so it is cg that knows. The rule is about
    # COLLISION, not about change: `cg quota request` opens a support case and
    # still collides with nothing. Nor do `cg host setup` and `cg host open`:
    # they touch a machine of yours and nothing in AWS, and a stream from one
    # lasts hours - run alone, every read in the app would wait it out.
    --contract) cat <<'JSON'
{
  "events": 1,
  "runs_alone": [
    ["init"], ["destroy"], ["open"],
    ["library", "push"], ["library", "pull"], ["library", "forget"],
    ["library", "clean"], ["library", "account"], ["library", "move"],
    ["library", "reset"], ["library", "keep-for"],
    ["creds", "set"],
    ["creds", "tailscale", "signin"],
    ["creds", "tailscale", "authkey"],
    ["deps", "install"],
    ["aws", "disconnect"]
  ],
  "asks": [
    "aws-access-key-id", "aws-secret-access-key",
    "tailscale-api-token", "tailscale-auth-key",
    "alert-email", "session-end", "fix-go-ahead", "steam-login",
    "clean-orphans", "delete-volume", "destroy-all", "forget-game", "forget-login",
    "move-game", "host-sudo", "host-ssh-password", "aws-disconnect"
  ]
}
JSON
                exit 0 ;;
    --version) printf 'cg %s\nevents %s\n' \
                 "$(git -C "$(dirname "$0")" describe --always --dirty 2>/dev/null || echo unknown)" \
                 "1"; exit 0 ;;
    *) die "unknown flag '$1' (see: cg help)" ;;
  esac
done
CMD="${1:-help}"; shift || true
# Flags are also accepted after the subcommand, which is how people actually
# type them.
for a in "$@"; do
  case $a in --watch) WATCH=1 ;; --json) JSON=1 ;; esac
done

# .env, parsed rather than sourced: a malformed line in a sourced file executes
# as a command. Anything already exported wins, so --region/--host stick.
# Settings, from wherever this installation keeps them - see lib/env-file.sh.
# shellcheck source=lib/env-file.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib/env-file.sh"
cg_env_load

# The default is the registry's (lib/config.sh), not a copy written here.
REGION="${GAME_REGION:-$(source lib/config.sh && config_field GAME_REGION 3)}"
TS_HOST="${GAME_TS_HOST:-gamevps}"
TS_NODE="${GAME_TS_NODE:-$TS_HOST}"
INSTANCE_ID="${GAME_INSTANCE_ID:-}"
KEY="$HOME/.ssh/${TS_HOST}.pem"
ec2() { aws ec2 "$@" --region "$REGION"; }
# Layer 3, the cloud watchdog: needs REGION and TS_HOST, so sourced after them.
source lib/s3-region.sh
source lib/cloud-watchdog.sh
# The .env settings: one registry, shared by `cg config` and the app.
# shellcheck source=lib/config.sh
source lib/config.sh
# The prices, in one place - see lib/rates.sh.
# shellcheck source=lib/rates.sh
source lib/rates.sh
# The local stream lock: `cg open` holds it, `cg status` reports it, and
# `cg destroy` closes it before taking the box away.
# shellcheck source=lib/session.sh
source lib/session.sh
# Your own machines, beside the AWS one - see lib/host.sh.
# shellcheck source=lib/host.sh
source lib/host.sh
# What this region will rent, read from AWS - see lib/machines.sh. The app's
# instance picker is fed from here, so no list of types lives in the renderer.
# shellcheck source=lib/machines.sh
source lib/machines.sh
source lib/sweep.sh
# shellcheck source=lib/quota.sh
source lib/quota.sh

# lib/setup and lib/game are dispatch targets, not commands - see docs/commands.md
# is not needed, their headers say so.

need_node() {
  tailscale ip -4 "$TS_NODE" >/dev/null 2>&1 \
    || die "'$TS_NODE' is not on the tailnet. Is the box running? Try: cg status"
}
box() {
  need_node
  ssh -i "$KEY" -o StrictHostKeyChecking=accept-new -o ConnectTimeout=10 \
      -o BatchMode=yes "ubuntu@$(tailscale ip -4 "$TS_NODE")" "$@"
}

# --- commands ------------------------------------------------------------------

# Alt+Tab, Super and friends are swallowed by the *client* desktop unless
# Moonlight is told to capture them, and nothing about the remote box can change
# that - so set it here, once, rather than leaving it as a step to remember.
#
# Only ever ADDS the key when absent: someone who deliberately set it to 0 keeps
# that. And never while Moonlight runs - it does not re-read its config, and it
# rewrites the file on exit, discarding anything changed underneath it.
# Save games live inside the Proton prefix, in the Steam library on /scratch -
# so they survive a stop only by way of the S3 mirror, which runs after this.
# Steam Cloud is the independent copy, and Cloud only syncs when Steam shuts
# down cleanly, so ask it to exit and give it time before stopping the box.
# Streaming is the charge that can exceed the instance, and `cg cost` cannot
# help in the moment: Cost Explorer lags about a day. The box has the counter
# already, so read it live and for free. Since boot, not since the session -
# the kernel keeps no per-session tally - and it includes ssh and Tailscale
# keepalives, which is why it is labelled as tailnet traffic, not pure video.
# The month, from whatever `cg cost` last paid Cost Explorer for. Free, because
# it re-reads a number already bought - and stamped with its age, because a
# cached figure presented as current would be the same scope bug this section
# came from, wearing a different hat.
egress_month() {
  local f=.cg-cache/egress ts gb free age
  [[ -r $f ]] || { printf '  monthly egress  unknown - run: cg cost\n'; return 0; }
  read -r ts gb free < "$f" 2>/dev/null || return 0
  [[ ${ts:-0} =~ ^[0-9]+$ ]] || return 0
  age=$(( ($(date +%s) - ts) / 60 ))
  awk -v g="${gb:-0}" -v fr="${free:-100}" -v a="$age" 'BEGIN{
    left = fr - g; if (left < 0) left = 0;
    if (a < 90)        when = sprintf("%d min ago", a);
    else if (a < 2880) when = sprintf("%.0f h ago", a/60.0);
    else               when = sprintf("%.0f days ago", a/1440.0);
    printf "  monthly egress  %.1f GB used, ~%.0f GB of %.0f GB free left  (as of %s)\n",
           g, left, fr, when;
    if (a > 1440) printf "                  stale - refresh with: cg cost\n";
  }'
}

stream_usage() {
  local node="${GAME_TS_NODE:-$TS_HOST}" ip
  tailscale ip -4 "$node" >/dev/null 2>&1 || return 0
  ip=$(tailscale ip -4 "$node")
  local out
  out=$(ssh -i "$KEY" -o StrictHostKeyChecking=accept-new -o ConnectTimeout=8 \
        -o BatchMode=yes "ubuntu@$ip" '
    ts=$(cat /sys/class/net/tailscale0/statistics/tx_bytes 2>/dev/null || echo 0)
    # What AWS bills is what leaves the real NIC: WireGuard encapsulation, ssh,
    # apt, and - measured at ~2.4 GB against a 132 GB download - the TCP acks a
    # big Steam download generates. None of that appears on tailscale0, so a
    # status line reading only the tunnel understates the bill by about half.
    nic=$(ip route show default 2>/dev/null | awk "{print \$5; exit}")
    wan=$(cat "/sys/class/net/$nic/statistics/tx_bytes" 2>/dev/null || echo 0)
    win=$(cat "/sys/class/net/$nic/statistics/rx_bytes" 2>/dev/null || echo 0)
    up=$(cut -d. -f1 /proc/uptime)
    printf "%s %s %s %s\n" "$ts" "$wan" "$win" "$up"' 2>/dev/null) || return 0
  [[ -n $out ]] || return 0
  echo
  echo "TRAFFIC (this boot only - see cg cost for the billed month)"
  awk -v o="$out" 'BEGIN{
    split(o,f," "); ts=f[1]; wan=f[2]; win=f[3]; up=f[4];
    printf "  stream out      %.2f GB", ts/1073741824;
    if (up>0) printf "   avg %.1f Mbps over %.1f h", ts*8/up/1000000, up/3600;
    printf "\n";
    printf "  total out       %.2f GB   <- what AWS bills (adds wireguard overhead, ssh, apt)\n", wan/1073741824;
    printf "  total in        %.2f GB   (free - game downloads land here)\n", win/1073741824;
    # NOT a monthly figure. These are NIC counters read since THIS box booted,
    # and every session is a new box - so subtracting them from the 100 GB
    # monthly allowance reported 99 GB left while Cost Explorer showed 91.
    # The month lives in cg cost, which reads it from Cost Explorer.
    printf "  (above is this boot only)\n";
  }'
  egress_month
}

steam_shutdown_for_cloud_sync() {
  local node="${GAME_TS_NODE:-$TS_HOST}"
  tailscale ip -4 "$node" >/dev/null 2>&1 || return 0
  local ip; ip=$(tailscale ip -4 "$node")
  local sshopts=(-i "$KEY" -o StrictHostKeyChecking=accept-new -o ConnectTimeout=8 -o BatchMode=yes)
  ssh "${sshopts[@]}" "ubuntu@$ip" 'pgrep -x steam >/dev/null' 2>/dev/null || return 0
  say "closing Steam so cloud saves finish syncing"
  # `steam -shutdown` is the supported way to ask it to exit and sync; a plain
  # kill skips the sync entirely.
  ssh "${sshopts[@]}" "ubuntu@$ip" '
    export DISPLAY=:0 XAUTHORITY="$HOME/.Xauthority"
    export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus"
    /usr/bin/steam -shutdown >/dev/null 2>&1 || true
    for i in $(seq 1 30); do pgrep -x steam >/dev/null || break; sleep 2; done
    pgrep -x steam >/dev/null && echo "still running after 60s" || echo "closed"
  ' 2>/dev/null | sed 's/^/      steam: /'
}

ensure_moonlight_syskeys() {
  local conf="$HOME/.config/Moonlight Game Streaming Project/Moonlight.conf"
  [[ -f $conf ]] || return 0
  pgrep -x moonlight >/dev/null 2>&1 && return 0
  grep -q '^capturesyskeys=' "$conf" && return 0
  if grep -q '^\[General\]' "$conf"; then
    sed -i '0,/^\[General\]/s//[General]\ncapturesyskeys=2/' "$conf" \
      && log "enabled Moonlight system-key capture (Alt+Tab, Super)"
  fi
}


# The games live on the instance store now, which is wiped on every stop, so the
# S3 archive is the only durable copy. The box mirrors continuously on a timer
# and again from a pre-shutdown unit, but both of those run INSIDE a machine
# that is about to disappear - and on a spot interruption there are two minutes
# to work with. So anything initiated from here pushes first, from here, and
# waits for it.
# Revoke the box's write access to the archive, so its own shutdown mirror
# cannot change anything. This is what makes `--no-push` mean what it says.
#
# Skipping the laptop-side push is only half the job: cg-library-shutdown.service
# runs ON the box from ExecStop, and terminating triggers a graceful shutdown, so
# it fires whether or not this end pushed. Disabling that unit would need ssh -
# unavailable exactly when it is most wanted, because a box too busy to answer
# ssh is the usual reason for wanting --no-push at all. IAM works from here
# regardless of the box's state.
archive_lock() {   # archive_lock ro|rw
  local mode="$1" role="${TS_HOST}-box" b
  b=$(cg_bucket) || return 0
  aws iam get-role --role-name "$role" >/dev/null 2>&1 || return 0
  local write=''
  [[ $mode == rw ]] && write=', "s3:PutObject", "s3:DeleteObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"'
  if aws iam put-role-policy --role-name "$role" --policy-name library-rw \
      --policy-document "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":[\"s3:ListBucket\",\"s3:GetBucketLocation\"],\"Resource\":\"arn:aws:s3:::$b\"},{\"Effect\":\"Allow\",\"Action\":[\"s3:GetObject\"$write],\"Resource\":\"arn:aws:s3:::$b/*\"}]}" >/dev/null 2>&1; then
    [[ $mode == ro ]] && log "archive set read-only for $role - its shutdown mirror cannot write"
    [[ $mode == rw ]] && log "archive writable again for $role"
    return 0
  fi
  log "could not set the archive to $mode (needs iam:PutRolePolicy)"
  return 1
}

box_state() {
  [[ -n $INSTANCE_ID ]] || { echo none; return; }
  ec2 describe-instances --instance-ids "$INSTANCE_ID" \
    --query 'Reservations[0].Instances[0].State.Name' --output text 2>/dev/null || echo unknown
}

# What the archive holds, asked from HERE rather than from the box - which is
# the only way to ask once the box is stopped or gone, and exactly when the
# question matters most.
archive_report() {
  local b
  b=$(cg_bucket) || { log "could not work out the archive bucket - AWS did not answer"; return 1; }
  local out
  out=$(aws s3 ls "s3://$b/steam/" --recursive --summarize 2>/dev/null | tail -2) || true
  local n sz
  n=$(awk '/Total Objects:/{print $3}' <<<"$out")
  sz=$(awk '/Total Size:/{print $3}' <<<"$out")
  local human; human=$(numfmt --to=iec --suffix=B "${sz:-0}" 2>/dev/null || echo "${sz:-0}B")
  if _cg_styled; then
    _cg_line "$([[ ${n:-0} -gt 0 ]] && echo ok || echo warn)" "archive s3://$b/steam holds ${n:-0} objects, $human"
  else
    printf '      archive s3://%s/steam holds %s objects, %s\n' "$b" "${n:-0}" "$human"
  fi
  [[ ${n:-0} -gt 0 ]]
}

library_push() { # library_push [--force]; 0 on a completed push
  local extra="${1:-}"
  tailscale ip -4 "$TS_NODE" >/dev/null 2>&1 || { log "box is not reachable - no push"; return 1; }
  say "mirroring the game library to S3 before the box goes away"
  box "/usr/local/bin/cg-library push $extra" 2>&1 | cg_relay '      '
  return "${PIPESTATUS[0]}"
}

# Stopping wipes the instance store, exactly like destroying does, so it gets
# the same gate. The push is here and in destroy and nowhere else: there is no
# timer and no pre-shutdown hook, so if this does not run, the games are gone.
# Which is why a failure stops the stop rather than printing a note next to it.
# The push and its gate live in lib/game's down(), which every stop path goes
# through - including the "stop instance now?" prompt at the end of `cg open`,
# which does not come back through here. Duplicating the gate would mean two
# pushes on `cg stop` and still none on that prompt.
cmd_stop() {
  local a
  for a in "$@"; do
    case $a in
      --force) export CG_FORCE=1 ;;
      *) die "unknown option '$a' for stop (only --force is accepted)" ;;
    esac
  done
  steam_shutdown_for_cloud_sync
  cg_exec lib/game stop
}

# Ask which games to restore, before anything launches. The answer is exported
# for provision.sh to bake into user-data, and remembered in .env so the common
# case next time is pressing Enter.
choose_games() {
  local sel
  # On failure keep whatever .env already said rather than reaching for "all":
  # "all" is only safe while the archive is smaller than the disk, and the whole
  # reason this prompt exists is that it no longer is.
  # On failure keep whatever .env already said, and fall back to "none" rather
  # than "all" - a chooser that broke should not decide to move 158 GB.
  library_disk_env
  sel=$(GAME_S3_BUCKET="$(cg_bucket || true)" CG_DISK_GB="$DISK_GB" CG_RESERVE_GB="$RESERVE_GB" \
        bash lib/choose-games.sh) \
    || sel="${GAME_APPS:-none}"
  export GAME_APPS="${sel:-${GAME_APPS:-none}}"
  cg_env_set GAME_APPS "$GAME_APPS"
}

# list and forget are pure S3, so they work with no box running - which is when
# you most want to know what the archive is costing, and the only time it is
# safe to assume nothing is writing to it.
# Why an S3 read failed, in words, from what the CLI printed. The distinction
# that matters is the last one: a missing index on a bucket we CAN read is an
# empty archive; anything else is an archive we cannot see.
library_reason() { # library_reason <stderr text> -> a reason, or "missing"
  local e=$1
  case $e in
    *InvalidAccessKeyId*|*InvalidClientTokenId*|*SignatureDoesNotMatch*|*ExpiredToken*|*"security token"*)
      echo "the AWS credentials are not valid - check: aws sts get-caller-identity" ;;
    *NoSuchBucket*)
      echo "the bucket s3://$(cg_bucket || echo '?') does not exist" ;;
    *AccessDenied*|*"Access Denied"*)
      echo "these AWS credentials may not read s3://$(cg_bucket || echo '?')" ;;
    # HeadObject answers 403 both for a key that is denied and for credentials
    # that no longer exist, so the message must cover both rather than guess.
    *403*|*Forbidden*)
      echo "S3 refused the read (403) - the credentials are invalid, or may not read s3://$(cg_bucket || echo '?'). Check: aws sts get-caller-identity" ;;
    *EndpointConnectionError*|*"Could not connect"*|*"Connect timeout"*|*"Unable to locate credentials"*)
      echo "cannot reach S3 - no network, or no credentials configured" ;;
    *404*|*"Not Found"*|*"does not exist"*|*NoSuchKey*)
      echo "missing" ;;
    "") echo "the S3 read failed and said nothing" ;;
    *)  head -1 <<<"$e" ;;
  esac
}

# The archive index, or a reason it could not be read - never silence.
#
# This used to end in `|| echo '{"apps":[]}'`, so expired credentials, a denied
# bucket or a dead network all came out as an EMPTY ARCHIVE. `cg library list`
# then said "the archive is empty" about 160 GB of games that were sitting
# safely in S3. That is the most alarming lie this tool can tell, and it told it
# for free, so failures now come back as failures.
# The reason goes to STDERR, not to a variable: every caller reads the index
# through $( ), which is a subshell, so an assignment made inside would be
# thrown away the moment the function returned.
# The bucket, from .env when it is there and DERIVED when it is not. The name is
# a function of the account, the host and the region - the same function
# lib/library-aws.sh uses to create it - so requiring .env to carry it made
# every library read fail until an init had written it. Clearing it to move
# region did exactly that: `cg library` exited 1, and the app reported a failed
# read for a bucket whose name was never in question.
#
# Resolved once per run and remembered: the account lookup is a free call, but
# it is still a network round trip and this is on the path of an opening screen.
_CG_BUCKET=""
cg_bucket() {
  if [[ -n ${GAME_S3_BUCKET:-} ]]; then printf '%s' "$GAME_S3_BUCKET"; return 0; fi
  if [[ -n $_CG_BUCKET ]]; then printf '%s' "$_CG_BUCKET"; return 0; fi
  local acct
  acct=$(aws sts get-caller-identity --query Account --output text 2>/dev/null) || return 1
  [[ -n $acct && $acct != None ]] || return 1
  _CG_BUCKET=$(cg_bucket_name "$acct" "$TS_HOST" "$REGION")
  printf '%s' "$_CG_BUCKET"
}

library_index() {
  local bucket
  bucket=$(cg_bucket) || { echo "could not work out the archive bucket - AWS did not answer" >&2; return 1; }
  local out err rc reason
  err=$(mktemp)
  out=$(aws s3 cp "s3://$bucket/steam/index.json" - 2>"$err") && rc=0 || rc=$?
  if (( rc == 0 )); then rm -f "$err"; printf '%s' "$out"; return 0; fi
  reason=$(library_reason "$(cat "$err")"); rm -f "$err"
  # A bucket we can read that holds no index really is an empty archive.
  [[ $reason == missing ]] && { echo '{"apps":[]}'; return 0; }
  printf '%s\n' "$reason" >&2
  return 1
}

# The game disk the NEXT build gets: the configured type's (machine_disk_gb),
# less the space kept free for Steam (GAME_DISK_RESERVE_GB). Exported for the
# python that reports it; empty when the type's disk could not be read.
library_disk_env() {
  local t gb src
  t="${GAME_INSTANCE_TYPE:-$(config_field GAME_INSTANCE_TYPE 3)}"
  read -r gb src < <(machine_disk_gb "$REGION" "$t" 2>/dev/null) || true
  export DISK_TYPE="$t" DISK_GB="${gb:-}" DISK_SRC="${src:-}" \
         RESERVE_GB="${GAME_DISK_RESERVE_GB:-$(config_field GAME_DISK_RESERVE_GB 3)}"
}

# `cg library list --json`: the same index and orphan scan, as data.
library_json() {
  library_disk_env
  local idx orph err
  err=$(mktemp)
  if ! idx=$(library_index 2>"$err"); then
    LIBRARY_ERR=$(cat "$err"); rm -f "$err"
    # Data, still - a program reading this must be able to tell the difference
    # between "no games" and "I could not look".
    ERR="$LIBRARY_ERR" BUCKET="$(cg_bucket || true)" python3 -c '
import json, os
print(json.dumps({"bucket": os.environ.get("BUCKET") or None,
                  "error": os.environ["ERR"], "games": None,
                  "total_bytes": None, "usd_month": None,
                  # The index could not be read; that says nothing either way
                  # about the login, so it is unknown rather than absent.
                  "login": None}, indent=2))'
    return 1
  fi
  rm -f "$err"
  orph=$(library_orphans)
  # The archived Steam login rides along in this one payload rather than needing
  # a read of its own: it is what the library screen is about as much as the
  # games are, and it was invisible on every surface while being counted as a
  # game. account_json caches the 22 KB fetch against the object's ETag, so the
  # cost here is one head-object.
  local login; login=$(account_json 2>/dev/null) || login=""
  # The dates: when a machine was last seen, and each game's Reset - free reads.
  local marks; marks=$(library_marks_json 2>/dev/null) || marks="null"
  printf '%s' "$idx" | ORPHANS="$orph" LOGIN="$login" BUCKET="$(cg_bucket || true)" MARKS="$marks" \
    HERE="$REGION" DAYS="$(cw_expiry_days)" python3 -c '
import json, os, sys
try:    apps = json.load(sys.stdin).get("apps", [])
except Exception: apps = []
GB = 1073741824.0
def num(v):
    try: return float(v)
    except (TypeError, ValueError): return None
month = lambda b, rate: None if rate is None else round(b / GB * rate, 2)
S3 = num(os.environ.get("CG_S3_USD_GB_MONTH"))
# Per game, not just the total: a screen that lists them must be able to say
# what each one costs without knowing the price of S3.
marks = json.loads(os.environ.get("MARKS") or "null")
kept = (marks or {}).get("kept") or {}
bucket = os.environ.get("BUCKET") or ""
games = [{"appid": a.get("appid"), "name": a.get("name"), "installdir": a.get("installdir"),
          "bytes": a.get("bytes", 0), "pushed": a.get("pushed"),
          "usd_month": month(a.get("bytes", 0), S3),
          # The Reset mark, if any: the watchdog counts from the later of this
          # and the last machine.
          "kept": kept.get("%s/%s" % (bucket, a.get("appid")))} for a in apps]
total = sum(g["bytes"] for g in games)
orphan_bytes = 0
for line in (os.environ.get("ORPHANS") or "").splitlines():
    part = line.split("\t")
    if part and part[0].strip().isdigit(): orphan_bytes += int(part[0])
print(json.dumps({
  "bucket": os.environ.get("BUCKET") or None,
  "games": sorted(games, key=lambda g: -g["bytes"]),
  "total_bytes": total,
  "usd_month": month(total, S3),
  "orphan_bytes": orphan_bytes or None,
  "orphan_usd_month": month(orphan_bytes, S3) if orphan_bytes else None,
  # null means "could not look", which is not the same as present=false.
  "login": (lambda t: (json.loads(t) if t.strip() else None))(os.environ.get("LOGIN") or ""),
  # What the next machine can hold at once, and what cg init offers after the
  # space kept free - the disk of the configured type, measured once one has
  # run. null when it could not be read: the box still enforces the real limit.
  "disk_type": os.environ.get("DISK_TYPE") or None,
  "disk_gb": int(os.environ["DISK_GB"]) if os.environ.get("DISK_GB", "").isdigit() else None,
  "disk_measured": os.environ.get("DISK_SRC") == "measured",
  "reserve_gb": int(os.environ["RESERVE_GB"]) if os.environ.get("RESERVE_GB", "").isdigit() else None,
  "selectable_gb": (max(0, int(os.environ["DISK_GB"]) - int(os.environ.get("RESERVE_GB") or 0))
                    if os.environ.get("DISK_GB", "").isdigit() else None),
  "usd_per_gb_month": S3,
  # Where these are, and how long they are kept: N days after the later of the
  # last machine and the Reset of each game. null when the marks are unreadable.
  "region": os.environ.get("HERE") or None,
  "inr_per_usd": num(os.environ.get("CG_INR_PER_USD")),
  "expiry_days": int(os.environ.get("DAYS") or 0),
  "last_seen": (marks or {}).get("last_seen"),
  "marks_read": marks is not None,
}, indent=2))'
}

library_list() {
  library_disk_env
  # An index.json is written only by the per-app push. A box built before that
  # mirrors fine but writes no index, so "the archive is empty" would be a lie
  # told about the thing that was looked for rather than the thing that is
  # there. Check the objects before saying nothing is there.
  # `|| true` because `aws s3 ls` on an EMPTY prefix exits 1, and with
  # `set -o pipefail` that made the assignment fail and `set -e` kill the whole
  # command - so `cg library list` printed nothing at all the moment the archive
  # became empty, which is exactly when someone runs it to check.
  # Before anything is said about what is IN the archive, establish that it can
  # be read at all. Expired credentials used to come out as "the archive is
  # empty" - the same words as a real empty archive, about 160 GB of games.
  local idx err
  err=$(mktemp)
  if ! idx=$(library_index 2>"$err"); then
    log_as fail "cannot read the archive: $(cat "$err")"
    rm -f "$err"
    echo "  s3://$(cg_bucket || echo '?') was not readable, so nothing here is known -"
    echo "  this is NOT the same as the archive being empty."
    return 1
  fi
  rm -f "$err"

  # Counted under steamapps/, not under steam/: steam/ also holds the account
  # bundle and the metadata, so a BRAND NEW bucket carrying nothing but a
  # 21.8 KB copied login counted as 1 object with no index and was announced as
  # an old-format archive from a box that predates per-game archiving.
  local objs lb
  lb=$(cg_bucket) || return 0
  objs=$(aws s3 ls "s3://$lb/steam/steamapps/" --recursive --summarize 2>/dev/null \
         | awk '/Total Objects:/{print $3}') || true
  if [[ ${objs:-0} -gt 0 ]] \
     && ! aws s3 ls "s3://$lb/steam/index.json" >/dev/null 2>&1; then
    local sz
    sz=$(aws s3 ls "s3://$lb/steam/steamapps/" --recursive --summarize 2>/dev/null \
         | awk '/Total Size:/{print $3}') || true
    echo "  archive holds $objs objects, $(numfmt --to=iec --suffix=B "${sz:-0}" 2>/dev/null)"
    echo "  but no per-game index yet - this box predates per-game archiving."
    echo "  The next push from a rebuilt box writes one and this lists per game."
    aws s3 ls "s3://$lb/steam/steamapps/common/" 2>/dev/null \
      | sed 's/^ *PRE /  - /' | sed 's|/$||'
    return 0
  fi
  printf '%s' "$idx" | python3 -c '
import json,os,sys
try:    apps=json.load(sys.stdin).get("apps",[])
except Exception: apps=[]
if not apps: print("  the archive is empty"); sys.exit()
GB=1073741824.0
print("  %-10s %-32s %9s  %s" % ("APPID","GAME","SIZE","ARCHIVED"))
tot=0
for a in apps:
    tot+=a.get("bytes",0)
    print("  %-10s %-32s %6.1f GB  %s" % (a["appid"], a.get("name","?")[:32],
          a.get("bytes",0)/GB, a.get("pushed","?")[:16].replace("T"," ")))
g=tot/GB
def num(k):
    try: return float(os.environ.get(k))
    except (TypeError, ValueError): return None
S3, INR = num("CG_S3_USD_GB_MONTH"), num("CG_INR_PER_USD")
cost = ("   $%.2f/month%s" % (g*S3, " (INR %.0f)" % (g*S3*INR) if INR else "")) if S3 is not None else ""
print("  %-10s %-32s %6.1f GB%s" % ("","total",g,cost))
print("")
t, d, r = os.environ.get("DISK_TYPE") or "the machine", os.environ.get("DISK_GB", ""), int(os.environ.get("RESERVE_GB") or 0)
if d.isdigit():
    sel = max(0, int(d) - r)
    print("  %s GB fits on a %s at once (%d GB selectable, %d GB kept free%s)"
          % (d, t, sel, r, "" if os.environ.get("DISK_SRC") == "measured" else "; AWS figure, not yet measured"))
    if g > sel: print("  the archive is larger than that - cg init asks which to restore")
else:
    print("  how much a %s holds could not be read - the box restores what fits" % t)'
}

# Objects the index does not know about.
#
# A push that dies leaves files with no manifest and no index entry - by design,
# so a half-uploaded game is never mistaken for a complete one. But nothing
# could then SEE them: `cg library list` read the index and reported an empty
# archive while 76 GB of a dead Diablo IV download sat there billing INR 167 a
# month, and `forget` could not touch it because forget works off the index too.
# Cleaning it up meant hand-written `aws s3 rm` commands.
library_orphans() {   # -> "<bytes>\t<prefix>" per orphan
  local b; b=$(cg_bucket) || return 0
  local idx; idx=$(library_index 2>/dev/null) || return 0   # unreadable: the caller says so
  # Same empty-prefix exit-1 trap as library_list; an empty archive has no
  # orphans and must not abort the caller.
  aws s3 ls "s3://$b/steam/steamapps/" --recursive 2>/dev/null \
    | IDX="$idx" python3 -c '
import json, os, sys, collections
try:    apps = json.loads(os.environ["IDX"]).get("apps", [])
except Exception: apps = []
known_dirs = {a.get("installdir","") for a in apps}
known_ids  = {str(a.get("appid","")) for a in apps}
size = collections.Counter()
for line in sys.stdin:
    f = line.split(None, 3)
    if len(f) < 4: continue
    n, key = int(f[2]), f[3].rstrip("\n")
    parts = key.split("/")          # steam/steamapps/<area>/<name>/...
    if len(parts) < 4: continue
    area, name = parts[2], parts[3]
    if area == "common":
        if name not in known_dirs: size["common/" + name] += n
    elif area in ("compatdata", "shadercache"):
        if name not in known_ids:  size[area + "/" + name] += n
for k, v in sorted(size.items(), key=lambda kv: -kv[1]):
    print("%d\t%s" % (v, k))' || true
}

# The marks the cloud watchdog keeps, in one free call: when a machine was last
# seen, and each game's Reset. null when they could not be read - which is not
# "no marks", and the app says it does not know the dates rather than invent them.
library_marks_json() {
  local out
  out=$(cw_aws ssm get-parameters-by-path --path "/cloud-gaming/$TS_HOST/" --recursive \
          --query 'Parameters[].[Name,Value]' --output json 2>/dev/null) || out=""
  OUT="$out" HOSTP="/cloud-gaming/$TS_HOST/" python3 -c '
import json, os
raw = os.environ.get("OUT") or ""
if not raw.strip():
    print("null"); raise SystemExit
p, seen, kept = os.environ["HOSTP"], None, {}
for name, value in json.loads(raw) or []:
    rest = name[len(p):]
    if rest == "archive-last-seen": seen = value
    elif rest.startswith("kept/"): kept[rest[5:]] = value
print(json.dumps({"last_seen": seen, "kept": kept}))'
}

# library_place [bucket] -> "<bucket>\t<region>": the bucket in use when none is
# named, else the named one - only if cg made it for this account and host. A
# name typed or passed in is checked here, once, for every command that writes.
library_place() {
  local b="${1:-}" r acct
  if [[ -z $b ]]; then
    b=$(cg_bucket) || { echo "could not work out the archive bucket - AWS did not answer" >&2; return 1; }
  elif [[ $b != "$(cg_bucket 2>/dev/null)" ]]; then
    acct=$(aws sts get-caller-identity --query Account --output text 2>/dev/null) \
      || { echo "AWS did not answer - could not check that bucket is cg's" >&2; return 1; }
    r=$(s3_bucket_region "$b") || { echo "no such bucket, or AWS did not answer: $b" >&2; return 1; }
    cg_bucket_ours "$b" "$r" "$acct" "$TS_HOST" \
      || { echo "not one of this rig's buckets: $b (see: cg library elsewhere)" >&2; return 1; }
    printf '%s\t%s\n' "$b" "$r"; return 0
  fi
  r=$(s3_bucket_region "$b" 2>/dev/null) || r="$REGION"
  printf '%s\t%s\n' "$b" "$r"
}

# The games in one bucket, from its index - as library_index, for any of cg's.
library_index_at() { # library_index_at <bucket> <region>
  local out err rc reason
  err=$(mktemp)
  out=$(aws s3 cp "s3://$1/steam/index.json" - --region "$2" 2>"$err") && rc=0 || rc=$?
  if (( rc == 0 )); then rm -f "$err"; printf '%s' "$out"; return 0; fi
  reason=$(library_reason "$(cat "$err")"); rm -f "$err"
  [[ $reason == missing ]] && { echo '{"apps":[]}'; return 0; }
  printf '%s\n' "$reason" >&2
  return 1
}

# Games saved somewhere cg is not looking.
#
# Every other read here uses ONE bucket, the one .env names. A region move made
# a new one and left 162.8 GB of Diablo IV in the old region, billing Rs 386 a
# month with nothing pointing at it: Library said no games, a build offered
# none. AWS lists every bucket in the account in one call; cg keeps the ones it
# made for this account and host (cg_bucket_ours) - never anything merely named
# like them. Region lookups are free; reading inside is a handful of LIST
# requests, about Rs 0.003 for 6,000 files.
library_elsewhere_json() {
  local cur names b r work i=0 acct
  cur=$(cg_bucket 2>/dev/null) || cur=""
  acct=$(aws sts get-caller-identity --query Account --output text 2>/dev/null) || acct=""
  # Whether AWS answered is the exit status, not the output: an account with no
  # buckets at all lists nothing, and that is an answer - after a disconnect it
  # is the answer.
  local listed=1
  names=$(aws s3api list-buckets --query 'Buckets[].Name' --output text 2>/dev/null) || listed=0
  [[ $names == None ]] && names=""
  if [[ -z $acct ]] || (( ! listed )); then
    printf '{"error": "could not list your buckets - AWS did not answer", "places": null}\n'
    return 0
  fi
  work=$(mktemp -d)
  library_marks_json > "$work/marks"
  for b in $names; do
    [[ $b == cg-library-* && $b != "$cur" ]] || continue
    r=$(s3_bucket_region "$b" 2>/dev/null) || continue
    cg_bucket_ours "$b" "$r" "$acct" "$TS_HOST" || continue
    i=$((i + 1))
    # That region's own prices: a bucket bills at the rate where it is, and a
    # game leaves it at that region's transfer price.
    printf '%s\t%s\t%s\t%s\n' "$b" "$r" "$(cg_price "$r" CG_S3_USD_GB_MONTH)" \
      "$(cg_price "$r" CG_XREGION_USD_GB)" > "$work/$i.meta"
    # An empty prefix exits 1 with nothing on stderr: that is an empty bucket.
    # Anything said on stderr is a listing that failed, which is not.
    aws s3 ls "s3://$b/steam/" --recursive --region "$r" > "$work/$i.ls" 2> "$work/$i.err" || true
    aws s3 cp "s3://$b/steam/index.json" - --region "$r" > "$work/$i.idx" 2>/dev/null || true
    # A login copy beside them: who it signs in as, and when it was saved -
    # one 22 KB read, cached against its ETag like the one in use.
    if grep -q ' steam/account/' "$work/$i.ls"; then
      CG_ACCOUNT_BUCKET="$b" account_json > "$work/$i.login" 2>/dev/null || true
    fi
  done
  WORK="$work" N="$i" HERE="$REGION" DAYS="$(cw_expiry_days)" python3 -c '
import json, os, re
w, n = os.environ["WORK"], int(os.environ["N"])
GB = 1073741824.0
def num(v):
    try: return float(v)
    except (TypeError, ValueError): return None
read = lambda f: open(os.path.join(w, f)).read() if os.path.exists(os.path.join(w, f)) else ""
# A month of b bytes at a GB-month price; None when the price is unknown.
month = lambda b, rate: None if rate is None else round(b / GB * rate, 2)
marks = json.loads(read("marks") or "null")
kept = (marks or {}).get("kept") or {}
places = []
for i in range(1, n + 1):
    bucket, region, s3, xr = (read("%d.meta" % i).rstrip("\n").split("\t") + ["", "", ""])[:4]
    S3, XR = num(s3), num(xr)
    err = read("%d.err" % i).strip().splitlines()
    games_b = login_b = other_b = 0
    dirs = {}
    for line in read("%d.ls" % i).splitlines():
        m = re.match(r"\S+\s+\S+\s+(\d+)\s+(.*)$", line)
        if not m: continue
        size, key = int(m.group(1)), m.group(2)
        if key.startswith("steam/steamapps/"):
            games_b += size
            parts = key.split("/")
            if len(parts) > 4 and parts[2] == "common":
                dirs[parts[3]] = dirs.get(parts[3], 0) + size
        elif key.startswith("steam/account/"): login_b += size
        else: other_b += size
    try:    apps = json.loads(read("%d.idx" % i) or "{}").get("apps", [])
    except Exception: apps = []
    # The index names the games; without one, the folders they were saved in do.
    games = ([{"appid": str(a.get("appid")), "name": a.get("name") or a.get("installdir"),
               "installdir": a.get("installdir"), "bytes": a.get("bytes", 0), "pushed": a.get("pushed"),
               "usd_month": month(a.get("bytes", 0), S3),
               "kept": kept.get("%s/%s" % (bucket, a.get("appid")))} for a in apps]
             or [{"appid": None, "name": d, "installdir": d, "bytes": s, "pushed": None,
                  "usd_month": month(s, S3), "kept": None} for d, s in dirs.items()])
    total = games_b + login_b + other_b
    places.append({
        "bucket": bucket, "region": region or None,
        "error": err[0] if err else None,
        "bytes": None if err else total, "games_bytes": None if err else games_b,
        "usd_month": None if err else month(total, S3),
        # What it costs to bring a game from here to where the machine is built.
        "xregion_usd_gb": XR,
        "games": sorted(games, key=lambda g: -(g["bytes"] or 0)),
        "login": login_b > 0,
        # The same shape as library list --json gives for the one in use.
        "login_detail": (lambda s: json.loads(s) if s.strip() else None)(read("%d.login" % i)),
    })
known = [p for p in places if p["bytes"] is not None]
print(json.dumps({"error": None, "places": places,
                  # Where the machine is built, and what it costs to bring a
                  # game here - the app must not need another read for either.
                  "region": os.environ["HERE"],
                  "inr_per_usd": num(os.environ.get("CG_INR_PER_USD")),
                  "expiry_days": int(os.environ["DAYS"]),
                  "last_seen": (marks or {}).get("last_seen"),
                  "marks_read": marks is not None,
                  "bytes": sum(p["bytes"] for p in known),
                  "usd_month": None if any(p["usd_month"] is None for p in known)
                               else round(sum(p["usd_month"] for p in known), 2)}, indent=2))'
  rm -rf "$work"
}

library_elsewhere_show() {
  library_elsewhere_json | python3 -c '
import json, os, sys
d = json.load(sys.stdin)
if d.get("error"): print("  " + d["error"]); sys.exit(1)
def num(v):
    try: return float(v)
    except (TypeError, ValueError): return None
INR = num(os.environ.get("CG_INR_PER_USD"))
places = [p for p in d["places"] if p["bytes"] or p["error"]]
if not places: print("  nothing saved anywhere else - every game is in the archive cg uses"); sys.exit()
for p in places:
    if p["error"]:
        print("  %-14s could not be read: %s" % (p["region"] or "?", p["error"])); continue
    inr_str = ("   INR %.0f a month" % (p["usd_month"] * INR)) if (INR and p["usd_month"] is not None) else ""
    print("  %-14s %6.1f GB%s   s3://%s"
          % (p["region"] or "?", p["bytes"] / 1073741824, inr_str, p["bucket"]))
    for g in p["games"]: print("      %-10s %s" % (g["appid"] or "", g["name"]))
    if p["login"]: print("      (and a Steam login)")
print()
print("  cg does not use these. Bring one here: cg library move <appid> --from <bucket>")
print("  or stop paying for it:                 cg library forget <appid> --from <bucket>")'
}

# cg library reset <appid> [--from <bucket>] - start a game's countdown again
# today. The watchdog deletes a game N days after the later of "a machine was
# last seen" and this mark; it is an SSM parameter, which costs nothing.
library_reset() {
  local id="" from="" place bucket region
  while (( $# )); do case $1 in --from) from=${2:-}; shift 2 ;; -*) shift ;; *) id=$1; shift ;; esac; done
  [[ $id =~ ^[0-9]+$ ]] || die "which game? see: cg library list"
  place=$(library_place "$from") || die "$(library_place "$from" 2>&1 >/dev/null)"
  IFS=$'\t' read -r bucket region <<<"$place"
  say "counting it from today"
  cw_aws ssm put-parameter --name "/cloud-gaming/$TS_HOST/kept/$bucket/$id" --type String --overwrite \
    --value "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >/dev/null 2>&1 \
    || die "could not save the new date - AWS did not answer"
  log "kept: $id is counted from today - $(cw_expiry_days) days with no machine before it is deleted"
}

library_clean() {
  [[ -n ${GAME_S3_BUCKET:-} ]] || die "no bucket configured"
  local rows; rows=$(library_orphans)
  if [[ -z ${rows//[[:space:]]/} ]]; then
    echo "  no orphaned objects - everything in the archive is indexed"
    return 0
  fi
  local total=0 bytes prefix
  echo "These objects belong to no archived game - a push that never finished:"
  while IFS=$'\t' read -r bytes prefix; do
    [[ -n ${prefix:-} ]] || continue
    total=$(( total + bytes ))
    printf '  %10s  %s\n' "$(numfmt --to=iec --suffix=B "$bytes" 2>/dev/null)" "$prefix"
  done <<< "$rows"
  awk -v b="$total" -v r="$CG_S3_USD_GB_MONTH" -v inr="$CG_INR_PER_USD" 'BEGIN{ g=b/1073741824;
    printf "\n  %.1f GB, costing $%.2f/month (INR %.0f) for files no game can use\n", g, g*r, g*r*inr }'
  echo "  They are not restorable: with no manifest, Steam cannot see them."
  cg_ask_typed clean-orphans "type CLEAN to delete them: " CLEAN \
    || { echo "aborted - nothing was deleted"; return 1; }
  while IFS=$'\t' read -r bytes prefix; do
    [[ -n ${prefix:-} ]] || continue
    aws s3 rm "s3://$GAME_S3_BUCKET/steam/steamapps/$prefix" --recursive >/dev/null 2>&1 \
      && log "deleted $prefix" || log "could not delete $prefix"
  done <<< "$rows"
  log "storage charges for those stop now"
}

# --- the archived Steam login ------------------------------------------------
# A ~22 KB tarball at steam/account/steam-account.tgz. It is what makes a
# rebuilt box come up already signed in, and it is why a region move carried the
# login across while leaving 163 GB of games behind: the login is tiny and
# separate, the games are neither.
#
# It sits UNDER the steam/ prefix but is not part of the game archive, and
# conflating the two misreported both. `cg status` counted it and announced
# "1 objects, 22KB" beside the words "game library" for an account with no games
# archived whatsoever.
#
# Nothing here needs the box. That is the point: the login outlives every box,
# and the question "which account would a new box sign in as" has to be
# answerable when there is no box at all.
CG_ACCOUNT_KEY="steam/account/steam-account.tgz"

# bytes <TAB> modified <TAB> etag, or non-zero when there is no archived login.
# CG_ACCOUNT_BUCKET names another of this rig's buckets to read instead of the
# one in use - a region move leaves a login copy beside the games it left.
account_head() {
  local bucket region
  bucket=${CG_ACCOUNT_BUCKET:-$(cg_bucket)} || return 2
  region=$(s3_bucket_region "$bucket" 2>/dev/null) || region="$REGION"
  aws s3api head-object --bucket "$bucket" --key "$CG_ACCOUNT_KEY" \
      --region "$region" --query '[ContentLength,LastModified,ETag]' \
      --output text 2>/dev/null
}

# The accounts inside the tarball. The names live in loginusers.vdf, so this
# needs the object itself - 22 KB, one GET. Cached against the ETag rather than
# a clock: the blob changes only when a push replaces it, and then the ETag
# changes with it, so the cache can never be stale.
account_names() { # account_names <etag> -> steamid<TAB>account<TAB>persona<TAB>recent<TAB>ts
  local tag="${1:-none}" cache="account-${1:-none}.tsv"
  cg_cache_read "$cache" 2>/dev/null && return 0
  local bucket region tmp out
  bucket=${CG_ACCOUNT_BUCKET:-$(cg_bucket)} || return 1
  region=$(s3_bucket_region "$bucket" 2>/dev/null) || region="$REGION"
  tmp=$(mktemp -d) || return 1
  out=""
  if aws s3 cp "s3://$bucket/$CG_ACCOUNT_KEY" "$tmp/a.tgz" --region "$region" >/dev/null 2>&1; then
    # Only the one member, and only if it is there: ssfn files and userdata are
    # none of this function's business, and tar fails the lot on a missing name.
    tar -xzf "$tmp/a.tgz" -C "$tmp" --wildcards '*loginusers.vdf' 2>/dev/null || true
    local vdf; vdf=$(find "$tmp" -name loginusers.vdf -type f 2>/dev/null | head -1)
    [[ -n $vdf ]] && out=$(python3 -I - "$vdf" <<'PYEOF'
import re, sys
# loginusers.vdf is Valve KeyValues: a "users" block, one nested block per
# account keyed by steamid. Parsed with a scanner rather than a regex per field
# so two accounts cannot have their fields crossed.
try:
    t = open(sys.argv[1], encoding="utf-8", errors="replace").read()
except Exception:
    sys.exit(0)
rows = []
for m in re.finditer(r'"(\d{6,})"\s*\{(.*?)\}', t, re.S):
    sid, body = m.group(1), m.group(2)
    f = dict(re.findall(r'"([^"]+)"\s+"([^"]*)"', body))
    rows.append((sid,
                 f.get("AccountName", ""),
                 f.get("PersonaName", ""),
                 f.get("MostRecent", "0"),
                 f.get("Timestamp", "")))
# Most recent first, then by timestamp: the one a new box would land on is the
# one worth reading first.
rows.sort(key=lambda r: (r[3] != "1", -int(r[4] or 0)))
for r in rows:
    print("\t".join(r))
PYEOF
)
  fi
  rm -rf "$tmp"
  [[ -n ${out//[[:space:]]/} ]] || return 1
  printf '%s\n' "$out" | cg_cache_write "$cache"
  printf '%s\n' "$out"
}

# The whole thing as data, for the app and for account_show.
account_json() {
  local head bytes modified etag names bucket
  bucket=${CG_ACCOUNT_BUCKET:-$(cg_bucket 2>/dev/null)} || bucket=""
  if ! head=$(account_head) || [[ -z ${head//[[:space:]]/} ]]; then
    BUCKET="$bucket" python3 -I -c '
import json, os
print(json.dumps({"bucket": os.environ.get("BUCKET") or None,
                  "present": False, "accounts": []}, indent=2))'
    return 0
  fi
  IFS=$'\t' read -r bytes modified etag <<<"$head"
  names=$(account_names "${etag//\"/}" 2>/dev/null) || names=""
  BUCKET="$bucket" KEY="$CG_ACCOUNT_KEY" BYTES="$bytes" WHEN="$modified" \
  NAMES="$names" python3 -I -c '
import json, os
rows = []
for line in (os.environ.get("NAMES") or "").splitlines():
    p = line.split("\t")
    if len(p) < 5 or not p[0]:
        continue
    rows.append({"steamid": p[0], "account": p[1] or None, "persona": p[2] or None,
                 "most_recent": p[3] == "1",
                 "last_used": int(p[4]) if p[4].isdigit() else None})
# Steam writes MostRecent only when there is a choice to record. With exactly
# one archived account that key is absent, and leaving the row unmarked implied
# a new box would sign in as nobody - when that one account is precisely what it
# signs in as.
if len(rows) == 1:
    rows[0]["most_recent"] = True
b = int(os.environ["BYTES"]) if os.environ["BYTES"].isdigit() else 0
def num(v):
    try: return float(v)
    except (TypeError, ValueError): return None
s3 = num(os.environ.get("CG_S3_USD_GB_MONTH"))
print(json.dumps({
  "bucket": os.environ.get("BUCKET") or None,
  "key": os.environ["KEY"],
  "present": True,
  "bytes": b,
  "modified": os.environ.get("WHEN") or None,
  # Said out loud because it governs whether deleting is worth doing: it is not
  # a saving, it is a choice about which account a new box signs in as.
  "usd_month": round(b / 1073741824.0 * s3, 6) if s3 is not None else None,
  # None means "could not read the names", NOT "no accounts" - the archive
  # cannot exist with nobody in it, so an empty list would be a lie.
  "accounts": rows or None,
}, indent=2))'
}

account_show() {
  if (( JSON )); then account_json; return; fi
  account_json | python3 -I -c '
import json, sys, datetime
d = json.load(sys.stdin)
if not d.get("present"):
    print("no archived Steam login - a new box would ask you to sign in")
    print("  one is pushed automatically when a box shuts down, or now with:")
    print("      cg library account push")
    sys.exit()
kb = d["bytes"] / 1024.0
print("archived login   %s  (%.1f KB)" % (d["key"], kb))
when = d.get("modified")
if when:
    print("pushed           %s" % when)
# A cost line, because every other archive view has one - and this one exists
# mainly to say the number is nothing, so deleting it is not a saving.
print("storage          $%.6f/month - effectively nothing" % d["usd_month"])
rows = d.get("accounts")
if rows is None:
    print("accounts         could not read them from the archive")
    sys.exit()
print()
print("  %-20s %-20s %-12s %s" % ("ACCOUNT", "PERSONA", "LAST USED", ""))
for r in rows:
    ts = r.get("last_used")
    when = datetime.datetime.fromtimestamp(ts).strftime("%Y-%m-%d") if ts else "-"
    mark = "<- a new box signs in as this one" if r.get("most_recent") else ""
    print("  %-20s %-20s %-12s %s" % (r.get("account") or "?",
                                      r.get("persona") or "-", when, mark))
if len(rows) > 1:
    print()
    print("  More than one account is archived. The tarball is restored whole, so")
    print("  a new box gets all of them and signs in as the most recent. To keep")
    print("  only one: sign in as it on the box, then cg library account push.")
'
}

# Deleting is all-or-nothing on purpose. Removing ONE account would mean editing
# loginusers.vdf, that account's ConnectCache entry in local.vdf and its
# userdata/<id>/, then repacking - undocumented Steam internals where a near
# miss produces an archive that restores a BROKEN login, which is worse than
# having none. Replacing the blob is the supported way to change accounts.
account_forget() {
  local from="" place bucket region
  while (( $# )); do case $1 in --from) from=${2:-}; shift 2 ;; *) shift ;; esac; done
  place=$(library_place "$from") || die "$(library_place "$from" 2>&1 >/dev/null)"
  IFS=$'\t' read -r bucket region <<<"$place"
  [[ -n $from ]] && export CG_ACCOUNT_BUCKET="$bucket"
  local j; j=$(account_json)
  python3 -I -c 'import json,sys; sys.exit(0 if json.load(sys.stdin).get("present") else 1)' <<<"$j" \
    || { echo "there is no archived Steam login - nothing to delete"; return 0; }
  printf '%s' "$j" | python3 -I -c '
import json, sys
d = json.load(sys.stdin)
rows = d.get("accounts") or []
print("This permanently deletes the archived Steam login.")
if rows:
    print("It holds %d account%s: %s" % (len(rows), "" if len(rows) == 1 else "s",
          ", ".join(r.get("account") or "?" for r in rows)))
print()
print("  No undo, no versioning. Your games are NOT affected - they are a")
print("  separate archive. What you lose is the signed-in state: the next box")
print("  will ask for your password and Steam Guard code.")
print()
print("  It saves $%.6f a month, which is to say nothing. Delete it to change" % d["usd_month"])
print("  which account a new box uses, not to save money.")'
  cg_ask_typed forget-login "type FORGET to confirm: " FORGET \
    || { echo "aborted - nothing was deleted"; return 1; }
  say "deleting the Steam login saved in $region"
  aws s3 rm "s3://$bucket/$CG_ACCOUNT_KEY" --region "$region" >/dev/null 2>&1 \
    || die "could not delete s3://$bucket/$CG_ACCOUNT_KEY"
  log "deleted the archived Steam login"
  if [[ -z $from ]]; then
    log "the next box will ask you to sign in; it is re-archived on shutdown"
    return 0
  fi
  # A copy beside games left in another region: if nothing else is saved
  # there now, the bucket goes too - nothing points at it.
  local idx left
  idx=$(library_index_at "$bucket" "$region" 2>/dev/null) || return 0
  left=$(printf '%s' "$idx" | python3 -c 'import json,sys; print(len(json.load(sys.stdin).get("apps",[])))' 2>/dev/null)
  if [[ $left == 0 ]]; then
    aws s3 rb "s3://$bucket" --force --region "$region" >/dev/null 2>&1 \
      && log "nothing else was saved in $region - removed it, so nothing bills there"
  fi
}

# library_forget_at <bucket> <region> <appid> <idx> - remove one game from one
# bucket, no questions: the asking is library_forget's, and a move calls this
# once the copy is verified. A bucket that is not the one in use and holds no
# game afterwards is removed too - nothing points at it, and it only bills.
library_forget_at() {
  local bucket=$1 region=$2 id=$3 idx=$4 dir pair tmp left
  dir=$(printf '%s' "$idx" | python3 -c '
import json,sys
for a in json.load(sys.stdin).get("apps",[]):
    if str(a.get("appid"))==sys.argv[1]: print(a.get("installdir","")); break' "$id")
  # The folder is deleted recursively: an empty or climbing name would take
  # every game in the bucket with it.
  [[ -n $dir && $dir != *"/"* && $dir != "." && $dir != ".." ]] \
    || die "refusing to delete $id: its install folder is '${dir}'"
  for pair in "common/$dir" "compatdata/$id" "shadercache/$id"; do
    # The trailing slash is the boundary: without it "common/Diablo IV" is a
    # prefix of "common/Diablo IV Expansion" too, and --recursive deletes both.
    aws s3 rm "s3://$bucket/steam/steamapps/$pair/" --recursive --region "$region" >/dev/null 2>&1 || true
  done
  aws s3 rm "s3://$bucket/steam/steamapps/appmanifest_$id.acf" --region "$region" >/dev/null 2>&1 || true
  aws s3 rm "s3://$bucket/steam/meta/symlinks-$id.tsv" --region "$region" >/dev/null 2>&1 || true
  # Drop it from the index too, or cg init keeps offering a game that is gone.
  tmp=$(mktemp)
  printf '%s' "$idx" | python3 -c '
import json,sys
appid=sys.argv[1]
try:    d=json.load(sys.stdin)
except Exception: d={"apps":[]}
print(json.dumps({"apps":[a for a in d.get("apps",[]) if str(a.get("appid"))!=appid]},indent=1))' "$id" > "$tmp"
  left=$(python3 -c 'import json,sys; print(len(json.load(open(sys.argv[1]))["apps"]))' "$tmp")
  aws s3 cp "$tmp" "s3://$bucket/steam/index.json" --region "$region" >/dev/null 2>&1 \
    || log "could not update the index"
  rm -f "$tmp"
  cw_aws ssm delete-parameter --name "/cloud-gaming/$TS_HOST/kept/$bucket/$id" >/dev/null 2>&1 || true
  if [[ $left == 0 && $bucket != "$(cg_bucket 2>/dev/null)" ]]; then
    aws s3 rb "s3://$bucket" --force --region "$region" >/dev/null 2>&1 \
      && log "nothing else was saved in $region - removed it, so nothing bills there" \
      || log "nothing else is saved in $region, but it could not be removed: cg library elsewhere"
  fi
}

library_forget() {
  local id="" from="" place bucket region idx err row name bytes gb
  while (( $# )); do case $1 in --from) from=${2:-}; shift 2 ;; -*) shift ;; *) id=$1; shift ;; esac; done
  [[ -n $id ]] || die "which game? see: cg library list"
  # The bucket in use must be named in .env to be deleted from - a derived name
  # is fine to read, not to delete in. Another bucket is checked as cg's instead.
  [[ -n $from || -n ${GAME_S3_BUCKET:-} ]] || die "no bucket configured"
  place=$(library_place "$from") || die "$(library_place "$from" 2>&1 >/dev/null)"
  IFS=$'\t' read -r bucket region <<<"$place"
  err=$(mktemp)
  idx=$(library_index_at "$bucket" "$region" 2>"$err") || { local why; why=$(cat "$err"); rm -f "$err"
    die "cannot read the archive: $why"; }
  rm -f "$err"
  row=$(printf '%s' "$idx" | python3 -c '
import json,sys
appid=sys.argv[1]
try:    apps=json.load(sys.stdin).get("apps",[])
except Exception: apps=[]
for a in apps:
    if str(a.get("appid"))==appid:
        print("%s\t%s" % (a.get("name","?"), a.get("bytes",0))); break' "$id")
  [[ -n ${row//[[:space:]]/} ]] || die "appid $id is not in the archive (see: cg library list)"
  IFS=$'\t' read -r name bytes <<<"$row"
  gb=$(awk -v b="$bytes" 'BEGIN{printf "%.1f", b/1073741824}')
  echo "This permanently deletes $name ($id, ${gb} GB) from the archive in $region."
  echo "No undo, no versioning. Playing it again means downloading it from Steam."
  echo "At Steam speeds that is roughly $(awk -v b="$bytes" 'BEGIN{printf "%.1f", b/12582912/3600}') hours."
  cg_ask_typed forget-game "type FORGET to confirm: " FORGET \
    || { echo "aborted - nothing was deleted"; return 1; }
  say "deleting $name from $region"
  library_forget_at "$bucket" "$region" "$id" "$idx"
  log "forgot $name ($id) - ${gb} GB stops billing"
}

# cg library keep-for <days> - how long saved games are kept with no machine,
# applied now. The setting alone changes nothing until the cloud watchdog is
# redeployed with it - the Guards page says so for the others - so this does
# both, and the date the app shows is the date AWS will act on.
library_keep_for() {
  local d="${1:-}"
  case $d in forever|never) d=0 ;; esac
  [[ $d =~ ^[0-9]+$ ]] || die "how many days? e.g. cg library keep-for 14 (0 keeps them until you forget them)"
  say "saving the setting"
  config_set GAME_ARCHIVE_EXPIRY_DAYS "$d"
  export GAME_ARCHIVE_EXPIRY_DAYS="$d"
  say "updating auto-stop"
  cw_adopt_ntfy
  cw_install || die "saved, but the cloud watchdog still counts the old days - run: cg watchdog install"
  if (( d == 0 )); then log "saved games are kept until you forget them"
  else log "saved games are deleted $d days after a machine was last running"; fi
}

# cg library move <appid> --from <bucket> - bring a game left in another region
# to the one the machine is built in. Copied server to server, checked file for
# file, and only then deleted at the source: a copy that does not match leaves
# both where they were. AWS bills the copy once, between regions; after it a
# build downloads the game in its own region, which is free.
library_move() {
  local id="" from="" place sb sr db dr sidx didx row name dir bytes gb usd pair a b tmp
  while (( $# )); do case $1 in --from) from=${2:-}; shift 2 ;; -*) shift ;; *) id=$1; shift ;; esac; done
  [[ $id =~ ^[0-9]+$ && -n $from ]] || die "usage: cg library move <appid> --from <bucket>"
  place=$(library_place "$from") || die "$(library_place "$from" 2>&1 >/dev/null)"
  IFS=$'\t' read -r sb sr <<<"$place"
  db=$(cg_bucket) || die "could not work out where your machine's games are kept - AWS did not answer"
  [[ $sb != "$db" ]] || die "that game is already where your machine is built"
  aws s3api head-bucket --bucket "$db" >/dev/null 2>&1 \
    || die "nothing is saved where your machine is built yet - build once, then move"
  dr=$(s3_bucket_region "$db") || dr="$REGION"
  sidx=$(library_index_at "$sb" "$sr") || die "cannot read the games in $sr"
  didx=$(library_index_at "$db" "$dr") || die "cannot read the games in $dr"
  row=$(printf '%s' "$sidx" | python3 -c '
import json,sys
for a in json.load(sys.stdin).get("apps",[]):
    if str(a.get("appid"))==sys.argv[1]:
        print("%s\t%s\t%s" % (a.get("name","?"), a.get("installdir",""), a.get("bytes",0))); break' "$id")
  [[ -n ${row//[[:space:]]/} ]] || die "appid $id is not saved in $sr (see: cg library elsewhere)"
  IFS=$'\t' read -r name dir bytes <<<"$row"
  [[ -n $dir && $dir != *"/"* && $dir != "." && $dir != ".." ]] || die "refusing to move $id: its install folder is '${dir}'"
  gb=$(awk -v b="$bytes" 'BEGIN{printf "%.1f", b/1073741824}')
  echo "This copies $name (${gb} GB) from $sr to $dr, checks every file, then deletes it from $sr."
  # Billed where the bytes leave, at that region's price - and not at all
  # inside one region, where a copy pays only its requests.
  local xr; xr=$( [[ $sr == "$dr" ]] && echo 0 || cg_price "$sr" CG_XREGION_USD_GB ) || xr=""
  if [[ $xr == 0 ]]; then
    echo "Both are in $dr, so there is no transfer charge - only a few rupees of requests."
  elif [[ -n $xr && -n ${CG_INR_PER_USD:-} ]]; then
    echo "AWS charges about INR $(awk -v b="$bytes" -v r="$xr" -v i="$CG_INR_PER_USD" 'BEGIN{printf "%.0f", b/1073741824*r*i}') once to copy between regions."
  else
    echo "AWS charges once, by the GB, to copy between regions - the price could not be read."
  fi
  cg_ask_typed move-game "type MOVE to confirm: " MOVE || { echo "aborted - nothing was copied"; return 1; }
  local part=0
  for pair in "common/$dir" "compatdata/$id" "shadercache/$id"; do
    part=$((part + 1))
    say "copying $name (part $part of 3)"
    aws s3 sync "s3://$sb/steam/steamapps/$pair/" "s3://$db/steam/steamapps/$pair/" \
      --source-region "$sr" --region "$dr" --only-show-errors \
      || die "the copy stopped - nothing was deleted from $sr; run the move again to finish it"
  done
  for a in "steamapps/appmanifest_$id.acf" "meta/symlinks-$id.tsv"; do
    aws s3 cp "s3://$sb/steam/$a" "s3://$db/steam/$a" --source-region "$sr" --region "$dr" \
      --only-show-errors >/dev/null 2>&1 || true
  done
  say "checking the copy"
  for pair in "common/$dir" "compatdata/$id" "shadercache/$id"; do
    a=$(aws s3 ls "s3://$sb/steam/steamapps/$pair/" --recursive --summarize --region "$sr" 2>/dev/null \
        | awk '/Total Objects:/{o=$3} /Total Size:/{s=$3} END{print o+0, s+0}') || a="? ?"
    b=$(aws s3 ls "s3://$db/steam/steamapps/$pair/" --recursive --summarize --region "$dr" 2>/dev/null \
        | awk '/Total Objects:/{o=$3} /Total Size:/{s=$3} END{print o+0, s+0}') || b="?? ??"
    [[ $a == "$b" ]] || die "the copy of $pair does not match ($a here, $b there) - nothing was deleted from $sr; run the move again"
  done
  # In the machine's index before it leaves the old one: at no moment is the
  # game in neither.
  tmp=$(mktemp)
  printf '%s' "$didx" | SRC="$sidx" python3 -c '
import json,os,sys
appid=sys.argv[1]
try:    d=json.load(sys.stdin)
except Exception: d={"apps":[]}
src=[a for a in json.loads(os.environ["SRC"]).get("apps",[]) if str(a.get("appid"))==appid]
d["apps"]=[a for a in d.get("apps",[]) if str(a.get("appid"))!=appid]+src
print(json.dumps(d,indent=1))' "$id" > "$tmp"
  aws s3 cp "$tmp" "s3://$db/steam/index.json" --region "$dr" >/dev/null 2>&1 \
    || { rm -f "$tmp"; die "copied, but the index in $dr could not be written - nothing was deleted from $sr"; }
  rm -f "$tmp"
  say "deleting it from $sr"
  library_forget_at "$sb" "$sr" "$id" "$sidx"
  log "moved $name to $dr - a build there downloads it free"
}

# Re-run the Moonlight/Sunshine handshake without rebuilding the box.
#
# Pairing is per Sunshine instance, so every rebuild needs a fresh one, and
# `cg init` does it. When that step fails - it has - the box streams nothing and
# the only recourse used to be another twenty-minute build. Sunshine reporting
# "paired clients: 0" is the symptom; this is the four-second fix.
cmd_pair() {
  need_node
  local ip; ip=$(tailscale ip -4 "$TS_NODE")
  [[ -n ${SUNSHINE_USER:-} && -n ${SUNSHINE_PASS:-} ]] \
    || die "no Sunshine credentials in .env - they are written by cg init"
  command -v moonlight >/dev/null || die "moonlight is not installed"

  if timeout 30 moonlight list "$ip" 2>/dev/null | grep -q .; then
    log "already paired with $TS_NODE ($ip)"
    return 0
  fi
  say "pairing with $TS_NODE ($ip)"
  # shellcheck source=lib/pair.sh
  source lib/pair.sh
  if pair_moonlight "$ip" "$SUNSHINE_USER" "$SUNSHINE_PASS"; then
    log "paired - cg open should stream now"
  else
    die "pairing failed. The web UI is https://$ip:47990 (credentials in .env)"
  fi
}

cmd_library() {
  case "${1:-status}" in
    status|"")
      need_node
      box '/usr/local/bin/cg-library status' | cg_report "📦" "Game library on the box" ;;
    push|sync)
      shift
      need_node
      box "/usr/local/bin/cg-library push $*" ;;
    pull|restore)
      shift
      need_node
      box "/usr/local/bin/cg-library pull $*" ;;
    check)
      need_node
      box '/usr/local/bin/cg-library check' ;;
    list)
      if (( JSON )); then library_json; return; fi
      # Say it here too: this is the view people check, and an unindexed pile
      # is invisible everywhere else.
      local orph; orph=$(library_orphans 2>/dev/null)
      {
      library_list
      if [[ -n ${orph//[[:space:]]/} ]]; then
        awk -F'\t' '{t+=$1} END{ if (t>0) printf "\n  plus %.1f GB of ORPHANED objects from an unfinished push\n  costing $%.2f/month and unusable - remove them: cg library clean\n", t/1073741824, t/1073741824*ENVIRON["CG_S3_USD_GB_MONTH"] }' <<<"$orph"
      fi
      } | cg_report "📦" "Game archive" ;;
    account|login)
      shift
      # Flags are recognised globally but NOT removed from "$@" (see the loop at
      # the top), so `cg library account --json` arrived here with --json as the
      # subcommand and died on the usage line. `list` never noticed because it
      # ignores its arguments entirely and only reads $JSON.
      while [[ ${1:-} == -* ]]; do shift; done
      # status and forget answer from S3 and must NOT need the box: the whole
      # point of the archived login is that it outlives every box, so "which
      # account would a new box use" has to be answerable when there is none.
      case "${1:-status}" in
        status|"")         account_show ;;
        forget|delete|rm)  shift; account_forget "$@" ;;
        push|pull|restore) need_node; box "/usr/local/bin/cg-library account ${1/restore/pull}" ;;
        *) die "usage: cg library account [status|push|pull|forget]" ;;
      esac ;;
    forget)
      shift; library_forget "$@" ;;
    clean)
      library_clean ;;
    elsewhere)
      if (( JSON )); then library_elsewhere_json
      else library_elsewhere_show | cg_report "📦" "Saved somewhere else"; fi ;;
    reset|keep)
      shift; library_reset "$@" ;;
    keep-for)
      shift; library_keep_for "$@" ;;
    move)
      shift; library_move "$@" ;;
    --bucket|bucket)
      # Answerable without the box, which matters when it is gone: this is where
      # the games are, and the one thing worth knowing then.
      cg_bucket || echo "(unknown - AWS did not answer)"; echo ;;
    *) die "usage: cg library [list|status|push|pull [--apps <csv>]|account [status|push|pull|forget]|check|forget <appid> [--from <bucket>]|reset <appid> [--from <bucket>]|keep-for <days>|move <appid> --from <bucket>|elsewhere|clean|--bucket]" ;;
  esac
}

# `cg destroy` deliberately keeps the game volume. `--all` is the way to say
# "no, everything" - and it has to be a real flag rather than a silently
# ignored argument, or someone types it, sees "everything deleted", and keeps
# paying INR 1,284/month for a volume they believe is gone.
cmd_destroy() {
  local all=0 force=0 nopush=0 a
  for a in "$@"; do
    case $a in
      --all)     all=1 ;;
      --force)   force=1 ;;
      --no-push) nopush=1 ;;
      # Refuse anything else rather than ignore it: a typo like --everything
      # must not quietly behave as a plain destroy and leave the volume billing.
      *) die "unknown option '$a' for destroy (--all, --force, --no-push)" ;;
    esac
  done
  # A stream from this laptop is watching the box that is about to be deleted.
  # Left alone, Moonlight goes black in the middle of the push and the `cg open`
  # behind it then offers to end a box that is already gone. Close it first.
  session_end_first

  # --all means the games go too, so mirroring them to S3 first and then
  # deleting the archive would be absurd. That path skips the push entirely.
  if (( all )); then
    destroy_everything "$force"
    return
  fi

  # Destroy takes the instance store with it, and that is where the games are.
  # A failed push is not a warning to print and carry on past - it means the
  # next `cg init` re-downloads everything, which is the exact problem this
  # whole design exists to solve.
  #
  # But only a RUNNING box can be pushed from. Gating on the push regardless of
  # state made destroying a stopped box impossible without --force, which would
  # have trained the habit of passing --force to destroy.
  # --no-push: archive exactly as it is, and make sure nothing changes it.
  if (( nopush )); then
    say "destroying WITHOUT mirroring - the archive is left exactly as it is"
    if ! archive_lock ro; then
      die "could not revoke the box's write access, so its shutdown mirror could still
       overwrite the archive. Either grant iam:PutRolePolicy, or wait for the box
       to finish what it is doing and destroy normally."
    fi
    _cg_section_end 0
    lib/setup destroy
    # The instance is gone, so restore normal access. If this is interrupted the
    # policy stays read-only, and `cg init` rewrites it on the next build.
    archive_lock rw || log "archive left read-only - cg init restores it"
    return
  fi

  local st; st=$(box_state)
  if [[ $st == running ]]; then
    if ! library_push; then
      if (( ! force )); then
        {
        echo
        echo "  The push from here failed, which usually means ssh cannot reach the box."
        echo "  That is not the same as 'the games are lost':"
        echo
        echo "    cg-library-shutdown.service runs ON the box, from ExecStop, and"
        echo "    mirrors the library as the machine shuts down. It needs no ssh."
        echo "    Terminating sends a graceful shutdown, so it still runs."
        echo
        echo "  So --force is usually safe here. Afterwards, confirm it worked:"
        echo "      cg library list      # the archive, read straight from S3"
        echo
        } | cg_block "🚧" "The push from here failed"
        die "not mirrored from here - see above, then: cg destroy --force"
      fi
      log "WARNING: proceeding without a mirror (--force) - games will be re-downloaded"
    fi
  else
    log "box is $st - nothing local to push"
    archive_report || log "the archive is EMPTY - if you expected games in it, stop here"
  fi
  # lib/setup is a separate process and cannot close a step this one opened.
  _cg_section_end 0
  lib/setup destroy
}

# `--all` used to mean "the box and the EBS game volume". The games moved to S3,
# so a flag that deleted the volume and left the archive billing was promising
# "nothing left billing" while ignoring the only storage that still costs
# anything - and, once that volume was gone, it was silently identical to a
# plain destroy. It now deletes the ARCHIVE, which is the games.
#
# This is the single unrecoverable action in this repo: the archive is the only
# copy, with no versioning and no snapshot. So it asks for a typed word rather
# than trusting a flag - a mis-typed flag is exactly what must not reach here.
destroy_everything() {
  local force="${1:-0}" vol size b n sz out a i
  b="${GAME_S3_BUCKET:-}"
  read -r vol size < <(ec2 describe-volumes --filters "Name=tag:Name,Values=${TS_HOST}-games" \
    --query 'Volumes[0].[VolumeId,Size]' --output text 2>/dev/null)

  echo "--all deletes the box AND every game you have."
  echo
  if [[ -n $b ]]; then
    out=$(aws s3 ls "s3://$b/steam/" --recursive --summarize 2>/dev/null | tail -2) || true
    n=$(awk '/Total Objects:/{print $3}' <<<"$out")
    sz=$(awk '/Total Size:/{print $3}' <<<"$out")
    printf '  game archive    s3://%s/steam  %s objects, %s\n' "$b" "${n:-0}" \
      "$(numfmt --to=iec --suffix=B "${sz:-0}" 2>/dev/null || echo "${sz:-0}B")"
    echo "                  THIS IS THE ONLY COPY - no versions, no snapshot, no undo"
  else
    echo "  game archive    (no bucket recorded in .env - nothing to delete)"
  fi
  [[ -n ${vol:-} && $vol != None ]] && printf '  old EBS volume  %s  %s GB\n' "$vol" "$size"
  echo "  the box         everything cg destroy normally removes"
  echo
  if [[ -n $b ]]; then
    echo "  the bucket      s3://$b itself"
  fi
  # Only list what actually EXISTS. This used to announce the role and the
  # watchdog user unconditionally, so a run with neither of them present read as
  # though both were about to be deleted - and then said nothing more about the
  # watchdog, leaving no way to tell "removed" from "was never there" from
  # "skipped by a bug".
  local role_x=0 cw_x=0
  aws iam get-role --role-name "${TS_HOST}-box" >/dev/null 2>&1 && role_x=1
  cw_exists && cw_x=1
  if (( role_x )); then
    echo "  instance role   ${TS_HOST}-box, and its instance profile"
  fi
  if (( cw_x )); then
    echo "  cloud watchdog  $CW_NAME - its function, schedule, role and logs"
  fi
  (( role_x || cw_x )) || echo "  IAM             nothing - no role or watchdog exists"
  echo
  echo "Nothing is left behind. cg init recreates all of it - the bucket name is"
  echo "derived from your account, so it comes back identical."
  echo
  if (( ! force )); then
    cg_ask_typed destroy-all "type DESTROY-ALL to confirm: " DESTROY-ALL \
      || { echo "aborted - nothing was deleted"; return 1; }
  fi

  CG_DESTROY_ALL=1 lib/setup destroy

  if [[ -n $b ]]; then
    say "deleting the game archive and its bucket s3://$b"
    # --force empties the bucket first; a bucket with anything in it cannot be
    # removed, and that includes incomplete multipart uploads, which appear in
    # no listing and are the usual reason a "delete the bucket" step fails.
    if aws s3 rb "s3://$b" --force >/dev/null 2>&1; then
      log "bucket deleted - storage charges stop now"
    else
      log "could not delete the bucket; check: aws s3 ls s3://$b --recursive --summarize"
      log "  incomplete multipart uploads also block it:"
      log "  aws s3api list-multipart-uploads --bucket $b"
    fi
    # .env must not keep pointing at a bucket that no longer exists, or the next
    # status prints a name for something deleted.
    local envf; envf=$(cg_env_file)
    if [[ -f $envf ]]; then
      local tmp; tmp=$(mktemp)
      grep -vE '^GAME_S3_BUCKET=' "$envf" > "$tmp" 2>/dev/null || true
      cat "$tmp" > "$envf"; rm -f "$tmp"; chmod 600 "$envf"
    fi
  fi

  # The role and instance profile cost nothing, but "--all" that leaves IAM
  # objects behind is not --all. Order matters: a role cannot be deleted while
  # it is in an instance profile or has an inline policy attached.
  local prof="${TS_HOST}-box"
  say "removing the instance role $prof"
  aws iam remove-role-from-instance-profile --instance-profile-name "$prof" \
    --role-name "$prof" >/dev/null 2>&1 || true
  aws iam delete-instance-profile --instance-profile-name "$prof" >/dev/null 2>&1 || true
  aws iam delete-role-policy --role-name "$prof" --policy-name library-rw >/dev/null 2>&1 || true
  if aws iam delete-role --role-name "$prof" >/dev/null 2>&1; then
    log "deleted role and instance profile $prof"
  else
    log "role $prof was already gone"
  fi

  # The cloud watchdog costs nothing, but --all leaves nothing. It is removed
  # schedule first, so nothing invokes a half-deleted function.
  say "removing the cloud watchdog $CW_NAME"
  cw_remove

  [[ -n ${vol:-} && $vol != None ]] || return 0
  # Terminating the instance detaches it, but AWS takes a moment to let go.
  say "deleting the old game library volume $vol"
  for i in $(seq 1 40); do
    [[ $(ec2 describe-volumes --volume-ids "$vol" --query 'Volumes[0].State' \
         --output text 2>/dev/null) == available ]] && break
    cg_sleep 3
  done
  if ec2 delete-volume --volume-id "$vol" >/dev/null 2>&1; then
    log "deleted $vol - storage charges stop now"
  else
    log "could not delete $vol; retry with: cg games --delete"
  fi
}

# Layer 3: the cloud watchdog. The pieces are in lib/cloud-watchdog.sh.
#
# Called by `cg init` before anything launches. It watches by TAG, so it does
# not need the instance to exist - and the point of an independent guard is that
# it is already watching when the box appears. When nothing changed this is one
# parallel round of read-only calls: no redeploy, and no new check. Never fatal:
# a missing guard must not stop you building a box.
watchdog_ensure() {
  _cg_styled && _cg_live "checking the cloud watchdog"
  cw_adopt_ntfy
  if cw_current; then
    cw_report_last
  else
    if [[ $CW_DRIFT == "no function" ]]; then
      say "arming the cloud watchdog before anything launches"
    else
      say "updating the cloud watchdog: $CW_DRIFT"
    fi
    # A subshell, so nothing inside can end `cg init`.
    if ( cw_install ); then
      cw_prove
    else
      log "cloud watchdog not installed - the on-host watchdog and the budget still apply"
      return 0
    fi
  fi
  return 0
}

# A test message, to check the phone end before relying on it. The topic is not
