cmd_ping() {
  need_node
  # Latency alone does not explain a bad session; whether the path is direct or
  # relayed through DERP usually does, and nothing else surfaces it.
  local out
  if (( WATCH )); then
    exec tailscale ping --until-direct=false "$TS_NODE"
  fi
  out=$(tailscale ping -c 5 --timeout 3s "$TS_NODE" 2>&1 || true)
  local path="unknown" ms=""
  # `|| true` on every one of these: the whole script runs under `set -e`, and a
  # grep that simply does not match is the normal case here, not an error. Without
  # it `cg ping` exited silently and printed nothing at all.
  grep -q 'via DERP' <<<"$out" && path="DERP relay (slower - UDP 41641 may be blocked)" || true
  grep -qE 'via [0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' <<<"$out" && path="direct" || true
  ms=$(grep -oE 'in [0-9]+ms' <<<"$out" | grep -oE '[0-9]+' | sort -n \
       | awk '{a[NR]=$1} END{if(NR)printf "%d", a[int((NR+1)/2)]}' || true)
  if (( JSON )); then
    printf '{"node":"%s","path":"%s","median_ms":%s}\n' "$TS_NODE" "${path%% *}" "${ms:-null}"
  else
    {
      printf '\n  node    %s (%s)\n' "$TS_NODE" "$(tailscale ip -4 "$TS_NODE" 2>/dev/null)"
      printf '  path    %s\n' "$path"
      printf '  latency %s\n\n' "${ms:+${ms}ms median}${ms:-no reply}"
      [[ $path == DERP* ]] && printf '  A relayed path adds latency and costs bandwidth both ways.\n  Check the security group still allows inbound UDP 41641.\n\n' || true
    } | cg_report "📡" "connection to $TS_NODE"
  fi
}

cmd_watcher() {
  if (( WATCH )); then box 'journalctl -t idle-watchdog -f'; return; fi
  say "guards"
  local s
  s=$(ec2 describe-instances --instance-ids "${INSTANCE_ID:-x}" \
      --query 'Reservations[0].Instances[0].State.Name' --output text 2>/dev/null || echo "none")
  # Rows say what they mean rather than having it read from their words:
  # a row saying something was NOT enabled contained "enabled", and got a tick.
  log_as "$([[ $s == running ]] && echo ok || echo info)" "instance          $s"
  stranded_spot_note "$REGION" "${INSTANCE_ID:-}"
  # Layer 2, on the box.
  if [[ $s == running ]] && box true 2>/dev/null; then
    # Same `|| echo` trap as documented in cmd_watchdog status: is-active prints
    # "inactive" and exits non-zero, so the fallback gets appended to a real
    # answer instead of replacing a missing one.
    local ohw
    ohw=$(box 'systemctl is-active idle-watchdog.timer 2>/dev/null' 2>/dev/null) || true
    ohw=${ohw//[$'\r\n']/}
    log_as "$([[ $ohw == active ]] && echo ok || echo warn)" "on-host watchdog  ${ohw:-unreachable}"
    # What it MUST be depends on the purchase model, so say which. The hint used
    # to read "must be 'stop'" unconditionally, which became wrong the moment
    # spot switched to one-time+terminate - a correct setting flagged as an
    # error, next to a guard people are reading precisely to check it.
    local sb want
    sb=$(ec2 describe-instance-attribute --instance-id "$INSTANCE_ID" \
         --attribute instanceInitiatedShutdownBehavior \
         --query 'InstanceInitiatedShutdownBehavior.Value' --output text 2>/dev/null)
    if [[ $(ec2 describe-instances --instance-ids "$INSTANCE_ID" \
            --query 'Reservations[0].Instances[0].InstanceLifecycle' --output text 2>/dev/null) == spot ]]
    then want=terminate; else want=stop; fi
    log_as "$([[ $sb == "$want" ]] && echo ok || echo fail)" \
      "shutdown action   $sb  <- must be '$want' $([[ $sb == "$want" ]] && echo "(ok)" || echo "(WRONG)")"
    cg_gap
    box 'journalctl -t idle-watchdog -n 8 --no-pager -o cat 2>/dev/null' | cg_relay '      ' || true
  else
    log_as info "on-host watchdog  (box not reachable)"
  fi
  # Layer 3, the cloud watchdog: the guard that keeps working when the box is gone.
  cg_gap
  cw_watcher_lines

  cg_gap
  local bud
  bud=$(aws budgets describe-budgets --account-id \
        "$(aws sts get-caller-identity --query Account --output text)" \
        --query "Budgets[?BudgetName=='${TS_HOST}-monthly'].BudgetLimit.Amount" \
        --output text 2>/dev/null || echo absent)
  log_as "$([[ $bud =~ ^[0-9.]+$ ]] && echo ok || echo warn)" "budget            $bud"
}

cmd_help() {
  cat <<'EOF'
cg - cloud gaming rig

build (changes things)
  cg init                    build everything; reuses an existing box   [costs money]
  cg open                    start, stream, stop on exit                [costs money]
  cg pair                    redo the Moonlight handshake (no rebuild needed)
  cg stop                    mirror the games to S3, then stop - ends hourly billing
  cg status                  instance, disks, guards, tailnet, ping
  cg library                 what is on the box vs in S3, and what it costs
  cg library push            mirror the games to S3 now (--verify for a full pass)
  cg library pull            restore the games from S3 now
  cg library check           is the disk mirrored? (no upload)
  cg library list            what is archived, per game, and the monthly cost
  cg library forget <appid>  delete one game from the archive           [permanent]
  cg library clean           delete orphaned objects left by an unfinished push
  cg games                   what Steam has: installed, downloading, running, archived
  cg games --volume          the OLD EBS volume, if you still have one
  cg snapshot                save an AMI of the current box             [bills monthly]
  cg snapshot --list         what images exist and what they cost
  cg clean                   free space: apt caches, logs, /scratch/tmp
  cg destroy                 mirror the games to S3, then delete the box
  cg destroy --force         destroy even if the mirror failed - loses the games
  cg destroy --no-push       destroy and leave the archive untouched (locks it first)

info (read-only)
  cg check                   every preflight check, creates nothing
  cg cost                    month-to-date spend and what still bills
  cg log [what] [--watch]    build | steam | watchdog | disk | sunshine
  cg ssh [cmd]               shell on the box
  cg watcher [--watch]       every guard, and whether each is armed
  cg watchdog [status|check|logs|install|remove]
                             layer 3: the cloud watchdog (Lambda); check is a dry run
  cg notify                  send a test notification to GAME_NTFY_URL
  cg ping [--watch]          latency, and direct vs DERP relay

flags
  --region <r>  --host <name>   override .env without editing it
  --json                        ping, snapshot --list
EOF
}

case "$CMD" in
  init)      watchdog_ensure; choose_games; exec lib/setup ;;
  check)     exec lib/setup check ;;
  # Reports go through cg_report: on a terminal it boxes and colours them, and
  # anywhere else it is `cat`, so a redirected report is byte-for-byte as before.
  status)    { lib/setup status; [[ -n $INSTANCE_ID ]] && lib/game status || true
               # `tailscale ip` succeeds for a node that is registered but OFFLINE, so it
               # does not mean the box answers - and the heading used to print with
               # nothing under it. Ask the box first; say so when it did not answer.
               if tailscale ip -4 "$TS_NODE" >/dev/null 2>&1; then
                 lib_out=$(box '/usr/local/bin/cg-library status' 2>/dev/null) || true
                 echo; echo "game library"
                 if [[ -n ${lib_out//[[:space:]]/} ]]; then printf '%s\n' "$lib_out"
                 else echo "  box not reachable - the archive is listed by: cg library list"; fi
               fi
               stream_usage; } | cg_report ;;
  cost)      lib/setup cost | cg_report ;;
  clean)     exec lib/setup clean ;;
  destroy)   cmd_destroy "$@" ;;
  open|up)   ensure_moonlight_syskeys; exec lib/game up ;;
  stop|down) cmd_stop "$@" ;;
  snapshot)  cmd_snapshot "$@" ;;
  # Only the bare report is piped: `games --volume --delete` asks a question.
  games)     if (( $# )); then cmd_games "$@"; else cmd_games | cg_report "🎮" "Games"; fi ;;
  pair)      cmd_pair ;;
  library|lib) cmd_library "$@" ;;
  watchdog)  cmd_watchdog "$@" ;;
  notify)    cmd_notify ;;
  log|logs)  cmd_log "$@" ;;
  ssh)       if [[ $# -gt 0 ]]; then box "$@"; else need_node; exec ssh -i "$KEY" \
               -o StrictHostKeyChecking=accept-new "ubuntu@$(tailscale ip -4 "$TS_NODE")"; fi ;;
  ping)      cmd_ping ;;
  watcher|guards) cmd_watcher ;;
  help|"")   cmd_help ;;
  *) echo "unknown command '$CMD'" >&2; cmd_help >&2; exit 1 ;;
esac

# Explicit exit, and not decoration. Bash does not load a script - it reads a
# command, runs it, then SEEKS BACK to read the next one. After the final
# command completes it returns to read again, and if the file changed in the
# meantime (an edit, a git pull, a git checkout) that read lands at a stale byte
# offset, mid-statement:
#
#     ./cg: line 944: syntax error near unexpected token `;;'
#
# which is what a 5-minute `cg destroy` did when the file was edited underneath
# it. Every real step had already completed; the error came from bash looking
# for more input after the dispatch finished. `exit` means it never looks.
# (The `exec` branches were always immune - exec replaces the process.)
exit
