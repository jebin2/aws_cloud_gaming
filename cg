  [[ -n ${GAME_NTFY_URL:-} ]] || die "set GAME_NTFY_URL in .env - a long random topic name, or a full ntfy URL"
  local url host
  url=$(cg_ntfy_url)
  [[ -n $url ]] || die "GAME_NTFY_URL is not a topic (letters, digits, - and _, up to 64) or an http(s)://host/topic URL"
