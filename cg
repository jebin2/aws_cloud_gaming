#!/usr/bin/env bash
# One front door for the whole rig. A dispatcher, deliberately: `setup` and
# `game` keep working, and almost every odd-looking line in them is a scar from
# a real failure. Re-implementing that logic here would quietly lose it, so this
# calls into them and only implements what they never had - snapshot listing,
# logs, ssh, ping and the guard view.
set -euo pipefail
cd "$(dirname "$0")"

source lib/common.sh

# --- global flags, before the subcommand ---------------------------------------
JSON=0; WATCH=0
while [[ ${1:-} == -* ]]; do
  case $1 in
    --json)    JSON=1; shift ;;
    --watch)   WATCH=1; shift ;;
    --region)  export GAME_REGION="$2"; shift 2 ;;
    --host)    export GAME_TS_HOST="$2"; shift 2 ;;
    -h|--help) set -- help; break ;;
    *) die "unknown flag '$1' (see: cg help)" ;;
  esac
done
CMD="${1:-help}"; shift || true
# Flags are also accepted after the subcommand, which is how people actually
# type them.
for a in "$@"; do
  case $a in --watch) WATCH=1 ;; --json) JSON=1 ;; esac
done

# .env, parsed rather than sourced: a malformed line in a sourced file executes
# as a command. Anything already exported wins, so --region/--host stick.
if [[ -f .env ]]; then
  while IFS= read -r line; do
    [[ $line =~ ^[[:space:]]*# ]] && continue
    [[ $line =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] || continue
    k="${line%%=*}"; [[ -n ${!k:-} ]] && continue
    export "$k=${line#*=}"
  done < .env
fi

REGION="${GAME_REGION:-ap-south-2}"
TS_HOST="${GAME_TS_HOST:-gamevps}"
TS_NODE="${GAME_TS_NODE:-$TS_HOST}"
INSTANCE_ID="${GAME_INSTANCE_ID:-}"
KEY="$HOME/.ssh/${TS_HOST}.pem"
ec2() { aws ec2 "$@" --region "$REGION"; }

# lib/setup and lib/game are dispatch targets, not commands - see lib/README
# is not needed, their headers say so.

need_node() {
  tailscale ip -4 "$TS_NODE" >/dev/null 2>&1 \
    || die "'$TS_NODE' is not on the tailnet. Is the box running? Try: cg status"
}
box() {
  need_node
  ssh -i "$KEY" -o StrictHostKeyChecking=accept-new -o ConnectTimeout=10 \
      -o BatchMode=yes "ubuntu@$(tailscale ip -4 "$TS_NODE")" "$@"
}

# --- commands ------------------------------------------------------------------

# Alt+Tab, Super and friends are swallowed by the *client* desktop unless
# Moonlight is told to capture them, and nothing about the remote box can change
# that - so set it here, once, rather than leaving it as a step to remember.
#
# Only ever ADDS the key when absent: someone who deliberately set it to 0 keeps
# that. And never while Moonlight runs - it does not re-read its config, and it
# rewrites the file on exit, discarding anything changed underneath it.
# Save games live inside the Proton prefix, in the Steam library on /games - so
# they now survive a stop. Steam Cloud is still the thing that protects them
# against a destroy, and Cloud only syncs when Steam shuts down cleanly, so ask
# it to exit and give it time before stopping the box.
# Streaming is the charge that can exceed the instance, and `cg cost` cannot
# help in the moment: Cost Explorer lags about a day. The box has the counter
# already, so read it live and for free. Since boot, not since the session -
# the kernel keeps no per-session tally - and it includes ssh and Tailscale
# keepalives, which is why it is labelled as tailnet traffic, not pure video.
stream_usage() {
  local node="${GAME_TS_NODE:-$TS_HOST}" ip
  tailscale ip -4 "$node" >/dev/null 2>&1 || return 0
  ip=$(tailscale ip -4 "$node")
  local out
  out=$(ssh -i "$KEY" -o StrictHostKeyChecking=accept-new -o ConnectTimeout=8 \
        -o BatchMode=yes "ubuntu@$ip" '
    ts=$(cat /sys/class/net/tailscale0/statistics/tx_bytes 2>/dev/null || echo 0)
    # What AWS bills is what leaves the real NIC: WireGuard encapsulation, ssh,
    # apt, and - measured at ~2.4 GB against a 132 GB download - the TCP acks a
    # big Steam download generates. None of that appears on tailscale0, so a
    # status line reading only the tunnel understates the bill by about half.
    nic=$(ip route show default 2>/dev/null | awk "{print \$5; exit}")
    wan=$(cat "/sys/class/net/$nic/statistics/tx_bytes" 2>/dev/null || echo 0)
    win=$(cat "/sys/class/net/$nic/statistics/rx_bytes" 2>/dev/null || echo 0)
    up=$(cut -d. -f1 /proc/uptime)
    printf "%s %s %s %s\n" "$ts" "$wan" "$win" "$up"' 2>/dev/null) || return 0
  [[ -n $out ]] || return 0
  echo
  echo "TRAFFIC (this boot only - see cg cost for the billed month)"
  awk -v o="$out" 'BEGIN{
    split(o,f," "); ts=f[1]; wan=f[2]; win=f[3]; up=f[4];
    printf "  stream out      %.2f GB", ts/1073741824;
    if (up>0) printf "   avg %.1f Mbps over %.1f h", ts*8/up/1000000, up/3600;
    printf "\n";
    printf "  total out       %.2f GB   <- what AWS bills (adds wireguard overhead, ssh, apt)\n", wan/1073741824;
    printf "  total in        %.2f GB   (free - game downloads land here)\n", win/1073741824;
    left=100-wan/1073741824;
    printf "  free egress     ~%.0f GB left of 100 GB/month\n", (left>0?left:0);
  }'
}

steam_shutdown_for_cloud_sync() {
  local node="${GAME_TS_NODE:-$TS_HOST}"
  tailscale ip -4 "$node" >/dev/null 2>&1 || return 0
  local ip; ip=$(tailscale ip -4 "$node")
  local sshopts=(-i "$KEY" -o StrictHostKeyChecking=accept-new -o ConnectTimeout=8 -o BatchMode=yes)
  ssh "${sshopts[@]}" "ubuntu@$ip" 'pgrep -x steam >/dev/null' 2>/dev/null || return 0
  say "closing Steam so cloud saves finish syncing"
  # `steam -shutdown` is the supported way to ask it to exit and sync; a plain
  # kill skips the sync entirely.
  ssh "${sshopts[@]}" "ubuntu@$ip" '
    export DISPLAY=:0 XAUTHORITY="$HOME/.Xauthority"
    export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus"
    /usr/bin/steam -shutdown >/dev/null 2>&1 || true
    for i in $(seq 1 30); do pgrep -x steam >/dev/null || break; sleep 2; done
    pgrep -x steam >/dev/null && echo "still running after 60s" || echo "closed"
  ' 2>/dev/null | sed 's/^/      steam: /'
}

ensure_moonlight_syskeys() {
  local conf="$HOME/.config/Moonlight Game Streaming Project/Moonlight.conf"
  [[ -f $conf ]] || return 0
  pgrep -x moonlight >/dev/null 2>&1 && return 0
  grep -q '^capturesyskeys=' "$conf" && return 0
  if grep -q '^\[General\]' "$conf"; then
    sed -i '0,/^\[General\]/s//[General]\ncapturesyskeys=2/' "$conf" \
      && log "enabled Moonlight system-key capture (Alt+Tab, Super)"
  fi
}


# `cg destroy` deliberately keeps the game volume. `--all` is the way to say
# "no, everything" - and it has to be a real flag rather than a silently
# ignored argument, or someone types it, sees "everything deleted", and keeps
# paying INR 1,284/month for a volume they believe is gone.
cmd_destroy() {
  local all=0 a
  for a in "$@"; do
    case $a in
      --all) all=1 ;;
      # Refuse anything else rather than ignore it: a typo like --everything
      # must not quietly behave as a plain destroy and leave the volume billing.
      *) die "unknown option '$a' for destroy (only --all is accepted)" ;;
    esac
  done
  if (( ! all )); then
    lib/setup destroy
    return
  fi
  local vol size
  read -r vol size < <(ec2 describe-volumes --filters "Name=tag:Name,Values=${TS_HOST}-games" \
    --query 'Volumes[0].[VolumeId,Size]' --output text 2>/dev/null)
  echo "--all: the game library volume goes too, with every game on it."
  [[ -n ${vol:-} && $vol != None ]] && echo "        $vol  ${size} GB" || echo "        (none exists)"
  echo
  lib/setup destroy
  [[ -n ${vol:-} && $vol != None ]] || { log "no game volume to remove"; return 0; }
  # Terminating the instance detaches it, but AWS takes a moment to let go.
  say "deleting the game library volume $vol"
  local i
  for i in $(seq 1 40); do
    [[ $(ec2 describe-volumes --volume-ids "$vol" --query 'Volumes[0].State' \
         --output text 2>/dev/null) == available ]] && break
    sleep 3
  done
  if ec2 delete-volume --volume-id "$vol" >/dev/null 2>&1; then
    log "deleted $vol - storage charges stop now"
  else
    log "could not delete $vol; it may still be attaching/detaching"
    log "  retry with: cg games --delete"
  fi
}

# Layer 4: the same watchdog logic, on a host that is always on. The on-host
# watchdog dies with the box it protects, and the CloudWatch alarm can be
# deleted, disarmed or misconfigured - and has stopped a box once here with no
# visible reasoning. This layer writes down every decision and the numbers
# behind it, which is most of its value.
# Called by `cg init` before anything launches. The off-site watchdog polls by
# TAG, so it does not need the instance to exist - and the whole point of an
# independent guard is that it is already watching when the box appears, not
# installed afterwards by hand. Quiet when it is already in place, and never
# fatal: a missing watchdog must not stop you building a box.
# Create the scoped IAM user the off-site watchdog needs, so none of this is a
# manual step. Deliberately narrow: describe instances, read metrics, and stop
# ONLY an instance tagged with this host name. It cannot terminate, launch, or
# read anything else - so the worst case if that always-on box is compromised is
# somebody stopping your game instance.
#
# Long-lived access keys are the only option for a host outside AWS: there is no
# instance role to borrow. They land in .env, which is gitignored, and are
# pushed to the box over stdin.
watchdog_iam_ensure() {
  local user="${TS_HOST}-watchdog"
  # Already have working credentials? Then there is nothing to do. Checked by
  # using them, not by assuming the variables are still valid.
  if [[ -n ${GAME_WATCHDOG_AWS_KEY_ID:-} && -n ${GAME_WATCHDOG_AWS_SECRET:-} ]]; then
    if AWS_ACCESS_KEY_ID="$GAME_WATCHDOG_AWS_KEY_ID" \
       AWS_SECRET_ACCESS_KEY="$GAME_WATCHDOG_AWS_SECRET" \
       aws sts get-caller-identity >/dev/null 2>&1; then
      return 0
    fi
    log "the watchdog credentials in .env no longer work - reissuing"
  fi

  aws iam get-user --user-name "$user" >/dev/null 2>&1 || {
    say "creating the scoped IAM user $user"
    aws iam create-user --user-name "$user" >/dev/null 2>&1 || {
      log "could not create $user (needs iam:CreateUser) - skipping the off-site watchdog"
      return 1
    }
  }

  # put-user-policy overwrites, so this also repairs a policy edited by hand.
  local pol; pol=$(mktemp); trap 'rm -f "$pol"' RETURN
  cat > "$pol" <<JSON
{ "Version": "2012-10-17", "Statement": [
  { "Effect": "Allow",
    "Action": ["ec2:DescribeInstances", "cloudwatch:GetMetricStatistics"],
    "Resource": "*" },
  { "Effect": "Allow", "Action": "ec2:StopInstances", "Resource": "*",
    "Condition": { "StringEquals": { "ec2:ResourceTag/Name": "$TS_HOST" } } }
]}
JSON
  aws iam put-user-policy --user-name "$user" --policy-name idle-stop \
    --policy-document "file://$pol" >/dev/null 2>&1 \
    || { log "could not attach the policy to $user - skipping the off-site watchdog"; return 1; }

  # AWS allows two keys per user and shows a secret exactly once, so an existing
  # key whose secret we do not have is useless - clear the way and reissue.
  local k
  for k in $(aws iam list-access-keys --user-name "$user" \
             --query 'AccessKeyMetadata[].AccessKeyId' --output text 2>/dev/null); do
    [[ -n $k && $k != None ]] && aws iam delete-access-key --user-name "$user" --access-key-id "$k" >/dev/null 2>&1
  done
  local kid sec
  read -r kid sec < <(aws iam create-access-key --user-name "$user" \
    --query 'AccessKey.[AccessKeyId,SecretAccessKey]' --output text 2>/dev/null)
  [[ -n ${kid:-} && $kid != None ]] || { log "could not create an access key for $user"; return 1; }

  # New keys are eventually consistent; using one immediately can fail.
  local i
  for i in $(seq 1 10); do
    AWS_ACCESS_KEY_ID="$kid" AWS_SECRET_ACCESS_KEY="$sec" \
      aws sts get-caller-identity >/dev/null 2>&1 && break
    sleep 3
  done

  local tmp; tmp=$(mktemp)
  grep -vE '^GAME_WATCHDOG_AWS_(KEY_ID|SECRET)=' .env 2>/dev/null > "$tmp" || true
  printf 'GAME_WATCHDOG_AWS_KEY_ID=%s\nGAME_WATCHDOG_AWS_SECRET=%s\n' "$kid" "$sec" >> "$tmp"
  cat "$tmp" > .env; rm -f "$tmp"; chmod 600 .env
  export GAME_WATCHDOG_AWS_KEY_ID="$kid" GAME_WATCHDOG_AWS_SECRET="$sec"
  log "issued a scoped key for $user and saved it to .env"
  return 0
}

watchdog_ensure() {
  [[ -n ${GAME_WATCHDOG_HOST:-} ]] || return 0
  local kf="${GAME_WATCHDOG_KEY:-}" ident=()
  [[ -n $kf ]] && ident=(-i "${kf/#\~/$HOME}")
  local rsh=(ssh "${ident[@]}" -o ConnectTimeout=8 -o BatchMode=yes
             -o StrictHostKeyChecking=accept-new "$GAME_WATCHDOG_HOST")
  if ! "${rsh[@]}" true 2>/dev/null; then
    log "off-site watchdog: $GAME_WATCHDOG_HOST unreachable - skipping"
    return 0
  fi
  watchdog_iam_ensure || true

  # Every call below goes through a SUBSHELL. cmd_watchdog uses die(), which
  # exits the process - so a plain `cmd_watchdog install || log ...` cannot
  # catch it and a missing watchdog killed `cg init` outright. This function
  # promises never to be fatal; a subshell is what makes that true.
  if [[ $("${rsh[@]}" 'systemctl is-enabled remote-watchdog.timer 2>/dev/null | head -1' 2>/dev/null) == enabled ]]; then
    ( cmd_watchdog install ) >/dev/null 2>&1 \
      || log "off-site watchdog: refresh failed (the existing one is still armed)"
  else
    say "arming the off-site watchdog before anything launches"
    ( cmd_watchdog install ) || {
      log "off-site watchdog not installed - the other three layers still apply"
      return 0
    }
  fi
  watchdog_prove
  return 0
}

# "refreshed" used to mean "the install command exited 0" - and it printed that
# while the watchdog was blind, because the units run as root and the credentials
# were not readable by root. Exit codes are not evidence. Make it run once and
# report what it actually decided, which is the only thing worth printing.
watchdog_prove() {
  local kf="${GAME_WATCHDOG_KEY:-}" ident=()
  [[ -n $kf ]] && ident=(-i "${kf/#\~/$HOME}")
  local rsh=(ssh "${ident[@]}" -o ConnectTimeout=8 -o BatchMode=yes
             -o StrictHostKeyChecking=accept-new "$GAME_WATCHDOG_HOST")
  local line
  line=$("${rsh[@]}" 'sudo systemctl start remote-watchdog.service 2>/dev/null;
                      sleep 2; sudo tail -1 /var/log/cloud-gaming-watchdog.log' 2>/dev/null)
  if [[ -z ${line:-} ]]; then
    log "off-site watchdog: armed, but it logged nothing - check: cg watchdog logs"
    return 0
  fi
  # Strip the timestamp; the line already reads as a sentence.
  log "off-site watchdog: ${line#* }"
  [[ $line == *"CANNOT QUERY AWS"* ]] \
    && log "  ^ it cannot see your account - fix this or layer 4 is decoration"
  return 0
}

cmd_watchdog() {
  local host="${GAME_WATCHDOG_HOST:-}"
  [[ -n $host ]] || die "set GAME_WATCHDOG_HOST=user@host in .env (an always-on box with the aws CLI)"
  # That host is almost never reachable with a default key - an Oracle box wants
  # its own. GAME_WATCHDOG_KEY supplies it; unset means use the ssh default.
  local kf="${GAME_WATCHDOG_KEY:-}"
  local ident=(); [[ -n $kf ]] && ident=(-i "${kf/#\~/$HOME}")
  local rsh=(ssh "${ident[@]}" -o ConnectTimeout=10 -o BatchMode=yes
             -o StrictHostKeyChecking=accept-new "$host")
  local scpid=("${ident[@]}")
  case "${1:-status}" in
    install)
      say "checking $host"
      # Install the CLI rather than complaining about it. Amazon's installer,
      # not apt: this is an Oracle Ampere box where `awscli` is not in the
      # enabled repos at all, and the installer covers both x86_64 and aarch64.
      if ! "${rsh[@]}" 'command -v aws >/dev/null' 2>/dev/null; then
        say "installing the aws CLI on $host"
        "${rsh[@]}" '
          set -e
          command -v unzip >/dev/null || { sudo apt-get update -qq; sudo apt-get install -y -qq unzip; }
          cd /tmp
          curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-$(uname -m).zip" -o awscliv2.zip
          unzip -q -o awscliv2.zip
          sudo ./aws/install --update >/dev/null
          rm -rf /tmp/aws /tmp/awscliv2.zip
        ' || die "could not install the aws CLI on $host"
        log "installed $("${rsh[@]}" 'aws --version 2>&1 | cut -d" " -f1' 2>/dev/null)"
      fi
      # Credentials can come from .env, so the whole thing is one command. These
      # must be the SCOPED user's keys - see the IAM policy in the README. They
      # are written 600 and owned by the remote user.
      if [[ -n ${GAME_WATCHDOG_AWS_KEY_ID:-} && -n ${GAME_WATCHDOG_AWS_SECRET:-} ]]; then
        log "credentials will go into the root-owned watchdog config"
      fi

      # Verify credentials AFTER writing them, not before: the check used to run
      # first and failed on a box that was about to be configured correctly.
      local remote_arn local_arn
      remote_arn=$("${rsh[@]}" 'aws sts get-caller-identity --query Arn --output text' 2>/dev/null) \
        || die "no working AWS credentials on $host.
       Put the scoped user's keys in .env as GAME_WATCHDOG_AWS_KEY_ID and
       GAME_WATCHDOG_AWS_SECRET (cg init creates that user), or configure
       them on $host yourself."
      log "remote identity: $remote_arn"
      local_arn=$(aws sts get-caller-identity --query Arn --output text 2>/dev/null || echo "")
      # An always-on, internet-facing box holding the same credentials as your
      # laptop is the worst outcome here, so say so plainly.
      if [[ -n $local_arn && $remote_arn == "$local_arn" ]]; then
        log ""
        log "WARNING: $host is using the SAME credentials as this machine."
        log "  That gives an always-on, internet-facing host your full access."
        log "  cg init creates a scoped user; see the IAM policy in the README."
        log ""
      fi

      say "installing the off-site watchdog on $host"
      "${rsh[@]}" 'sudo install -d -m 755 /var/lib/cloud-gaming-watchdog' 2>/dev/null || true
      scp -q "${scpid[@]}" -o BatchMode=yes -o StrictHostKeyChecking=accept-new \
        host/remote-watchdog.sh host/remote-watchdog.service \
        host/remote-watchdog.timer "$host:/tmp/" || die "copy to $host failed"
      # The whole config, secrets included, goes over stdin: the units run as
      # ROOT, so credentials in a user's home are invisible to them - which is
      # exactly how this watchdog spent half an hour blind.
      {
        printf 'GAME_REGION=%s\nGAME_TS_HOST=%s\nIDLE_LIMIT=%s\n' \
          "$REGION" "$TS_HOST" "${GAME_WATCHDOG_IDLE:-6}"
        [[ -n ${GAME_WATCHDOG_AWS_KEY_ID:-} ]] && \
          printf 'export AWS_ACCESS_KEY_ID=%s\nexport AWS_SECRET_ACCESS_KEY=%s\nexport AWS_DEFAULT_REGION=%s\n' \
            "$GAME_WATCHDOG_AWS_KEY_ID" "$GAME_WATCHDOG_AWS_SECRET" "$REGION"
      } | "${rsh[@]}" "
        set -e
        sudo install -m 755 /tmp/remote-watchdog.sh /usr/local/bin/remote-watchdog.sh
        sudo install -m 644 /tmp/remote-watchdog.service /tmp/remote-watchdog.timer /etc/systemd/system/
        sudo install -m 600 /dev/null /etc/cloud-gaming-watchdog.conf
        sudo tee /etc/cloud-gaming-watchdog.conf >/dev/null
        sudo systemctl daemon-reload
        sudo systemctl enable --now remote-watchdog.timer
        rm -f /tmp/remote-watchdog.*
      " || die "install on $host failed"
      log "installed and enabled - it survives a reboot of $host (OnBootSec + Persistent)"
      "${rsh[@]}" 'systemctl list-timers remote-watchdog.timer --no-pager' 2>/dev/null | sed 's/^/      /'
      log "it stops the box after $(( ${GAME_WATCHDOG_IDLE:-6} * 5 )) min with no traffic in or out"
      ;;
    status)
      printf '  host    %s\n' "$host"
      # is-enabled prints "not-found" AND exits non-zero, so a `|| echo` prints
      # both. Take the first word and normalise it.
      local st
      st=$("${rsh[@]}" 'systemctl is-enabled remote-watchdog.timer 2>/dev/null | head -1' 2>/dev/null)
      printf '  timer   %s\n' "${st:-not installed}"
      "${rsh[@]}" 'systemctl list-timers remote-watchdog.timer --no-pager 2>/dev/null | sed -n 2p' 2>/dev/null | sed 's/^/  next    /'
      echo "  recent decisions:"
      "${rsh[@]}" 'sudo tail -n 8 /var/log/cloud-gaming-watchdog.log 2>/dev/null' 2>/dev/null | sed 's/^/    /' \
        || echo "    (no log yet)"
      ;;
    logs)
      if (( WATCH )); then "${rsh[@]}" 'sudo tail -f /var/log/cloud-gaming-watchdog.log'
      else "${rsh[@]}" 'sudo tail -n 40 /var/log/cloud-gaming-watchdog.log' 2>/dev/null | sed 's/^/  /'; fi ;;
    remove)
      # Also removes the IAM user, since cg created it. Keys first: a user with
      # keys cannot be deleted, and leaving a stray key is worse than leaving a
      # stray user.
      local u="${TS_HOST}-watchdog" k
      if aws iam get-user --user-name "$u" >/dev/null 2>&1; then
        say "removing the scoped IAM user $u"
        for k in $(aws iam list-access-keys --user-name "$u" \
                   --query 'AccessKeyMetadata[].AccessKeyId' --output text 2>/dev/null); do
          [[ -n $k && $k != None ]] && aws iam delete-access-key --user-name "$u" --access-key-id "$k" >/dev/null 2>&1 \
            && log "deleted key $k"
        done
        aws iam delete-user-policy --user-name "$u" --policy-name idle-stop >/dev/null 2>&1 || true
        aws iam delete-user --user-name "$u" >/dev/null 2>&1 && log "deleted $u" \
          || log "could not delete $u"
      fi
      local tmp; tmp=$(mktemp)
      grep -vE '^GAME_WATCHDOG_AWS_(KEY_ID|SECRET)=' .env 2>/dev/null > "$tmp" || true
      cat "$tmp" > .env; rm -f "$tmp"; chmod 600 .env
      say "removing the off-site watchdog from $host"
      "${rsh[@]}" 'sudo systemctl disable --now remote-watchdog.timer 2>/dev/null;
        sudo rm -f /etc/systemd/system/remote-watchdog.{service,timer} \
          /usr/local/bin/remote-watchdog.sh /etc/cloud-gaming-watchdog.conf;
        sudo systemctl daemon-reload;
        shred -u ~/.aws/credentials 2>/dev/null || rm -f ~/.aws/credentials' 2>/dev/null
      log "removed" ;;
    *) die "usage: cg watchdog [install|status|logs [--watch]|remove]" ;;
  esac
}

cmd_games() {
  local vol az size state
  read -r vol az size state < <(ec2 describe-volumes \
    --filters "Name=tag:Name,Values=${TS_HOST}-games" \
    --query 'Volumes[0].[VolumeId,AvailabilityZone,Size,State]' --output text 2>/dev/null)
  if [[ -z ${vol:-} || $vol == None ]]; then
    echo "no game library volume exists yet - cg init creates one"
    echo "size it with GAME_GAMES_GB in .env (default 160)"
    return 0
  fi
  case "${1:-show}" in
    show|"")
      awk -v v="$vol" -v a="$az" -v s="$size" -v st="$state" 'BEGIN{
        m=s*0.0912;
        printf "  volume   %s  (%s)\n", v, st;
        printf "  zone     %s   <- every instance is pinned here; EBS cannot cross AZs\n", a;
        printf "  size     %s GB\n", s;
        printf "  cost     $%.2f/month (INR %.0f) - billed whether or not the box exists\n", m, m*88;
      }'
      echo "  delete   cg games --delete   (permanent; the games go with it)" ;;
    --delete|delete)
      [[ $state == available ]] || die "volume is $state - stop or destroy the instance first"
      echo "This permanently deletes $vol and every game on it."
      read -r -p "type DELETE to confirm: " a
      [[ $a == DELETE ]] || { echo "aborted"; return 1; }
      ec2 delete-volume --volume-id "$vol" >/dev/null && log "deleted $vol"
      log "storage charges stop now" ;;
    *) die "usage: cg games [show|--delete]" ;;
  esac
}

cmd_snapshot() {
  case "${1:-create}" in
    --list|list)
      # Images bill every month, forever, and nothing else here lists them -
      # a create-only snapshot command is a slow leak.
      local imgs
      imgs=$(ec2 describe-images --owners self \
        --query 'reverse(sort_by(Images,&CreationDate))[].{id:ImageId,name:Name,created:CreationDate,state:State,gb:BlockDeviceMappings[0].Ebs.VolumeSize}' \
        --output json)
      if (( JSON )); then printf '%s\n' "$imgs"; return; fi
      python3 - <<PY
import json,sys
imgs=json.loads('''$imgs''')
if not imgs: print("no saved images - nothing billing"); sys.exit()
print(f"{'IMAGE':<24}{'CREATED':<22}{'GB':>4}  {'~USD/mo':>8}  NAME")
tot=0.0
for i in imgs:
    gb=i.get('gb') or 0
    mo=gb*0.05          # EBS snapshot storage, approx
    tot+=mo
    print(f"{i['id']:<24}{i['created'][:19]:<22}{gb:>4}  {mo:>8.2f}  {i['name']}")
print(f"\nestimated {tot:.2f} USD/month (~INR {tot*88:.0f}) for {len(imgs)} image(s)")
print("delete one with:  cg snapshot --delete <image-id>")
PY
      ;;
    --delete|delete)
      local id="${2:-}"
      [[ -n $id ]] || die "which image? see: cg snapshot --list"
      # Deregistering leaves the backing snapshots behind, still billing - that
      # is the classic way to believe you deleted something and keep paying.
      local snaps
      snaps=$(ec2 describe-images --image-ids "$id" \
        --query 'Images[0].BlockDeviceMappings[].Ebs.SnapshotId' --output text 2>/dev/null || true)
      ec2 deregister-image --image-id "$id" && log "deregistered $id"
      for s in $snaps; do
        [[ $s == None || -z $s ]] && continue
        ec2 delete-snapshot --snapshot-id "$s" 2>/dev/null && log "deleted snapshot $s" \
          || log "could not delete snapshot $s (in use by another image?)"
      done
      ;;
    create|"")
      [[ -n $INSTANCE_ID ]] || die "no instance in .env - nothing to snapshot"
      local s name ami
      s=$(ec2 describe-instances --instance-ids "$INSTANCE_ID" \
          --query 'Reservations[0].Instances[0].State.Name' --output text)
      [[ $s == stopped ]] || say "note: imaging a $s instance; stop it first for a consistent image"
      name="${TS_HOST}-$(date -u +%Y%m%d-%H%M%S)"
      say "creating image $name (several minutes)"
      ami=$(ec2 create-image --instance-id "$INSTANCE_ID" --name "$name" \
        --description "cloud_gaming saved desktop" \
        --tag-specifications "ResourceType=image,Tags=[{Key=Name,Value=${TS_HOST}-image}]" \
        --query ImageId --output text)
      log "$ami"
      wait_image_available "$REGION" "$ami"
      log "ready - cg init will restore from it instead of rebuilding"
      ;;
    *) die "usage: cg snapshot [create|--list|--delete <id>]" ;;
  esac
}

cmd_log() {
  local what="${1:-build}"
  case $what in
    build)    if (( WATCH )); then box 'sudo tail -f /var/log/cloud-gaming-bootstrap.log'
              else box 'sudo tail -n 200 /var/log/cloud-gaming-bootstrap.log'; fi ;;
    steam)    if (( WATCH )); then box 'tail -f ~/steam-prewarm.log'
              else box 'tail -n 200 ~/steam-prewarm.log'; fi ;;
    watchdog) if (( WATCH )); then box 'journalctl -t idle-watchdog -f'
              else box 'journalctl -t idle-watchdog -n 50 --no-pager'; fi ;;
    disk)     if (( WATCH )); then box 'journalctl -t disk-monitor -f'
              else box 'journalctl -t disk-monitor -n 50 --no-pager'; fi ;;
    sunshine) if (( WATCH )); then box 'journalctl --user -u app-dev.lizardbyte.app.Sunshine -f'
              else box 'journalctl --user -u app-dev.lizardbyte.app.Sunshine -n 80 --no-pager'; fi ;;
    *) die "usage: cg log [build|steam|watchdog|disk|sunshine] [--watch]" ;;
  esac
}

cmd_ping() {
  need_node
  # Latency alone does not explain a bad session; whether the path is direct or
  # relayed through DERP usually does, and nothing else surfaces it.
  local out
  if (( WATCH )); then
    exec tailscale ping --until-direct=false "$TS_NODE"
  fi
  out=$(tailscale ping -c 5 --timeout 3s "$TS_NODE" 2>&1 || true)
  local path="unknown" ms=""
  # `|| true` on every one of these: the whole script runs under `set -e`, and a
  # grep that simply does not match is the normal case here, not an error. Without
  # it `cg ping` exited silently and printed nothing at all.
  grep -q 'via DERP' <<<"$out" && path="DERP relay (slower - UDP 41641 may be blocked)" || true
  grep -qE 'via [0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' <<<"$out" && path="direct" || true
  ms=$(grep -oE 'in [0-9]+ms' <<<"$out" | grep -oE '[0-9]+' | sort -n \
       | awk '{a[NR]=$1} END{if(NR)printf "%d", a[int((NR+1)/2)]}' || true)
  if (( JSON )); then
    printf '{"node":"%s","path":"%s","median_ms":%s}\n' "$TS_NODE" "${path%% *}" "${ms:-null}"
  else
    printf '\n  node    %s (%s)\n' "$TS_NODE" "$(tailscale ip -4 "$TS_NODE" 2>/dev/null)"
    printf '  path    %s\n' "$path"
    printf '  latency %s\n\n' "${ms:+${ms}ms median}${ms:-no reply}"
    [[ $path == DERP* ]] && printf '  A relayed path adds latency and costs bandwidth both ways.\n  Check the security group still allows inbound UDP 41641.\n\n' || true
  fi
}

cmd_watcher() {
  if (( WATCH )); then box 'journalctl -t idle-watchdog -f'; return; fi
  say "guards"
  local s
  s=$(ec2 describe-instances --instance-ids "${INSTANCE_ID:-x}" \
      --query 'Reservations[0].Instances[0].State.Name' --output text 2>/dev/null || echo "none")
  log "instance          $s"
  # Layer 2, on the box.
  if [[ $s == running ]] && box true 2>/dev/null; then
    log "on-host watchdog  $(box 'systemctl is-active idle-watchdog.timer' 2>/dev/null || echo unreachable)"
    log "shutdown action   $(ec2 describe-instance-attribute --instance-id "$INSTANCE_ID" \
         --attribute instanceInitiatedShutdownBehavior \
         --query 'InstanceInitiatedShutdownBehavior.Value' --output text 2>/dev/null)  <- must be 'stop'"
    echo
    box 'journalctl -t idle-watchdog -n 8 --no-pager -o cat 2>/dev/null | sed "s/^/      /"' || true
  else
    log "on-host watchdog  (box not reachable)"
  fi
  # Layers 3 and 4 live in AWS and survive the box being gone.
  echo
  log "idle alarm        $(aws cloudwatch describe-alarms --region "$REGION" \
        --alarm-names "${TS_HOST}-idle-stop" \
        --query 'MetricAlarms[0].[StateValue,ActionsEnabled]' \
        --output text 2>/dev/null | tr '\t' ' ' || echo absent)  <- state, actions-enabled"
  log "budget            $(aws budgets describe-budgets --account-id \
        "$(aws sts get-caller-identity --query Account --output text)" \
        --query "Budgets[?BudgetName=='${TS_HOST}-monthly'].BudgetLimit.Amount" \
        --output text 2>/dev/null || echo absent)"
}

cmd_help() {
  cat <<'EOF'
cg - cloud gaming rig

build (changes things)
  cg init                    build everything; reuses an existing box   [costs money]
  cg open                    start, stream, stop on exit                [costs money]
  cg stop                    stop the instance - this ends hourly billing
  cg status                  instance, disks, guards, tailnet, ping
  cg games                   the persistent game library volume and its cost
  cg games --delete          delete it and every game on it            [permanent]
  cg snapshot                save an AMI of the current box             [bills monthly]
  cg snapshot --list         what images exist and what they cost
  cg snapshot --delete <id>  delete an image and its snapshots
  cg clean                   free space: apt caches, logs, /scratch (not /games)
  cg destroy                 delete the box, no confirmation (game volume survives)
  cg destroy --all           the box AND the game volume - nothing left billing

info (read-only)
  cg check                   every preflight check, creates nothing
  cg cost                    month-to-date spend and what still bills
  cg log [what] [--watch]    build | steam | watchdog | disk | sunshine
  cg ssh [cmd]               shell on the box
  cg watcher [--watch]       all four guards, and whether each is armed
  cg watchdog [install|status|logs|remove]
                             layer 4: the same watchdog, on an always-on host
  cg ping [--watch]          latency, and direct vs DERP relay

flags
  --region <r>  --host <name>   override .env without editing it
  --json                        ping, snapshot --list
EOF
}

case "$CMD" in
  init)      watchdog_ensure; exec lib/setup ;;
  check)     exec lib/setup check ;;
  status)    lib/setup status; [[ -n $INSTANCE_ID ]] && lib/game status || true; stream_usage ;;
  cost)      exec lib/setup cost ;;
  clean)     exec lib/setup clean ;;
  destroy)   cmd_destroy "$@" ;;
  open|up)   ensure_moonlight_syskeys; exec lib/game up ;;
  stop|down) steam_shutdown_for_cloud_sync; exec lib/game stop ;;
  snapshot)  cmd_snapshot "$@" ;;
  games)     cmd_games "$@" ;;
  watchdog)  cmd_watchdog "$@" ;;
  log|logs)  cmd_log "$@" ;;
  ssh)       if [[ $# -gt 0 ]]; then box "$@"; else need_node; exec ssh -i "$KEY" \
               -o StrictHostKeyChecking=accept-new "ubuntu@$(tailscale ip -4 "$TS_NODE")"; fi ;;
  ping)      cmd_ping ;;
  watcher|guards) cmd_watcher ;;
  help|"")   cmd_help ;;
  *) echo "unknown command '$CMD'" >&2; cmd_help >&2; exit 1 ;;
esac
