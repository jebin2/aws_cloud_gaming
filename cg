case "$CMD" in
  init)      watchdog_ensure; choose_games; exec lib/setup ;;
  check)     exec lib/setup check ;;
  status)    lib/setup status; [[ -n $INSTANCE_ID ]] && lib/game status || true
             tailscale ip -4 "$TS_NODE" >/dev/null 2>&1 \
               && { echo; echo "game library"; box '/usr/local/bin/cg-library status' 2>/dev/null || true; }
             stream_usage ;;
  cost)      exec lib/setup cost ;;
  clean)     exec lib/setup clean ;;
  destroy)   cmd_destroy "$@" ;;
  open|up)   ensure_moonlight_syskeys; exec lib/game up ;;
  stop|down) cmd_stop "$@" ;;
  snapshot)  cmd_snapshot "$@" ;;
  games)     cmd_games "$@" ;;
  library|lib) cmd_library "$@" ;;
  watchdog)  cmd_watchdog "$@" ;;
  log|logs)  cmd_log "$@" ;;
  ssh)       if [[ $# -gt 0 ]]; then box "$@"; else need_node; exec ssh -i "$KEY" \
               -o StrictHostKeyChecking=accept-new "ubuntu@$(tailscale ip -4 "$TS_NODE")"; fi ;;
  ping)      cmd_ping ;;
  watcher|guards) cmd_watcher ;;
  help|"")   cmd_help ;;
  *) echo "unknown command '$CMD'" >&2; cmd_help >&2; exit 1 ;;
esac

# Explicit exit, and not decoration. Bash does not load a script - it reads a
# command, runs it, then SEEKS BACK to read the next one. After the final
# command completes it returns to read again, and if the file changed in the
# meantime (an edit, a git pull, a git checkout) that read lands at a stale byte
# offset, mid-statement:
#
#     ./cg: line 944: syntax error near unexpected token `;;'
#
# which is what a 5-minute `cg destroy` did when the file was edited underneath
# it. Every real step had already completed; the error came from bash looking
# for more input after the dispatch finished. `exit` means it never looks.
# (The `exec` branches were always immune - exec replaces the process.)
exit
