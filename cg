# `exec` on a file whose executable bit is missing exits 126 and prints NOTHING.
# That reads as a crash in the engine, not a file mode: `cg open` died instantly
# with "exited 126" and an empty log. Two ways to arrive there - a `mv new old`
# rewrite, which creates the file at the umask default and drops the bit, or a
# packaging step that does not preserve modes - and neither leaves a clue.
# One test turns it into a sentence. tests/exec-bits.sh keeps the repo honest;
# this keeps a package honest.
cg_exec() { # cg_exec <script> [args...]
  if [[ ! -x $1 ]]; then
    if [[ -e $1 ]]; then
      die "$1 is not executable (mode $(stat -c %a "$1" 2>/dev/null || echo '?')) - run: chmod +x $1"
    fi
    die "$1 is missing - this copy of cg is incomplete"
  fi
  exec "$@"
}

case "$CMD" in
  init)      watchdog_ensure; choose_games; cg_exec lib/setup ;;
  check)     cg_exec lib/setup check "$@" ;;
  # The AWS access key: the one thing cg cannot install for you, and the thing
  # a new laptop is missing. Every call behind it is free - `aws configure` is
  # local, and sts get-caller-identity costs nothing.
  # The laptop's tools: python3, ssh, curl, the AWS CLI, Tailscale, Moonlight.
  # Listing is free and installs nothing; `install` shells out to the package
  # manager through sudo, or polkit when there is no terminal.
  deps|dependencies)
             if (( JSON )); then cg_exec lib/setup deps --json; fi
             cg_exec lib/setup deps "$@" ;;
  creds|credentials)
             # `cg creds tailscale --json` has its own payload; the bare --json
             # is the AWS one, which is what the Settings card reads.
             if (( JSON )) && [[ ${1:-} == tailscale ]]; then cg_exec lib/setup creds tailscale --json; fi
             if (( JSON )); then cg_exec lib/setup creds --json; fi
             cg_exec lib/setup creds "$@" ;;
  # Reports go through cg_report: on a terminal it boxes and colours them, and
  # anywhere else it is `cat`, so a redirected report is byte-for-byte as before.
  # --json is the app's view: one object from lib/setup, no box round-trips.
  # --on <name>: a machine of yours instead of the AWS box (lib/host.sh). The
  # AWS box is the default, as it always has been.
  status)    if [[ ${1:-} == --on ]]; then cmd_host_status "${2:-}" $( (( JSON )) && echo --json); exit $?; fi
             if (( JSON )); then cg_exec lib/setup status --json; fi
             { lib/setup status; [[ -n $INSTANCE_ID ]] && lib/game status || true
               # `tailscale ip` succeeds for a node that is registered but OFFLINE, so it
               # does not mean the box answers - and the heading used to print with
               # nothing under it. Ask the box first; say so when it did not answer.
               if tailscale ip -4 "$TS_NODE" >/dev/null 2>&1; then
                 lib_out=$(box '/usr/local/bin/cg-library status' 2>/dev/null) || true
                 echo; echo "game library"
                 if [[ -n ${lib_out//[[:space:]]/} ]]; then printf '%s\n' "$lib_out"
                 else echo "  box not reachable - the archive is listed by: cg library list"; fi
               fi
               stream_usage; } | cg_report ;;
  # --json is the app's view of the same single Cost Explorer call.
  cost)      if (( JSON )); then cg_exec lib/setup cost --json; fi
             lib/setup cost "$@" | cg_report ;;
  clean)     cg_exec lib/setup clean ;;
  destroy)   cmd_destroy "$@" ;;
  open|up)   ensure_moonlight_syskeys
             if [[ ${1:-} == --on ]]; then cmd_host_open "${2:-}"; else cg_exec lib/game up; fi ;;
  stop|down) cmd_stop "$@" ;;
  snapshot)  cmd_snapshot "$@" ;;
  # Only the bare report is piped: `games --volume --delete` asks a question.
  games)     if (( $# )); then cmd_games "$@"; else cmd_games | cg_report "🎮" "Games"; fi ;;
  pair)      cmd_pair ;;
  host)      cmd_host "$@" ;;
  aws)       case ${1:-} in
               forget) shift; cmd_aws_forget "$@" ;;
               disconnect) shift; cmd_aws_disconnect "$@" ;;
               # The same look as disconnect --plan, as a read of its own: a
               # disconnect runs alone, and what it would delete must not.
               inventory)  shift; cmd_aws_disconnect --plan ;;
               *) die "usage: cg aws forget [--anyway] | cg aws disconnect | cg aws inventory [--json]" ;;
             esac ;;
  library|lib) cmd_library "$@" ;;
  watchdog)  cmd_watchdog "$@" ;;
  # No leading `shift`: with no subcommand there is nothing to shift, and under
  # `set -e` that ends the run with no output at all.
  config)    case "${1:-show}" in
               show|"")  if (( JSON )); then config_json; else config_show | cg_report "⚙️" "Settings"; fi ;;
               --json)   config_json ;;
               set)      shift; [[ $# -ge 1 ]] || die "usage: cg config set <key> [value]"
                         config_set "$1" "${2-}" ;;
               get)      shift; [[ $# -ge 1 ]] || die "usage: cg config get <key>"
                         config_get "$1" ;;
               *)        die "usage: cg config [show|--json|get <key>|set <key> [value]]" ;;
             esac ;;
  # Every call behind this is free, and none of them launch anything.
  machines|types)
             # An explicit region used to be swallowed as if it were the --all
             # flag, so `cg machines ap-south-1 --all` reported the CURRENT
             # region and dropped --all. Take the region when one is given.
             if [[ ${1:-} =~ ^[a-z]{2}(-[a-z]+)+-[0-9]$ ]]; then MREG=$1; shift; else MREG=$REGION; fi
             case "${1:-}" in
               --sweep|sweep) shift
                          if (( JSON )); then sweep_fresh; exit 0; fi
                          sweep_show "${1:-}" | cg_report "🌏" "Regions" ;;
               *)         if (( JSON )); then machines_json "$MREG"; exit 0; fi
                          machines_show "$MREG" "${1:-}" | cg_report "🖥" "Machines" ;;
             esac ;;
  # The region question, which machines cannot answer: it only ever describes
  # the region already chosen, and the week lost to a dry ap-south-2 was spent
  # entirely inside that blind spot.
  sweep|regions-sweep)
             # --cached never scans: it is what an opening screen reads, so the
             # table has rows instantly and rescans only when asked.
             if [[ ${1:-} == --cached ]]; then shift
               if (( JSON )); then sweep_cached; exit 0; fi
               die "cg sweep --cached is for the app; run cg sweep to scan"
             fi
             if (( JSON )); then sweep_fresh; exit 0; fi
             sweep_show "${1:-}" | cg_report "🌏" "Regions" ;;
  # Free: reading a quota, its request history, and asking for one all cost
  # nothing. The ask is for exactly what one box needs and never more.
  quota)     case "${1:-status}" in
               status|"")  if (( JSON )); then quota_json; exit 0; fi
                           quota_show ;;
               --json)     quota_json ;;
               request)    shift; quota_request "${1:-ondemand}" ;;
               appeal)     shift; quota_appeal "${1:-ondemand}" ;;
               *) die "usage: cg quota [status|request [ondemand|spot]|appeal [ondemand|spot]]" ;;
             esac ;;
  regions)   case "${1:-}" in
               # Every region AWS has and whether this account may use it -
               # describe-regions only lists the ones already on, which is the
               # opposite of what this question is about.
               optin)   shift
                        if (( JSON )) || [[ ${1:-} == --json ]]; then region_optin_json; exit 0; fi
                        region_optin_json | python3 -I -c '
import json, sys
d = json.load(sys.stdin)
print("  enabled:", len([r for r in d["regions"] if r["status"] in ("ENABLED", "ENABLED_BY_DEFAULT")]))
for r in d["regions"]:
    if r["status"] not in ("ENABLED", "ENABLED_BY_DEFAULT"):
        print("  %-16s %s" % (r["region"], r["status"].lower()))' ;;
               enable)  shift; [[ -n ${1:-} ]] || die "usage: cg regions enable <region>"
                        region_enable "$1" ;;
               "")      if (( JSON )); then regions_json; exit 0; fi
                        regions_show | cg_report "🌏" "Regions" ;;
               *)       die "usage: cg regions [optin|enable <region>]" ;;
             esac ;;
  notify)    cmd_notify ;;
  log|logs)  cmd_log "$@" ;;
  ssh)       if [[ $# -gt 0 ]]; then box "$@"; else need_node; exec ssh -i "$KEY" \
               -o StrictHostKeyChecking=accept-new "ubuntu@$(tailscale ip -4 "$TS_NODE")"; fi ;;
  ping)      cmd_ping ;;
  watcher|guards) cmd_watcher ;;
  help|"")   cmd_help ;;
  *) echo "unknown command '$CMD'" >&2; cmd_help >&2; exit 1 ;;
esac

# Explicit exit, and not decoration. Bash does not load a script - it reads a
# command, runs it, then SEEKS BACK to read the next one. After the final
# command completes it returns to read again, and if the file changed in the
# meantime (an edit, a git pull, a git checkout) that read lands at a stale byte
# offset, mid-statement:
#
#     ./cg: line 944: syntax error near unexpected token `;;'
#
# which is what a 5-minute `cg destroy` did when the file was edited underneath
# it. Every real step had already completed; the error came from bash looking
# for more input after the dispatch finished. `exit` means it never looks.
# (The `exec` branches were always immune - exec replaces the process.)
exit
