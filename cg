#!/usr/bin/env bash
# One front door for the whole rig. A dispatcher, deliberately: `setup` and
# `game` keep working, and almost every odd-looking line in them is a scar from
# a real failure. Re-implementing that logic here would quietly lose it, so this
# calls into them and only implements what they never had - snapshot listing,
# logs, ssh, ping and the guard view.
set -euo pipefail
cd "$(dirname "$0")"

source lib/common.sh

# --- global flags, before the subcommand ---------------------------------------
JSON=0; WATCH=0
while [[ ${1:-} == -* ]]; do
  case $1 in
    --json)    JSON=1; shift ;;
    --watch)   WATCH=1; shift ;;
    --region)  export GAME_REGION="$2"; shift 2 ;;
    --host)    export GAME_TS_HOST="$2"; shift 2 ;;
    -h|--help) set -- help; break ;;
    *) die "unknown flag '$1' (see: cg help)" ;;
  esac
done
CMD="${1:-help}"; shift || true
# Flags are also accepted after the subcommand, which is how people actually
# type them.
for a in "$@"; do
  case $a in --watch) WATCH=1 ;; --json) JSON=1 ;; esac
done

# .env, parsed rather than sourced: a malformed line in a sourced file executes
# as a command. Anything already exported wins, so --region/--host stick.
if [[ -f .env ]]; then
  while IFS= read -r line; do
    [[ $line =~ ^[[:space:]]*# ]] && continue
    [[ $line =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] || continue
    k="${line%%=*}"; [[ -n ${!k:-} ]] && continue
    export "$k=${line#*=}"
  done < .env
fi

REGION="${GAME_REGION:-ap-south-2}"
TS_HOST="${GAME_TS_HOST:-gamevps}"
TS_NODE="${GAME_TS_NODE:-$TS_HOST}"
INSTANCE_ID="${GAME_INSTANCE_ID:-}"
KEY="$HOME/.ssh/${TS_HOST}.pem"
ec2() { aws ec2 "$@" --region "$REGION"; }

# lib/setup and lib/game are dispatch targets, not commands - see lib/README
# is not needed, their headers say so.

need_node() {
  tailscale ip -4 "$TS_NODE" >/dev/null 2>&1 \
    || die "'$TS_NODE' is not on the tailnet. Is the box running? Try: cg status"
}
box() {
  need_node
  ssh -i "$KEY" -o StrictHostKeyChecking=accept-new -o ConnectTimeout=10 \
      -o BatchMode=yes "ubuntu@$(tailscale ip -4 "$TS_NODE")" "$@"
}

# --- commands ------------------------------------------------------------------

# Alt+Tab, Super and friends are swallowed by the *client* desktop unless
# Moonlight is told to capture them, and nothing about the remote box can change
# that - so set it here, once, rather than leaving it as a step to remember.
#
# Only ever ADDS the key when absent: someone who deliberately set it to 0 keeps
# that. And never while Moonlight runs - it does not re-read its config, and it
# rewrites the file on exit, discarding anything changed underneath it.
# Save games live inside the Proton prefix, in the Steam library on /scratch -
# so they survive a stop only by way of the S3 mirror, which runs after this.
# Steam Cloud is the independent copy, and Cloud only syncs when Steam shuts
# down cleanly, so ask it to exit and give it time before stopping the box.
# Streaming is the charge that can exceed the instance, and `cg cost` cannot
# help in the moment: Cost Explorer lags about a day. The box has the counter
# already, so read it live and for free. Since boot, not since the session -
# the kernel keeps no per-session tally - and it includes ssh and Tailscale
# keepalives, which is why it is labelled as tailnet traffic, not pure video.
# The month, from whatever `cg cost` last paid Cost Explorer for. Free, because
# it re-reads a number already bought - and stamped with its age, because a
# cached figure presented as current would be the same scope bug this section
# came from, wearing a different hat.
egress_month() {
  local f=.cg-cache/egress ts gb free age
  [[ -r $f ]] || { printf '  monthly egress  unknown - run: cg cost\n'; return 0; }
  read -r ts gb free < "$f" 2>/dev/null || return 0
  [[ ${ts:-0} =~ ^[0-9]+$ ]] || return 0
  age=$(( ($(date +%s) - ts) / 60 ))
  awk -v g="${gb:-0}" -v fr="${free:-100}" -v a="$age" 'BEGIN{
    left = fr - g; if (left < 0) left = 0;
    if (a < 90)        when = sprintf("%d min ago", a);
    else if (a < 2880) when = sprintf("%.0f h ago", a/60.0);
    else               when = sprintf("%.0f days ago", a/1440.0);
    printf "  monthly egress  %.1f GB used, ~%.0f GB of %.0f GB free left  (as of %s)\n",
           g, left, fr, when;
    if (a > 1440) printf "                  stale - refresh with: cg cost\n";
  }'
}

stream_usage() {
  local node="${GAME_TS_NODE:-$TS_HOST}" ip
  tailscale ip -4 "$node" >/dev/null 2>&1 || return 0
  ip=$(tailscale ip -4 "$node")
  local out
  out=$(ssh -i "$KEY" -o StrictHostKeyChecking=accept-new -o ConnectTimeout=8 \
        -o BatchMode=yes "ubuntu@$ip" '
    ts=$(cat /sys/class/net/tailscale0/statistics/tx_bytes 2>/dev/null || echo 0)
    # What AWS bills is what leaves the real NIC: WireGuard encapsulation, ssh,
    # apt, and - measured at ~2.4 GB against a 132 GB download - the TCP acks a
    # big Steam download generates. None of that appears on tailscale0, so a
    # status line reading only the tunnel understates the bill by about half.
    nic=$(ip route show default 2>/dev/null | awk "{print \$5; exit}")
    wan=$(cat "/sys/class/net/$nic/statistics/tx_bytes" 2>/dev/null || echo 0)
    win=$(cat "/sys/class/net/$nic/statistics/rx_bytes" 2>/dev/null || echo 0)
    up=$(cut -d. -f1 /proc/uptime)
    printf "%s %s %s %s\n" "$ts" "$wan" "$win" "$up"' 2>/dev/null) || return 0
  [[ -n $out ]] || return 0
  echo
  echo "TRAFFIC (this boot only - see cg cost for the billed month)"
  awk -v o="$out" 'BEGIN{
    split(o,f," "); ts=f[1]; wan=f[2]; win=f[3]; up=f[4];
    printf "  stream out      %.2f GB", ts/1073741824;
    if (up>0) printf "   avg %.1f Mbps over %.1f h", ts*8/up/1000000, up/3600;
    printf "\n";
    printf "  total out       %.2f GB   <- what AWS bills (adds wireguard overhead, ssh, apt)\n", wan/1073741824;
    printf "  total in        %.2f GB   (free - game downloads land here)\n", win/1073741824;
    # NOT a monthly figure. These are NIC counters read since THIS box booted,
    # and every session is a new box - so subtracting them from the 100 GB
    # monthly allowance reported 99 GB left while Cost Explorer showed 91.
    # The month lives in cg cost, which reads it from Cost Explorer.
    printf "  (above is this boot only)\n";
  }'
  egress_month
}

steam_shutdown_for_cloud_sync() {
  local node="${GAME_TS_NODE:-$TS_HOST}"
  tailscale ip -4 "$node" >/dev/null 2>&1 || return 0
  local ip; ip=$(tailscale ip -4 "$node")
  local sshopts=(-i "$KEY" -o StrictHostKeyChecking=accept-new -o ConnectTimeout=8 -o BatchMode=yes)
  ssh "${sshopts[@]}" "ubuntu@$ip" 'pgrep -x steam >/dev/null' 2>/dev/null || return 0
  say "closing Steam so cloud saves finish syncing"
  # `steam -shutdown` is the supported way to ask it to exit and sync; a plain
  # kill skips the sync entirely.
  ssh "${sshopts[@]}" "ubuntu@$ip" '
    export DISPLAY=:0 XAUTHORITY="$HOME/.Xauthority"
    export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus"
    /usr/bin/steam -shutdown >/dev/null 2>&1 || true
    for i in $(seq 1 30); do pgrep -x steam >/dev/null || break; sleep 2; done
    pgrep -x steam >/dev/null && echo "still running after 60s" || echo "closed"
  ' 2>/dev/null | sed 's/^/      steam: /'
}

ensure_moonlight_syskeys() {
  local conf="$HOME/.config/Moonlight Game Streaming Project/Moonlight.conf"
  [[ -f $conf ]] || return 0
  pgrep -x moonlight >/dev/null 2>&1 && return 0
  grep -q '^capturesyskeys=' "$conf" && return 0
  if grep -q '^\[General\]' "$conf"; then
    sed -i '0,/^\[General\]/s//[General]\ncapturesyskeys=2/' "$conf" \
      && log "enabled Moonlight system-key capture (Alt+Tab, Super)"
  fi
}


# The games live on the instance store now, which is wiped on every stop, so the
# S3 archive is the only durable copy. The box mirrors continuously on a timer
# and again from a pre-shutdown unit, but both of those run INSIDE a machine
# that is about to disappear - and on a spot interruption there are two minutes
# to work with. So anything initiated from here pushes first, from here, and
# waits for it.
box_state() {
  [[ -n $INSTANCE_ID ]] || { echo none; return; }
  ec2 describe-instances --instance-ids "$INSTANCE_ID" \
    --query 'Reservations[0].Instances[0].State.Name' --output text 2>/dev/null || echo unknown
}

# What the archive holds, asked from HERE rather than from the box - which is
# the only way to ask once the box is stopped or gone, and exactly when the
# question matters most.
archive_report() {
  local b="${GAME_S3_BUCKET:-}"
  [[ -n $b ]] || { log "no bucket in .env - cannot check the archive"; return 1; }
  local out
  out=$(aws s3 ls "s3://$b/steam/" --recursive --summarize 2>/dev/null | tail -2) || true
  local n sz
  n=$(awk '/Total Objects:/{print $3}' <<<"$out")
  sz=$(awk '/Total Size:/{print $3}' <<<"$out")
  printf '      archive s3://%s/steam holds %s objects, %s\n' \
    "$b" "${n:-0}" "$(numfmt --to=iec --suffix=B "${sz:-0}" 2>/dev/null || echo "${sz:-0}B")"
  [[ ${n:-0} -gt 0 ]]
}

library_push() { # library_push [--force]; 0 on a completed push
  local extra="${1:-}"
  tailscale ip -4 "$TS_NODE" >/dev/null 2>&1 || { log "box is not reachable - no push"; return 1; }
  say "mirroring the game library to S3 before the box goes away"
  box "/usr/local/bin/cg-library push $extra" 2>&1 | sed 's/^/      /'
  return "${PIPESTATUS[0]}"
}

# Stopping wipes the instance store, exactly like destroying does, so it gets
# the same gate. The push is here and in destroy and nowhere else: there is no
# timer and no pre-shutdown hook, so if this does not run, the games are gone.
# Which is why a failure stops the stop rather than printing a note next to it.
# The push and its gate live in lib/game's down(), which every stop path goes
# through - including the "stop instance now?" prompt at the end of `cg open`,
# which does not come back through here. Duplicating the gate would mean two
# pushes on `cg stop` and still none on that prompt.
cmd_stop() {
  local a
  for a in "$@"; do
    case $a in
      --force) export CG_FORCE=1 ;;
      *) die "unknown option '$a' for stop (only --force is accepted)" ;;
    esac
  done
  steam_shutdown_for_cloud_sync
  exec lib/game stop
}

# Ask which games to restore, before anything launches. The answer is exported
# for provision.sh to bake into user-data, and remembered in .env so the common
# case next time is pressing Enter.
choose_games() {
  local sel
  # On failure keep whatever .env already said rather than reaching for "all":
  # "all" is only safe while the archive is smaller than the disk, and the whole
  # reason this prompt exists is that it no longer is.
  sel=$(GAME_S3_BUCKET="${GAME_S3_BUCKET:-}" bash lib/choose-games.sh) \
    || sel="${GAME_APPS:-all}"
  export GAME_APPS="${sel:-${GAME_APPS:-all}}"
  local tmp; tmp=$(mktemp)
  grep -vE '^GAME_APPS=' .env > "$tmp" 2>/dev/null || true
  echo "GAME_APPS=$GAME_APPS" >> "$tmp"
  cat "$tmp" > .env; rm -f "$tmp"; chmod 600 .env
}

# list and forget are pure S3, so they work with no box running - which is when
# you most want to know what the archive is costing, and the only time it is
# safe to assume nothing is writing to it.
library_index() {
  [[ -n ${GAME_S3_BUCKET:-} ]] || { echo "no bucket yet - run cg init"; return 1; }
  aws s3 cp "s3://$GAME_S3_BUCKET/steam/index.json" - 2>/dev/null || echo '{"apps":[]}'
}

library_list() {
  # An index.json is written only by the per-app push. A box built before that
  # mirrors fine but writes no index, so "the archive is empty" would be a lie
  # told about the thing that was looked for rather than the thing that is
  # there. Check the objects before saying nothing is there.
  local objs
  objs=$(aws s3 ls "s3://$GAME_S3_BUCKET/steam/" --recursive --summarize 2>/dev/null \
         | awk '/Total Objects:/{print $3}')
  if [[ ${objs:-0} -gt 0 ]] \
     && ! aws s3 ls "s3://$GAME_S3_BUCKET/steam/index.json" >/dev/null 2>&1; then
    local sz
    sz=$(aws s3 ls "s3://$GAME_S3_BUCKET/steam/" --recursive --summarize 2>/dev/null \
         | awk '/Total Size:/{print $3}')
    echo "  archive holds $objs objects, $(numfmt --to=iec --suffix=B "${sz:-0}" 2>/dev/null)"
    echo "  but no per-game index yet - this box predates per-game archiving."
    echo "  The next push from a rebuilt box writes one and this lists per game."
    aws s3 ls "s3://$GAME_S3_BUCKET/steam/steamapps/common/" 2>/dev/null \
      | sed 's/^ *PRE /  - /' | sed 's|/$||'
    return 0
  fi
  library_index | python3 -c '
import json,sys
try:    apps=json.load(sys.stdin).get("apps",[])
except Exception: apps=[]
if not apps: print("  the archive is empty"); sys.exit()
GB=1073741824.0
print("  %-10s %-32s %9s  %s" % ("APPID","GAME","SIZE","ARCHIVED"))
tot=0
for a in apps:
    tot+=a.get("bytes",0)
    print("  %-10s %-32s %6.1f GB  %s" % (a["appid"], a.get("name","?")[:32],
          a.get("bytes",0)/GB, a.get("pushed","?")[:16].replace("T"," ")))
g=tot/GB
print("  %-10s %-32s %6.1f GB   $%.2f/month (INR %.0f)" % ("","total",g,g*0.025,g*0.025*88))
print("")
print("  229 GB fits on the box at once (209 GB selectable after reserve)")
if g > 209: print("  the archive is larger than the disk - cg init asks which to restore")'
}

library_forget() {
  local id="${1:-}"
  [[ -n $id ]] || die "which game? see: cg library list"
  [[ -n ${GAME_S3_BUCKET:-} ]] || die "no bucket configured"
  local row
  row=$(library_index | python3 -c '
import json,sys
appid=sys.argv[1]
try:    apps=json.load(sys.stdin).get("apps",[])
except Exception: apps=[]
for a in apps:
    if str(a.get("appid"))==appid:
        print("%s\t%s\t%s" % (a.get("name","?"), a.get("installdir",""), a.get("bytes",0))); break' "$id")
  [[ -n ${row//[[:space:]]/} ]] || die "appid $id is not in the archive (see: cg library list)"
  local name dir bytes; IFS=$'\t' read -r name dir bytes <<<"$row"
  local gb; gb=$(awk -v b="$bytes" 'BEGIN{printf "%.1f", b/1073741824}')
  echo "This permanently deletes $name ($id, ${gb} GB) from the archive."
  echo "No undo, no versioning. Playing it again means downloading it from Steam."
  echo "At Steam speeds that is roughly $(awk -v b="$bytes" 'BEGIN{printf "%.1f", b/12582912/3600}') hours."
  local a; read -r -p "type FORGET to confirm: " a
  [[ $a == FORGET ]] || { echo "aborted - nothing was deleted"; return 1; }
  local pair
  for pair in "common/$dir" "compatdata/$id" "shadercache/$id"; do
    aws s3 rm "s3://$GAME_S3_BUCKET/steam/steamapps/$pair" --recursive >/dev/null 2>&1 || true
  done
  aws s3 rm "s3://$GAME_S3_BUCKET/steam/steamapps/appmanifest_$id.acf" >/dev/null 2>&1 || true
  aws s3 rm "s3://$GAME_S3_BUCKET/steam/meta/symlinks-$id.tsv" >/dev/null 2>&1 || true
  # Drop it from the index too, or cg init keeps offering a game that is gone.
  local tmp; tmp=$(mktemp)
  library_index | python3 -c '
import json,sys
appid=sys.argv[1]
try:    d=json.load(sys.stdin)
except Exception: d={"apps":[]}
print(json.dumps({"apps":[a for a in d.get("apps",[]) if str(a.get("appid"))!=appid]},indent=1))' "$id" > "$tmp"
  aws s3 cp "$tmp" "s3://$GAME_S3_BUCKET/steam/index.json" >/dev/null 2>&1 || log "could not update the index"
  rm -f "$tmp"
  log "forgot $name ($id) - ${gb} GB stops billing"
}

cmd_library() {
  case "${1:-status}" in
    status|"")
      need_node
      box '/usr/local/bin/cg-library status' ;;
    push|sync)
      shift
      need_node
      box "/usr/local/bin/cg-library push $*" ;;
    pull|restore)
      shift
      need_node
      box "/usr/local/bin/cg-library pull $*" ;;
    check)
      need_node
      box '/usr/local/bin/cg-library check' ;;
    list)
      library_list ;;
    forget)
      shift; library_forget "$@" ;;
    --bucket|bucket)
      # Answerable without the box, which matters when it is gone: this is where
      # the games are, and the one thing worth knowing then.
      echo "${GAME_S3_BUCKET:-(not set - run cg init)}" ;;
    *) die "usage: cg library [list|status|push|pull [--apps <csv>]|check|forget <appid>|--bucket]" ;;
  esac
}

# `cg destroy` deliberately keeps the game volume. `--all` is the way to say
# "no, everything" - and it has to be a real flag rather than a silently
# ignored argument, or someone types it, sees "everything deleted", and keeps
# paying INR 1,284/month for a volume they believe is gone.
cmd_destroy() {
  local all=0 force=0 a
  for a in "$@"; do
    case $a in
      --all)   all=1 ;;
      --force) force=1 ;;
      # Refuse anything else rather than ignore it: a typo like --everything
      # must not quietly behave as a plain destroy and leave the volume billing.
      *) die "unknown option '$a' for destroy (--all and --force are accepted)" ;;
    esac
  done
  # --all means the games go too, so mirroring them to S3 first and then
  # deleting the archive would be absurd. That path skips the push entirely.
  if (( all )); then
    destroy_everything "$force"
    return
  fi

  # Destroy takes the instance store with it, and that is where the games are.
  # A failed push is not a warning to print and carry on past - it means the
  # next `cg init` re-downloads everything, which is the exact problem this
  # whole design exists to solve.
  #
  # But only a RUNNING box can be pushed from. Gating on the push regardless of
  # state made destroying a stopped box impossible without --force, which would
  # have trained the habit of passing --force to destroy.
  local st; st=$(box_state)
  if [[ $st == running ]]; then
    if ! library_push; then
      if (( ! force )); then
        echo
        echo "  The push from here failed, which usually means ssh cannot reach the box."
        echo "  That is not the same as 'the games are lost':"
        echo
        echo "    cg-library-shutdown.service runs ON the box, from ExecStop, and"
        echo "    mirrors the library as the machine shuts down. It needs no ssh."
        echo "    Terminating sends a graceful shutdown, so it still runs."
        echo
        echo "  So --force is usually safe here. Afterwards, confirm it worked:"
        echo "      cg library list      # the archive, read straight from S3"
        echo
        die "not mirrored from here - see above, then: cg destroy --force"
      fi
      log "WARNING: proceeding without a mirror (--force) - games will be re-downloaded"
    fi
  else
    log "box is $st - nothing local to push"
    archive_report || log "the archive is EMPTY - if you expected games in it, stop here"
  fi
  lib/setup destroy
}

# `--all` used to mean "the box and the EBS game volume". The games moved to S3,
# so a flag that deleted the volume and left the archive billing was promising
# "nothing left billing" while ignoring the only storage that still costs
# anything - and, once that volume was gone, it was silently identical to a
# plain destroy. It now deletes the ARCHIVE, which is the games.
#
# This is the single unrecoverable action in this repo: the archive is the only
# copy, with no versioning and no snapshot. So it asks for a typed word rather
# than trusting a flag - a mis-typed flag is exactly what must not reach here.
destroy_everything() {
  local force="${1:-0}" vol size b n sz out a i
  b="${GAME_S3_BUCKET:-}"
  read -r vol size < <(ec2 describe-volumes --filters "Name=tag:Name,Values=${TS_HOST}-games" \
    --query 'Volumes[0].[VolumeId,Size]' --output text 2>/dev/null)

  echo "--all deletes the box AND every game you have."
  echo
  if [[ -n $b ]]; then
    out=$(aws s3 ls "s3://$b/steam/" --recursive --summarize 2>/dev/null | tail -2) || true
    n=$(awk '/Total Objects:/{print $3}' <<<"$out")
    sz=$(awk '/Total Size:/{print $3}' <<<"$out")
    printf '  game archive    s3://%s/steam  %s objects, %s\n' "$b" "${n:-0}" \
      "$(numfmt --to=iec --suffix=B "${sz:-0}" 2>/dev/null || echo "${sz:-0}B")"
    echo "                  THIS IS THE ONLY COPY - no versions, no snapshot, no undo"
  else
    echo "  game archive    (no bucket recorded in .env - nothing to delete)"
  fi
  [[ -n ${vol:-} && $vol != None ]] && printf '  old EBS volume  %s  %s GB\n' "$vol" "$size"
  echo "  the box         everything cg destroy normally removes"
  echo
  if [[ -n $b ]]; then
    echo "  the bucket      s3://$b itself"
  fi
  # Only list what actually EXISTS. This used to announce the role and the
  # watchdog user unconditionally, so a run with neither of them present read as
  # though both were about to be deleted - and then said nothing more about the
  # watchdog, leaving no way to tell "removed" from "was never there" from
  # "skipped by a bug".
  local role_x=0 wd_x=0
  aws iam get-role --role-name "${TS_HOST}-box" >/dev/null 2>&1 && role_x=1
  aws iam get-user --user-name "${TS_HOST}-watchdog" >/dev/null 2>&1 && wd_x=1
  if (( role_x )); then
    echo "  instance role   ${TS_HOST}-box, and its instance profile"
  fi
  if (( wd_x )); then
    echo "  watchdog key    ${TS_HOST}-watchdog - a long-lived key that can stop"
    echo "                  instances. Held in .env${GAME_WATCHDOG_HOST:+ and on ${GAME_WATCHDOG_HOST#*@}}"
  fi
  if [[ -n ${GAME_WATCHDOG_HOST:-} ]]; then
    echo "  off-site units  the watchdog timer and config on ${GAME_WATCHDOG_HOST#*@}"
  fi
  (( role_x || wd_x )) || [[ -n ${GAME_WATCHDOG_HOST:-} ]] \
    || echo "  IAM             nothing - no role or watchdog credential exists"
  echo
  echo "Nothing is left behind. cg init recreates all of it - the bucket name is"
  echo "derived from your account, so it comes back identical."
  echo
  if (( ! force )); then
    read -r -p "type DESTROY-ALL to confirm: " a
    [[ $a == DESTROY-ALL ]] || { echo "aborted - nothing was deleted"; return 1; }
  fi

  CG_DESTROY_ALL=1 lib/setup destroy

  if [[ -n $b ]]; then
    say "deleting the game archive and its bucket s3://$b"
    # --force empties the bucket first; a bucket with anything in it cannot be
    # removed, and that includes incomplete multipart uploads, which appear in
    # no listing and are the usual reason a "delete the bucket" step fails.
    if aws s3 rb "s3://$b" --force >/dev/null 2>&1; then
      log "bucket deleted - storage charges stop now"
    else
      log "could not delete the bucket; check: aws s3 ls s3://$b --recursive --summarize"
      log "  incomplete multipart uploads also block it:"
      log "  aws s3api list-multipart-uploads --bucket $b"
    fi
    # .env must not keep pointing at a bucket that no longer exists, or the next
    # status prints a name for something deleted.
    if [[ -f .env ]]; then
      local tmp; tmp=$(mktemp)
      grep -vE '^GAME_S3_BUCKET=' .env > "$tmp" 2>/dev/null || true
      cat "$tmp" > .env; rm -f "$tmp"; chmod 600 .env
    fi
  fi

  # The role and instance profile cost nothing, but "--all" that leaves IAM
  # objects behind is not --all. Order matters: a role cannot be deleted while
  # it is in an instance profile or has an inline policy attached.
  local prof="${TS_HOST}-box"
  say "removing the instance role $prof"
  aws iam remove-role-from-instance-profile --instance-profile-name "$prof" \
    --role-name "$prof" >/dev/null 2>&1 || true
  aws iam delete-instance-profile --instance-profile-name "$prof" >/dev/null 2>&1 || true
  aws iam delete-role-policy --role-name "$prof" --policy-name library-rw >/dev/null 2>&1 || true
  if aws iam delete-role --role-name "$prof" >/dev/null 2>&1; then
    log "deleted role and instance profile $prof"
  else
    log "role $prof was already gone"
  fi

  # The off-site watchdog. Not about cost: it holds a long-lived access key that
  # can call ec2:StopInstances, on an internet-facing VPS. "everything deleted"
  # leaving a live AWS credential behind is the leftover that actually matters,
  # and it survived --all until someone audited IAM by hand.
  #
  # `cg watchdog remove` already does every part of this - keys, policy, user,
  # .env, the units on the remote host and the credentials file there. This used
  # to reimplement the IAM half and skip the remote half, which left a timer
  # running every few minutes on the VPS forever, logging AuthFailure against a
  # key that no longer existed. Subshelled because cmd_watchdog uses die().
  # An outcome is logged on every path, including the do-nothing one. A step
  # that is listed as part of the deletion and then prints nothing is
  # indistinguishable from a step that silently failed.
  local wd="${TS_HOST}-watchdog"
  if [[ -n ${GAME_WATCHDOG_HOST:-} ]]; then
    say "removing the off-site watchdog: IAM user and the units on ${GAME_WATCHDOG_HOST#*@}"
    ( cmd_watchdog remove ) \
      || log "off-site watchdog not fully removed - check: cg watchdog status"
  elif aws iam get-user --user-name "$wd" >/dev/null 2>&1; then
    # No host configured, but the IAM user exists - an earlier setup, or an init
    # that created the credential before being interrupted. The key still works
    # and still has to go.
    say "removing the off-site watchdog credential $wd"
    local k
    for k in $(aws iam list-access-keys --user-name "$wd" \
               --query 'AccessKeyMetadata[].AccessKeyId' --output text 2>/dev/null); do
      [[ -n $k && $k != None ]] && aws iam delete-access-key --user-name "$wd" \
        --access-key-id "$k" >/dev/null 2>&1 && log "revoked key $k"
    done
    aws iam delete-user-policy --user-name "$wd" --policy-name idle-stop >/dev/null 2>&1 || true
    aws iam delete-user --user-name "$wd" >/dev/null 2>&1 \
      && log "deleted IAM user $wd - that key can no longer stop anything" \
      || log "could not delete $wd; check: aws iam list-access-keys --user-name $wd"
    local t2; t2=$(mktemp)
    grep -vE '^GAME_WATCHDOG_AWS_(KEY_ID|SECRET)=' .env > "$t2" 2>/dev/null || true
    cat "$t2" > .env; rm -f "$t2"; chmod 600 .env
  else
    log "off-site watchdog: no credential and no host configured - nothing to remove"
  fi

  [[ -n ${vol:-} && $vol != None ]] || return 0
  # Terminating the instance detaches it, but AWS takes a moment to let go.
  say "deleting the old game library volume $vol"
  for i in $(seq 1 40); do
    [[ $(ec2 describe-volumes --volume-ids "$vol" --query 'Volumes[0].State' \
         --output text 2>/dev/null) == available ]] && break
    sleep 3
  done
  if ec2 delete-volume --volume-id "$vol" >/dev/null 2>&1; then
    log "deleted $vol - storage charges stop now"
  else
    log "could not delete $vol; retry with: cg games --delete"
  fi
}

# Layer 4: the same watchdog logic, on a host that is always on. The on-host
# watchdog dies with the box it protects, and the CloudWatch alarm can be
# deleted, disarmed or misconfigured - and has stopped a box once here with no
# visible reasoning. This layer writes down every decision and the numbers
# behind it, which is most of its value.
# Called by `cg init` before anything launches. The off-site watchdog polls by
# TAG, so it does not need the instance to exist - and the whole point of an
# independent guard is that it is already watching when the box appears, not
# installed afterwards by hand. Quiet when it is already in place, and never
# fatal: a missing watchdog must not stop you building a box.
# Create the scoped IAM user the off-site watchdog needs, so none of this is a
# manual step. Deliberately narrow: describe instances, read metrics, and stop
# or terminate ONLY an instance tagged with this host name. It cannot launch
# anything, touch the game archive, or read anything else.
#
# Terminate is new, and it is a deliberate widening. On a one-time spot instance
# stopping is the destructive option - the box can never start again and bills
# for its root volume forever - so the guard has to be able to terminate to do
# its job at all. The blast radius is also smaller than it looks now that the
# games live in S3: the worst an attacker on that VPS can do is cost you a
# six-minute rebuild. Under the old design the same access would have destroyed
# a 140 GB library.
#
# Long-lived access keys are the only option for a host outside AWS: there is no
# instance role to borrow. They land in .env, which is gitignored, and are
# pushed to the box over stdin.
watchdog_iam_ensure() {
  local user="${TS_HOST}-watchdog"
  # Already have working credentials? Then there is nothing to do. Checked by
  # using them, not by assuming the variables are still valid.
  if [[ -n ${GAME_WATCHDOG_AWS_KEY_ID:-} && -n ${GAME_WATCHDOG_AWS_SECRET:-} ]]; then
    if AWS_ACCESS_KEY_ID="$GAME_WATCHDOG_AWS_KEY_ID" \
       AWS_SECRET_ACCESS_KEY="$GAME_WATCHDOG_AWS_SECRET" \
       aws sts get-caller-identity >/dev/null 2>&1; then
      return 0
    fi
    log "the watchdog credentials in .env no longer work - reissuing"
  fi

  aws iam get-user --user-name "$user" >/dev/null 2>&1 || {
    say "creating the scoped IAM user $user"
    aws iam create-user --user-name "$user" >/dev/null 2>&1 || {
      log "could not create $user (needs iam:CreateUser) - skipping the off-site watchdog"
      return 1
    }
  }

  # put-user-policy overwrites, so this also repairs a policy edited by hand.
  #
  # Passed inline rather than through a temp file. The temp file came with
  # `trap 'rm -f "$pol"' RETURN`, and a RETURN trap set inside a function is NOT
  # scoped to it: it stays installed and fires on every later function return,
  # by which point $pol is out of scope. Under `set -u` that is fatal, so
  # `cg init` died with "pol: unbound variable" after the watchdog was armed and
  # before anything launched.
  #
  # It only ever ran on the branch where the IAM user does not exist - a first
  # init, or the first one after `cg destroy --all` - which is why it sat here
  # unnoticed until --all started deleting that user.
  local pol
  pol=$(cat <<JSON
{ "Version": "2012-10-17", "Statement": [
  { "Effect": "Allow",
    "Action": ["ec2:DescribeInstances", "cloudwatch:GetMetricStatistics"],
    "Resource": "*" },
  { "Effect": "Allow",
    "Action": ["ec2:StopInstances", "ec2:TerminateInstances"],
    "Resource": "*",
    "Condition": { "StringEquals": { "ec2:ResourceTag/Name": "$TS_HOST" } } }
]}
JSON
)
  aws iam put-user-policy --user-name "$user" --policy-name idle-stop \
    --policy-document "$pol" >/dev/null 2>&1 \
    || { log "could not attach the policy to $user - skipping the off-site watchdog"; return 1; }

  # AWS allows two keys per user and shows a secret exactly once, so an existing
  # key whose secret we do not have is useless - clear the way and reissue.
  local k
  for k in $(aws iam list-access-keys --user-name "$user" \
             --query 'AccessKeyMetadata[].AccessKeyId' --output text 2>/dev/null); do
    [[ -n $k && $k != None ]] && aws iam delete-access-key --user-name "$user" --access-key-id "$k" >/dev/null 2>&1
  done
  local kid sec
  read -r kid sec < <(aws iam create-access-key --user-name "$user" \
    --query 'AccessKey.[AccessKeyId,SecretAccessKey]' --output text 2>/dev/null)
  [[ -n ${kid:-} && $kid != None ]] || { log "could not create an access key for $user"; return 1; }

  # New keys are eventually consistent; using one immediately can fail.
  local i
  for i in $(seq 1 10); do
    AWS_ACCESS_KEY_ID="$kid" AWS_SECRET_ACCESS_KEY="$sec" \
      aws sts get-caller-identity >/dev/null 2>&1 && break
    sleep 3
  done

  local tmp; tmp=$(mktemp)
  grep -vE '^GAME_WATCHDOG_AWS_(KEY_ID|SECRET)=' .env 2>/dev/null > "$tmp" || true
  printf 'GAME_WATCHDOG_AWS_KEY_ID=%s\nGAME_WATCHDOG_AWS_SECRET=%s\n' "$kid" "$sec" >> "$tmp"
  cat "$tmp" > .env; rm -f "$tmp"; chmod 600 .env
  export GAME_WATCHDOG_AWS_KEY_ID="$kid" GAME_WATCHDOG_AWS_SECRET="$sec"
  log "issued a scoped key for $user and saved it to .env"
  return 0
}

# Builds the ssh command for the off-site host into WD_RSH. An Oracle box wants
# its own key, which is what GAME_WATCHDOG_KEY is for; unset means the ssh
# default. Written out three times before this existed.
wd_rsh_init() {
  local kf="${GAME_WATCHDOG_KEY:-}" ident=()
  [[ -n $kf ]] && ident=(-i "${kf/#\~/$HOME}")
  WD_RSH=(ssh "${ident[@]}" -o ConnectTimeout=8 -o BatchMode=yes
          -o StrictHostKeyChecking=accept-new "$GAME_WATCHDOG_HOST")
}

watchdog_ensure() {
  [[ -n ${GAME_WATCHDOG_HOST:-} ]] || return 0
  wd_rsh_init; local rsh=("${WD_RSH[@]}")
  if ! "${rsh[@]}" true 2>/dev/null; then
    log "off-site watchdog: $GAME_WATCHDOG_HOST unreachable - skipping"
    return 0
  fi
  watchdog_iam_ensure || true

  # Every call below goes through a SUBSHELL. cmd_watchdog uses die(), which
  # exits the process - so a plain `cmd_watchdog install || log ...` cannot
  # catch it and a missing watchdog killed `cg init` outright. This function
  # promises never to be fatal; a subshell is what makes that true.
  if [[ $("${rsh[@]}" 'systemctl is-enabled remote-watchdog.timer 2>/dev/null | head -1' 2>/dev/null) == enabled ]]; then
    ( cmd_watchdog install ) >/dev/null 2>&1 \
      || log "off-site watchdog: refresh failed (the existing one is still armed)"
  else
    say "arming the off-site watchdog before anything launches"
    ( cmd_watchdog install ) || {
      log "off-site watchdog not installed - the other three layers still apply"
      return 0
    }
  fi
  watchdog_prove
  return 0
}

# "refreshed" used to mean "the install command exited 0" - and it printed that
# while the watchdog was blind, because the units run as root and the credentials
# were not readable by root. Exit codes are not evidence. Make it run once and
# report what it actually decided, which is the only thing worth printing.
watchdog_prove() {
  wd_rsh_init; local rsh=("${WD_RSH[@]}")
  local line
  line=$("${rsh[@]}" 'sudo systemctl start remote-watchdog.service 2>/dev/null;
                      sleep 2; sudo tail -1 /var/log/cloud-gaming-watchdog.log' 2>/dev/null)
  if [[ -z ${line:-} ]]; then
    log "off-site watchdog: armed, but it logged nothing - check: cg watchdog logs"
    return 0
  fi
  # Strip the timestamp; the line already reads as a sentence.
  log "off-site watchdog: ${line#* }"
  [[ $line == *"CANNOT QUERY AWS"* ]] \
    && log "  ^ it cannot see your account - fix this or layer 4 is decoration"
  return 0
}

cmd_watchdog() {
  local host="${GAME_WATCHDOG_HOST:-}"
  [[ -n $host ]] || die "set GAME_WATCHDOG_HOST=user@host in .env (an always-on box with the aws CLI)"
  # That host is almost never reachable with a default key - an Oracle box wants
  # its own. GAME_WATCHDOG_KEY supplies it; unset means use the ssh default.
  local kf="${GAME_WATCHDOG_KEY:-}"
  local ident=(); [[ -n $kf ]] && ident=(-i "${kf/#\~/$HOME}")
  local rsh=(ssh "${ident[@]}" -o ConnectTimeout=10 -o BatchMode=yes
             -o StrictHostKeyChecking=accept-new "$host")
  local scpid=("${ident[@]}")
  case "${1:-status}" in
    install)
      say "checking $host"
      # Install the CLI rather than complaining about it. Amazon's installer,
      # not apt: this is an Oracle Ampere box where `awscli` is not in the
      # enabled repos at all, and the installer covers both x86_64 and aarch64.
      if ! "${rsh[@]}" 'command -v aws >/dev/null' 2>/dev/null; then
        say "installing the aws CLI on $host"
        "${rsh[@]}" '
          set -e
          command -v unzip >/dev/null || { sudo apt-get update -qq; sudo apt-get install -y -qq unzip; }
          cd /tmp
          curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-$(uname -m).zip" -o awscliv2.zip
          unzip -q -o awscliv2.zip
          sudo ./aws/install --update >/dev/null
          rm -rf /tmp/aws /tmp/awscliv2.zip
        ' || die "could not install the aws CLI on $host"
        log "installed $("${rsh[@]}" 'aws --version 2>&1 | cut -d" " -f1' 2>/dev/null)"
      fi
      # Credentials can come from .env, so the whole thing is one command. These
      # must be the SCOPED user's keys - see the IAM policy in the README. They
      # are written 600 and owned by the remote user.
      if [[ -n ${GAME_WATCHDOG_AWS_KEY_ID:-} && -n ${GAME_WATCHDOG_AWS_SECRET:-} ]]; then
        log "scoped credentials go into the root-owned watchdog config"
      fi

      # Verify credentials AFTER writing them, not before: the check used to run
      # first and failed on a box that was about to be configured correctly.
      say "installing the off-site watchdog on $host"
      "${rsh[@]}" 'sudo install -d -m 755 /var/lib/cloud-gaming-watchdog' 2>/dev/null || true
      scp -q "${scpid[@]}" -o BatchMode=yes -o StrictHostKeyChecking=accept-new \
        host/remote-watchdog.sh host/remote-watchdog.service \
        host/remote-watchdog.timer "$host:/tmp/" || die "copy to $host failed"
      # The whole config, secrets included, goes over stdin: the units run as
      # ROOT, so credentials in a user's home are invisible to them - which is
      # exactly how this watchdog spent half an hour blind.
      {
        printf 'GAME_REGION=%s\nGAME_TS_HOST=%s\nIDLE_LIMIT=%s\n' \
          "$REGION" "$TS_HOST" "${GAME_WATCHDOG_IDLE:-6}"
        [[ -n ${GAME_WATCHDOG_AWS_KEY_ID:-} ]] && \
          printf 'export AWS_ACCESS_KEY_ID=%s\nexport AWS_SECRET_ACCESS_KEY=%s\nexport AWS_DEFAULT_REGION=%s\n' \
            "$GAME_WATCHDOG_AWS_KEY_ID" "$GAME_WATCHDOG_AWS_SECRET" "$REGION"
      } | "${rsh[@]}" "
        set -e
        sudo install -m 755 /tmp/remote-watchdog.sh /usr/local/bin/remote-watchdog.sh
        sudo install -m 644 /tmp/remote-watchdog.service /tmp/remote-watchdog.timer /etc/systemd/system/
        sudo install -m 600 /dev/null /etc/cloud-gaming-watchdog.conf
        sudo tee /etc/cloud-gaming-watchdog.conf >/dev/null
        sudo systemctl daemon-reload
        sudo systemctl enable --now remote-watchdog.timer
        rm -f /tmp/remote-watchdog.*
      " || die "install on $host failed"
      # Verify the credentials the WATCHDOG will actually use: root, reading the
      # config just written. Checking as the login user was wrong twice - first
      # before the keys existed, then after they moved somewhere only root can
      # read. Verify the thing that runs, not something adjacent to it.
      local remote_arn local_arn
      remote_arn=$("${rsh[@]}" 'sudo bash -c "set -a; . /etc/cloud-gaming-watchdog.conf; aws sts get-caller-identity --query Arn --output text"' 2>/dev/null) \
        || die "the watchdog cannot authenticate to AWS on $host.
       Put the scoped user's keys in .env as GAME_WATCHDOG_AWS_KEY_ID and
       GAME_WATCHDOG_AWS_SECRET - cg init creates that user for you."
      log "watchdog identity: $remote_arn"
      local_arn=$(aws sts get-caller-identity --query Arn --output text 2>/dev/null || echo "")
      # An always-on, internet-facing box holding the same credentials as your
      # laptop is the worst outcome here, so say so plainly.
      if [[ -n $local_arn && $remote_arn == "$local_arn" ]]; then
        log ""
        log "WARNING: $host is using the SAME credentials as this machine."
        log "  That gives an always-on, internet-facing host your full access."
        log "  cg init creates a scoped user; see the IAM policy in the README."
        log ""
      fi

      log "installed and enabled - it survives a reboot of $host (OnBootSec + Persistent)"
      "${rsh[@]}" 'systemctl list-timers remote-watchdog.timer --no-pager' 2>/dev/null | sed 's/^/      /'
      log "it stops the box after $(( ${GAME_WATCHDOG_IDLE:-6} * 5 )) min with no traffic in or out"
      ;;
    status)
      printf '  host    %s\n' "$host"
      # is-enabled prints "not-found" AND exits non-zero, so a `|| echo` prints
      # both. Take the first word and normalise it.
      local st
      st=$("${rsh[@]}" 'systemctl is-enabled remote-watchdog.timer 2>/dev/null | head -1' 2>/dev/null)
      printf '  timer   %s\n' "${st:-not installed}"
      "${rsh[@]}" 'systemctl list-timers remote-watchdog.timer --no-pager 2>/dev/null | sed -n 2p' 2>/dev/null | sed 's/^/  next    /'
      echo "  recent decisions:"
      "${rsh[@]}" 'sudo tail -n 8 /var/log/cloud-gaming-watchdog.log 2>/dev/null' 2>/dev/null | sed 's/^/    /' \
        || echo "    (no log yet)"
      ;;
    logs)
      if (( WATCH )); then "${rsh[@]}" 'sudo tail -f /var/log/cloud-gaming-watchdog.log'
      else "${rsh[@]}" 'sudo tail -n 40 /var/log/cloud-gaming-watchdog.log' 2>/dev/null | sed 's/^/  /'; fi ;;
    remove)
      # Also removes the IAM user, since cg created it. Keys first: a user with
      # keys cannot be deleted, and leaving a stray key is worse than leaving a
      # stray user.
      local u="${TS_HOST}-watchdog" k
      if aws iam get-user --user-name "$u" >/dev/null 2>&1; then
        say "removing the scoped IAM user $u"
        for k in $(aws iam list-access-keys --user-name "$u" \
                   --query 'AccessKeyMetadata[].AccessKeyId' --output text 2>/dev/null); do
          [[ -n $k && $k != None ]] && aws iam delete-access-key --user-name "$u" --access-key-id "$k" >/dev/null 2>&1 \
            && log "deleted key $k"
        done
        aws iam delete-user-policy --user-name "$u" --policy-name idle-stop >/dev/null 2>&1 || true
        aws iam delete-user --user-name "$u" >/dev/null 2>&1 && log "deleted $u" \
          || log "could not delete $u"
      fi
      local tmp; tmp=$(mktemp)
      grep -vE '^GAME_WATCHDOG_AWS_(KEY_ID|SECRET)=' .env 2>/dev/null > "$tmp" || true
      cat "$tmp" > .env; rm -f "$tmp"; chmod 600 .env
      say "removing the off-site watchdog from $host"
      "${rsh[@]}" 'sudo systemctl disable --now remote-watchdog.timer 2>/dev/null;
        sudo rm -f /etc/systemd/system/remote-watchdog.{service,timer} \
          /usr/local/bin/remote-watchdog.sh /etc/cloud-gaming-watchdog.conf;
        sudo systemctl daemon-reload;
        shred -u ~/.aws/credentials 2>/dev/null || rm -f ~/.aws/credentials' 2>/dev/null
      log "removed" ;;
    *) die "usage: cg watchdog [install|status|logs [--watch]|remove]" ;;
  esac
}

cmd_games() {
  local vol az size state
  read -r vol az size state < <(ec2 describe-volumes \
    --filters "Name=tag:Name,Values=${TS_HOST}-games" \
    --query 'Volumes[0].[VolumeId,AvailabilityZone,Size,State]' --output text 2>/dev/null)
  if [[ -z ${vol:-} || $vol == None ]]; then
    echo "no EBS game volume exists - nothing billing."
    echo "the game library lives in S3 now: cg library"
    return 0
  fi
  case "${1:-show}" in
    show|"")
      awk -v v="$vol" -v a="$az" -v s="$size" -v st="$state" 'BEGIN{
        m=s*0.0912;
        printf "  volume   %s  (%s)\n", v, st;
        printf "  zone     %s\n", a;
        printf "  size     %s GB\n", s;
        printf "  cost     $%.2f/month (INR %.0f) - billed whether or not the box exists\n", m, m*88;
      }'
      echo "  status   LEGACY - nothing mounts or attaches this any more."
      echo "           the library is in S3: cg library"
      echo "  delete   cg games --delete   (permanent; anything left on it goes too)" ;;
    --delete|delete)
      [[ $state == available ]] || die "volume is $state - stop or destroy the instance first"
      echo "Nothing uses this volume any more; the games are in S3 (cg library)."
      echo "This permanently deletes $vol and every game on it."
      read -r -p "type DELETE to confirm: " a
      [[ $a == DELETE ]] || { echo "aborted"; return 1; }
      ec2 delete-volume --volume-id "$vol" >/dev/null && log "deleted $vol"
      log "storage charges stop now" ;;
    *) die "usage: cg games [show|--delete]" ;;
  esac
}

cmd_snapshot() {
  case "${1:-create}" in
    --list|list)
      # Images bill every month, forever, and nothing else here lists them -
      # a create-only snapshot command is a slow leak.
      local imgs
      imgs=$(ec2 describe-images --owners self \
        --query 'reverse(sort_by(Images,&CreationDate))[].{id:ImageId,name:Name,created:CreationDate,state:State,gb:BlockDeviceMappings[0].Ebs.VolumeSize}' \
        --output json)
      if (( JSON )); then printf '%s\n' "$imgs"; return; fi
      python3 - <<PY
import json,sys
imgs=json.loads('''$imgs''')
if not imgs: print("no saved images - nothing billing"); sys.exit()
print(f"{'IMAGE':<24}{'CREATED':<22}{'GB':>4}  {'~USD/mo':>8}  NAME")
tot=0.0
for i in imgs:
    gb=i.get('gb') or 0
    mo=gb*0.05          # EBS snapshot storage, approx
    tot+=mo
    print(f"{i['id']:<24}{i['created'][:19]:<22}{gb:>4}  {mo:>8.2f}  {i['name']}")
print(f"\nestimated {tot:.2f} USD/month (~INR {tot*88:.0f}) for {len(imgs)} image(s)")
print("delete one with:  cg snapshot --delete <image-id>")
PY
      ;;
    --delete|delete)
      local id="${2:-}"
      [[ -n $id ]] || die "which image? see: cg snapshot --list"
      # Deregistering leaves the backing snapshots behind, still billing - that
      # is the classic way to believe you deleted something and keep paying.
      local snaps
      snaps=$(ec2 describe-images --image-ids "$id" \
        --query 'Images[0].BlockDeviceMappings[].Ebs.SnapshotId' --output text 2>/dev/null || true)
      ec2 deregister-image --image-id "$id" && log "deregistered $id"
      for s in $snaps; do
        [[ $s == None || -z $s ]] && continue
        ec2 delete-snapshot --snapshot-id "$s" 2>/dev/null && log "deleted snapshot $s" \
          || log "could not delete snapshot $s (in use by another image?)"
      done
      ;;
    create|"")
      [[ -n $INSTANCE_ID ]] || die "no instance in .env - nothing to snapshot"
      local s name ami
      s=$(ec2 describe-instances --instance-ids "$INSTANCE_ID" \
          --query 'Reservations[0].Instances[0].State.Name' --output text)
      [[ $s == stopped ]] || say "note: imaging a $s instance; stop it first for a consistent image"
      name="${TS_HOST}-$(date -u +%Y%m%d-%H%M%S)"
      say "creating image $name (several minutes)"
      ami=$(ec2 create-image --instance-id "$INSTANCE_ID" --name "$name" \
        --description "cloud_gaming saved desktop" \
        --tag-specifications "ResourceType=image,Tags=[{Key=Name,Value=${TS_HOST}-image}]" \
        --query ImageId --output text)
      log "$ami"
      wait_image_available "$REGION" "$ami"
      log "ready - cg init will restore from it instead of rebuilding"
      ;;
    *) die "usage: cg snapshot [create|--list|--delete <id>]" ;;
  esac
}

cmd_log() {
  local what="${1:-build}"
  case $what in
    build)    if (( WATCH )); then box 'sudo tail -f /var/log/cloud-gaming-bootstrap.log'
              else box 'sudo tail -n 200 /var/log/cloud-gaming-bootstrap.log'; fi ;;
    steam)    if (( WATCH )); then box 'tail -f ~/steam-prewarm.log'
              else box 'tail -n 200 ~/steam-prewarm.log'; fi ;;
    watchdog) if (( WATCH )); then box 'journalctl -t idle-watchdog -f'
              else box 'journalctl -t idle-watchdog -n 50 --no-pager'; fi ;;
    disk)     if (( WATCH )); then box 'journalctl -t disk-monitor -f'
              else box 'journalctl -t disk-monitor -n 50 --no-pager'; fi ;;
    sunshine) if (( WATCH )); then box 'journalctl --user -u app-dev.lizardbyte.app.Sunshine -f'
              else box 'journalctl --user -u app-dev.lizardbyte.app.Sunshine -n 80 --no-pager'; fi ;;
    *) die "usage: cg log [build|steam|watchdog|disk|sunshine] [--watch]" ;;
  esac
}

cmd_ping() {
  need_node
  # Latency alone does not explain a bad session; whether the path is direct or
  # relayed through DERP usually does, and nothing else surfaces it.
  local out
  if (( WATCH )); then
    exec tailscale ping --until-direct=false "$TS_NODE"
  fi
  out=$(tailscale ping -c 5 --timeout 3s "$TS_NODE" 2>&1 || true)
  local path="unknown" ms=""
  # `|| true` on every one of these: the whole script runs under `set -e`, and a
  # grep that simply does not match is the normal case here, not an error. Without
  # it `cg ping` exited silently and printed nothing at all.
  grep -q 'via DERP' <<<"$out" && path="DERP relay (slower - UDP 41641 may be blocked)" || true
  grep -qE 'via [0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' <<<"$out" && path="direct" || true
  ms=$(grep -oE 'in [0-9]+ms' <<<"$out" | grep -oE '[0-9]+' | sort -n \
       | awk '{a[NR]=$1} END{if(NR)printf "%d", a[int((NR+1)/2)]}' || true)
  if (( JSON )); then
    printf '{"node":"%s","path":"%s","median_ms":%s}\n' "$TS_NODE" "${path%% *}" "${ms:-null}"
  else
    printf '\n  node    %s (%s)\n' "$TS_NODE" "$(tailscale ip -4 "$TS_NODE" 2>/dev/null)"
    printf '  path    %s\n' "$path"
    printf '  latency %s\n\n' "${ms:+${ms}ms median}${ms:-no reply}"
    [[ $path == DERP* ]] && printf '  A relayed path adds latency and costs bandwidth both ways.\n  Check the security group still allows inbound UDP 41641.\n\n' || true
  fi
}

cmd_watcher() {
  if (( WATCH )); then box 'journalctl -t idle-watchdog -f'; return; fi
  say "guards"
  local s
  s=$(ec2 describe-instances --instance-ids "${INSTANCE_ID:-x}" \
      --query 'Reservations[0].Instances[0].State.Name' --output text 2>/dev/null || echo "none")
  log "instance          $s"
  stranded_spot_note "$REGION" "${INSTANCE_ID:-}"
  # Layer 2, on the box.
  if [[ $s == running ]] && box true 2>/dev/null; then
    # Same `|| echo` trap as documented in cmd_watchdog status: is-active prints
    # "inactive" and exits non-zero, so the fallback gets appended to a real
    # answer instead of replacing a missing one.
    local ohw
    ohw=$(box 'systemctl is-active idle-watchdog.timer 2>/dev/null' 2>/dev/null) || true
    ohw=${ohw//[$'\r\n']/}
    log "on-host watchdog  ${ohw:-unreachable}"
    log "shutdown action   $(ec2 describe-instance-attribute --instance-id "$INSTANCE_ID" \
         --attribute instanceInitiatedShutdownBehavior \
         --query 'InstanceInitiatedShutdownBehavior.Value' --output text 2>/dev/null)  <- must be 'stop'"
    echo
    box 'journalctl -t idle-watchdog -n 8 --no-pager -o cat 2>/dev/null | sed "s/^/      /"' || true
  else
    log "on-host watchdog  (box not reachable)"
  fi
  # Layer 4, off site. The comment here used to claim layers 3 AND 4 were
  # reported below, while only the alarm was - so the one guard that keeps
  # working when everything else is gone was the one nothing displayed. It had
  # been running blind on a revoked key with nobody able to see it, because
  # only `cg init` ever checked.
  echo
  if [[ -n ${GAME_WATCHDOG_HOST:-} ]]; then
    wd_rsh_init
    local wst wline
    # `systemctl is-active` PRINTS its answer and EXITS non-zero when the unit
    # is not active, so `$(ssh ... || echo unreachable)` yields "inactive" AND
    # "unreachable" on two lines. This is the same shape as `$(grep -c ... ||
    # echo 0)` producing "0\n0" - fixed in lib/setup one commit earlier and
    # then written again here. Tolerate the exit status, read the text, and
    # treat only EMPTY output as "could not reach the host".
    wst=$("${WD_RSH[@]}" 'systemctl is-active remote-watchdog.timer 2>/dev/null' 2>/dev/null) || true
    wst=${wst//[$'\r\n']/}
    log "off-site watchdog ${wst:-unreachable}  on ${GAME_WATCHDOG_HOST#*@}"
    wline=$("${WD_RSH[@]}" 'sudo tail -1 /var/log/cloud-gaming-watchdog.log 2>/dev/null' 2>/dev/null)
    [[ -n ${wline:-} ]] && log "  last            ${wline#* }"
    if [[ ${wline:-} == *"CANNOT QUERY AWS"* ]]; then
      log "  ^ BLIND - its credentials do not work, so layer 4 is decoration"
      log "    cg init reissues the key and pushes it; or: cg watchdog install"
    fi
  else
    log "off-site watchdog not configured (set GAME_WATCHDOG_HOST in .env)"
  fi

  echo
  log "idle alarm        $(aws cloudwatch describe-alarms --region "$REGION" \
        --alarm-names "${TS_HOST}-idle-stop" \
        --query 'MetricAlarms[0].[StateValue,ActionsEnabled]' \
        --output text 2>/dev/null | tr '\t' ' ' || echo absent)  <- state, actions-enabled"
  log "budget            $(aws budgets describe-budgets --account-id \
        "$(aws sts get-caller-identity --query Account --output text)" \
        --query "Budgets[?BudgetName=='${TS_HOST}-monthly'].BudgetLimit.Amount" \
        --output text 2>/dev/null || echo absent)"
}

