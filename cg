# What Steam is actually doing: installed, downloading, running, or only in the
# archive. Every fact here already existed - the appmanifests on the box, the
# index in S3, the interface counters the watchdog reads - and none of it was
# reachable without ssh-ing in and reading .acf files by hand.
#
# StateFlags is a bitfield, not an enum, which is why "1042" means nothing on
# its own: 1024 UpdateStarted + 16 Locked + 2 UpdateRequired = downloading.
cmd_games() {
  case "${1:-}" in
    --volume|volume) shift; games_volume "$@"; return ;;
  esac
  need_node
  local raw
  raw=$(box '
    for f in /scratch/steam/steamapps/appmanifest_*.acf; do
      [ -f "$f" ] || continue
      id=$(basename "$f" .acf); id=${id#appmanifest_}
      name=$(sed -n "s/.*\"name\"[[:space:]]*\"\(.*\)\".*/\1/p" "$f" | head -1)
      flags=$(sed -n "s/.*\"StateFlags\"[[:space:]]*\"\([0-9]*\)\".*/\1/p" "$f" | head -1)
      size=$(sed -n "s/.*\"SizeOnDisk\"[[:space:]]*\"\([0-9]*\)\".*/\1/p" "$f" | head -1)
      got=$(sed -n "s/.*\"BytesDownloaded\"[[:space:]]*\"\([0-9]*\)\".*/\1/p" "$f" | head -1)
      want=$(sed -n "s/.*\"BytesToDownload\"[[:space:]]*\"\([0-9]*\)\".*/\1/p" "$f" | head -1)
      dir=$(sed -n "s/.*\"installdir\"[[:space:]]*\"\(.*\)\".*/\1/p" "$f" | head -1)
      stage=$(sed -n "s/.*\"BytesToStage\"[[:space:]]*\"\([0-9]*\)\".*/\1/p" "$f" | head -1)
      on=0; pgrep -f "[/]steamapps/common/$dir/" >/dev/null 2>&1 && on=1
      # Steam.s own BytesDownloaded lags badly - it read 0.6 GB with 67 GB on
      # disk - so progress comes from the DISK: what is committed plus what is
      # staged in downloading/, against BytesToStage.
      done_b=$(du -sb "/scratch/steam/steamapps/common/$dir" 2>/dev/null | cut -f1)
      printf "APP\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n" "$id" "$name" "${flags:-0}" "${size:-0}" "${done_b:-0}" "${want:-0}" "$on" "${stage:-0}"
    done
    printf "DISK\t%s\n" "$(df -B1 --output=used,avail /scratch | tail -1 | tr -s " " "\t" | sed "s/^\t//")"
    printf "DL\t%s\n" "$(du -sb /scratch/steam/steamapps/downloading 2>/dev/null | cut -f1 || echo 0)"
    # Two samples three seconds apart: a rate averaged over the whole boot is
    # not the rate right now, and "right now" is what an ETA needs.
    w=$(ip route show default 2>/dev/null | awk "{print \$5; exit}")
    r1=$(cat /sys/class/net/${w:-eth0}/statistics/rx_bytes 2>/dev/null || echo 0)
    sleep 3
    r2=$(cat /sys/class/net/${w:-eth0}/statistics/rx_bytes 2>/dev/null || echo 0)
    printf "RATE\t%s\n" "$(( (r2 - r1) / 3 ))"
  ' 2>/dev/null) || die "could not read the box"

  local idx; idx=$(library_index 2>/dev/null || echo '"'"'{"apps":[]}'"'"')
  RAW="$raw" IDX="$idx" python3 -c '
import json, os, sys
GB = 1073741824.0
apps, disk, staging, rate = [], None, 0, 0
for line in os.environ["RAW"].splitlines():
    f = line.split("\t")
    if f[0] == "APP" and len(f) >= 9:
        apps.append(dict(zip(("id","name","flags","size","done","want","on","stage"), f[1:9])))
    elif f[0] == "DISK" and len(f) >= 3: disk = (int(f[1]), int(f[2]))
    elif f[0] == "DL"   and len(f) >= 2: staging = int(f[1] or 0)
    elif f[0] == "RATE" and len(f) >= 2: rate = int(f[1] or 0)
try:    archived = {str(a["appid"]): a for a in json.loads(os.environ["IDX"]).get("apps", [])}
except Exception: archived = {}

def state(flags, running):
    n = int(flags or 0)
    if running:        return "RUNNING"
    if n & 1024:       return "downloading"
    if n & 512:        return "paused"
    if n & 2:          return "update needed"
    if n & 32:         return "files missing"
    if n & 128:        return "files corrupt"
    if n & 4:          return "installed"
    if n & 1:          return "uninstalled"
    return "flags %d" % n

rows = []
downloading = [a for a in apps if int(a["flags"] or 0) & 1024]
for a in apps:
    size, done, target = int(a["size"]), int(a["done"]), int(a["stage"] or 0)
    st = state(a["flags"], a["on"] == "1")
    extra = ""
    if st == "downloading" and target > 0:
        # downloading/ is shared, so only attribute it when one game is using it.
        on_disk = done + (staging if len(downloading) == 1 else 0)
        pct = min(100.0, 100.0 * on_disk / target)
        left = max(0, target - on_disk)
        extra = "%.0f%% of %.0f GB" % (pct, target / GB)
        if rate > 1_000_000:
            extra += ", ~%.0f min left" % (left / rate / 60)
        shown = on_disk
    else:
        shown = size if size else done
        # The manifest is one small file. A restore that copies it and then runs
        # out of room leaves a game that CLAIMS to be installed at full size
        # with most of its bytes missing - so trust the disk, not the manifest.
        if size and done and done < size * 0.95:
            shown = done
            extra = "INCOMPLETE - %.0f GB of %.0f GB on disk" % (done / GB, size / GB)
    rows.append((a["name"][:28], st, shown / GB, extra))
    archived.pop(a["id"], None)
for a in archived.values():
    rows.append((a.get("name","?")[:28], "in S3 only", a.get("bytes",0)/GB, "cg init offers it"))

if not rows:
    print("  no games installed, and nothing archived")
else:
    print("  %-28s %-14s %9s  %s" % ("GAME","STATE","SIZE",""))
    for n, st, g, x in rows:
        print("  %-28s %-14s %6.1f GB  %s" % (n, st, g, x))
if disk:
    used, avail = disk
    print("\n  disk   %.0f GB used, %.0f GB free" % (used/GB, avail/GB))
    if rate > 100_000: print("  link   %.0f Mbps inbound right now" % (rate*8/1e6))
'
}

games_volume() {
  local vol az size state
  read -r vol az size state < <(ec2 describe-volumes \
    --filters "Name=tag:Name,Values=${TS_HOST}-games" \
    --query 'Volumes[0].[VolumeId,AvailabilityZone,Size,State]' --output text 2>/dev/null)
  if [[ -z ${vol:-} || $vol == None ]]; then
    echo "no EBS game volume exists - nothing billing."
    echo "the game library lives in S3 now: cg library"
    return 0
  fi
  case "${1:-show}" in
    show|"")
      awk -v v="$vol" -v a="$az" -v s="$size" -v st="$state" 'BEGIN{
        m=s*0.0912;
        printf "  volume   %s  (%s)\n", v, st;
        printf "  zone     %s\n", a;
        printf "  size     %s GB\n", s;
        printf "  cost     $%.2f/month (INR %.0f) - billed whether or not the box exists\n", m, m*88;
      }'
      echo "  status   LEGACY - nothing mounts or attaches this any more."
      echo "           the library is in S3: cg library"
      echo "  delete   cg games --delete   (permanent; anything left on it goes too)" ;;
    --delete|delete)
      [[ $state == available ]] || die "volume is $state - stop or destroy the instance first"
      echo "Nothing uses this volume any more; the games are in S3 (cg library)."
      echo "This permanently deletes $vol and every game on it."
      read -r -p "type DELETE to confirm: " a
      [[ $a == DELETE ]] || { echo "aborted"; return 1; }
      ec2 delete-volume --volume-id "$vol" >/dev/null && log "deleted $vol"
      log "storage charges stop now" ;;
    *) die "usage: cg games [show|--delete]" ;;
  esac
}

cmd_snapshot() {
  case "${1:-create}" in
    --list|list)
      # Images bill every month, forever, and nothing else here lists them -
      # a create-only snapshot command is a slow leak.
      local imgs
      imgs=$(ec2 describe-images --owners self \
        --query 'reverse(sort_by(Images,&CreationDate))[].{id:ImageId,name:Name,created:CreationDate,state:State,gb:BlockDeviceMappings[0].Ebs.VolumeSize}' \
        --output json)
      if (( JSON )); then printf '%s\n' "$imgs"; return; fi
      # The table's header starts at column 0, where cg_report reads a capitalised
      # word as a section heading - so on a terminal the rows are indented first.
      # Off one, cat: the plain listing is unchanged.
      python3 - <<PY | { if _cg_styled; then sed 's/^/  /' | cg_report "💿" "Saved images"; else cat; fi; }
import json,sys
imgs=json.loads('''$imgs''')
if not imgs: print("no saved images - nothing billing"); sys.exit()
print(f"{'IMAGE':<24}{'CREATED':<22}{'GB':>4}  {'~USD/mo':>8}  NAME")
tot=0.0
for i in imgs:
    gb=i.get('gb') or 0
    mo=gb*0.05          # EBS snapshot storage, approx
    tot+=mo
    print(f"{i['id']:<24}{i['created'][:19]:<22}{gb:>4}  {mo:>8.2f}  {i['name']}")
print(f"\nestimated {tot:.2f} USD/month (~INR {tot*88:.0f}) for {len(imgs)} image(s)")
print("delete one with:  cg snapshot --delete <image-id>")
PY
      ;;
    --delete|delete)
      local id="${2:-}"
      [[ -n $id ]] || die "which image? see: cg snapshot --list"
      # Deregistering leaves the backing snapshots behind, still billing - that
      # is the classic way to believe you deleted something and keep paying.
      local snaps
      snaps=$(ec2 describe-images --image-ids "$id" \
        --query 'Images[0].BlockDeviceMappings[].Ebs.SnapshotId' --output text 2>/dev/null || true)
      ec2 deregister-image --image-id "$id" && log "deregistered $id"
      for s in $snaps; do
        [[ $s == None || -z $s ]] && continue
        ec2 delete-snapshot --snapshot-id "$s" 2>/dev/null && log "deleted snapshot $s" \
          || log "could not delete snapshot $s (in use by another image?)"
      done
      ;;
    create|"")
      [[ -n $INSTANCE_ID ]] || die "no instance in .env - nothing to snapshot"
      local s name ami
      s=$(ec2 describe-instances --instance-ids "$INSTANCE_ID" \
          --query 'Reservations[0].Instances[0].State.Name' --output text)
      [[ $s == stopped ]] || say "note: imaging a $s instance; stop it first for a consistent image"
      name="${TS_HOST}-$(date -u +%Y%m%d-%H%M%S)"
      say "creating image $name (several minutes)"
      ami=$(ec2 create-image --instance-id "$INSTANCE_ID" --name "$name" \
        --description "cloud_gaming saved desktop" \
        --tag-specifications "ResourceType=image,Tags=[{Key=Name,Value=${TS_HOST}-image}]" \
        --query ImageId --output text)
      log "$ami"
      wait_image_available "$REGION" "$ami"
      log "ready - cg init will restore from it instead of rebuilding"
      ;;
    *) die "usage: cg snapshot [create|--list|--delete <id>]" ;;
  esac
}

