cmd_ping() {
  need_node
  # Latency alone does not explain a bad session; whether the path is direct or
  # relayed through DERP usually does, and nothing else surfaces it.
  local out
  if (( WATCH )); then
    exec tailscale ping --until-direct=false "$TS_NODE"
  fi
  out=$(tailscale ping -c 5 --timeout 3s "$TS_NODE" 2>&1 || true)
  local path="unknown" ms=""
  # `|| true` on every one of these: the whole script runs under `set -e`, and a
  # grep that simply does not match is the normal case here, not an error. Without
  # it `cg ping` exited silently and printed nothing at all.
  grep -q 'via DERP' <<<"$out" && path="DERP relay (slower - UDP 41641 may be blocked)" || true
  grep -qE 'via [0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' <<<"$out" && path="direct" || true
  ms=$(grep -oE 'in [0-9]+ms' <<<"$out" | grep -oE '[0-9]+' | sort -n \
       | awk '{a[NR]=$1} END{if(NR)printf "%d", a[int((NR+1)/2)]}' || true)
  if (( JSON )); then
    printf '{"node":"%s","path":"%s","median_ms":%s}\n' "$TS_NODE" "${path%% *}" "${ms:-null}"
  else
    {
      printf '\n  node    %s (%s)\n' "$TS_NODE" "$(tailscale ip -4 "$TS_NODE" 2>/dev/null)"
      printf '  path    %s\n' "$path"
      printf '  latency %s\n\n' "${ms:+${ms}ms median}${ms:-no reply}"
      [[ $path == DERP* ]] && printf '  A relayed path adds latency and costs bandwidth both ways.\n  Check the security group still allows inbound UDP 41641.\n\n' || true
    } | cg_report "📡" "connection to $TS_NODE"
  fi
}

# `cg watcher --json`: every guard as data - what it catches, whether it is
# armed, and what it last decided. Same queries as the report.
watcher_json() {
  local st ohw sb want rule last ms msg lifecycle
  st=$(ec2 describe-instances --instance-ids "${INSTANCE_ID:-x}" \
       --query 'Reservations[0].Instances[0].State.Name' --output text 2>/dev/null || echo none)
  ohw="" sb="" want=""
  if [[ $st == running ]] && box true 2>/dev/null; then
    ohw=$(box 'systemctl is-active idle-watchdog.timer 2>/dev/null' 2>/dev/null) || true
    ohw=${ohw//[$'\r\n']/}
    sb=$(ec2 describe-instance-attribute --instance-id "$INSTANCE_ID" \
         --attribute instanceInitiatedShutdownBehavior \
         --query 'InstanceInitiatedShutdownBehavior.Value' --output text 2>/dev/null) || sb=""
    lifecycle=$(ec2 describe-instances --instance-ids "$INSTANCE_ID" \
                --query 'Reservations[0].Instances[0].InstanceLifecycle' --output text 2>/dev/null) || lifecycle=""
    [[ $lifecycle == spot ]] && want=terminate || want=stop
  fi
  rule=$(cw_aws events describe-rule --name "$CW_NAME" --query State --output text 2>/dev/null) || rule=""
  last=$(cw_aws logs filter-log-events --log-group-name "$CW_LOGS" \
           --start-time "$(( ($(date +%s) - 3600) * 1000 ))" --filter-pattern '"cg-watchdog:"' \
           --query 'events[-1].[timestamp,message]' --output text 2>/dev/null) || last=""
  IFS=$'\t' read -r ms msg <<<"$last"

  local acct budget alerts
  # || acct="" matters: with no AWS CLI at all this assignment fails with 127,
  # and under `set -e` the whole read died there - printing NOTHING, so the app
  # had only "cg watcher failed (exit 127)" to show for it. A guard panel that
  # says every guard is unknown is a usable answer; an empty screen is not.
  acct=$(aws sts get-caller-identity --query Account --output text 2>/dev/null) || acct=""
  budget=$(aws budgets describe-budget --account-id "$acct" --budget-name "${TS_HOST}-monthly" \
    --query 'Budget.BudgetLimit.Amount' --output text 2>/dev/null || echo "")
  alerts=$(aws budgets describe-notifications-for-budget --account-id "$acct" \
    --budget-name "${TS_HOST}-monthly" --query 'length(Notifications)' --output text 2>/dev/null || echo 0)

  W_STATE="$st" W_OHW="$ohw" W_SHUTDOWN="$sb" W_WANT="$want" W_RULE="$rule" \
  W_LAST_MS="${ms:-}" W_LAST_MSG="${msg:-}" W_BUDGET="$budget" W_ALERTS="$alerts" \
  W_ARCHIVE="$(cw_archive_line)" W_HOST="$TS_HOST" \
  W_IDLE="$(cw_setting GAME_WATCHDOG_IDLE_MIN)" W_STUCK="$(cw_setting GAME_WATCHDOG_STUCK_MIN)" W_EVERY="$CW_EVERY_MIN" \
  W_HOST_IDLE="$(sed -n 's/^IDLE_LIMIT="${IDLE_LIMIT:-\([0-9]*\)}".*/\1/p' host/idle-watchdog.sh 2>/dev/null)" \
  python3 -c '
import json, os, time
g = os.environ.get
ms = g("W_LAST_MS")
age = int(time.time() - int(ms) / 1000) if ms.isdigit() else None
msg = g("W_LAST_MSG").replace("cg-watchdog: ", "") or None
budget = g("W_BUDGET")
# The minutes each watchdog waits, as they are set rather than as they were when
# this was written: the cloud ones are settings with their floors applied
# (cw_setting), the on-host one is read from its own script, and none is
# written here. One that cannot be read is null.
num = lambda k: int(g(k)) if (g(k) or "").isdigit() else None
idle, stuck, host_idle, every = num("W_IDLE"), num("W_STUCK"), num("W_HOST_IDLE"), num("W_EVERY")
print(json.dumps({
  "host": g("W_HOST"),
  "instance_state": g("W_STATE"),
  "guards": [
    {"layer": 1, "name": "session", "dies_with": "your laptop",
     "catches": "normal use", "reaction": "on Moonlight exit",
     "armed": None, "state": "always on",
     "note": "cg open ends the session when Moonlight quits"},
    # It lives ON the box: with no box there is nothing to arm, which is not the
    # same as a guard that should be running and is not.
    {"layer": 2, "name": "on-host watchdog", "dies_with": "the box it protects",
     "catches": "a forgotten disconnect, a crashed client",
     "reaction": f"{host_idle} min idle" if host_idle is not None else "idle",
     "idle_min": host_idle,
     "armed": (g("W_OHW") == "active") if g("W_OHW") else None,
     "state": "armed" if g("W_OHW") == "active" else (
              "not armed" if g("W_OHW") else
              ("no box" if g("W_STATE") in ("none", "terminated", "") else "box not reachable")),
     "note": g("W_OHW") or ("installed during the build, armed while the box runs"
                            if g("W_STATE") in ("none", "terminated", "") else "box not reachable")},
    {"layer": 3, "name": "cloud watchdog", "dies_with": "a deleted schedule",
     "catches": "a wedged box, one left running, one stuck going down",
     "reaction": f"{idle} min idle; forced after {stuck} min stuck",
     "idle_min": idle, "stuck_min": stuck, "every_min": every,
     "armed": g("W_RULE") == "ENABLED",
     "state": "armed" if g("W_RULE") == "ENABLED" else (g("W_RULE").lower() or "not installed"),
     "note": g("W_RULE") or "not installed",
     "last_decision": msg, "last_decision_age_s": age},
  ],
  "shutdown_action": {"value": g("W_SHUTDOWN") or None, "expected": g("W_WANT") or None,
                      "ok": bool(g("W_SHUTDOWN")) and g("W_SHUTDOWN") == g("W_WANT")},
  "budget": {"usd": float(budget) if budget not in ("", "None") else None,
             "alerts": int(g("W_ALERTS") or 0)},
  "archive": g("W_ARCHIVE") or None,
}, indent=2))'
}

# cg aws forget [--anyway] - this laptop stops playing on AWS. The region it was
# set up in leaves .env, which is what "an AWS machine" means here: the app then
# shows none and asks AWS nothing. Only when nothing cg made there still bills:
# no machine, and no saved games in any region. Nothing in AWS is deleted, and
# the access key stays in ~/.aws/credentials - other tools on this laptop may
# use it. Exit 3 when AWS could not be asked, so whether anything bills is not
# known; --anyway forgets it all the same.
cmd_aws_forget() {
  local anyway=0 st n other
  [[ ${1:-} == --anyway ]] && anyway=1
  grep -q '^GAME_REGION=.' "$(cg_env_file)" 2>/dev/null || { log "AWS is not set up on this laptop - nothing to forget"; return 0; }
  if (( ! anyway )); then
    say "checking nothing is left billing on AWS"
    st=$(box_state)
    case $st in
      none|terminated) ;;
      unknown|"") ( die "AWS could not be asked whether a machine is still there" ) || exit 3 ;;
      *) die "a machine is still on AWS ($st) - delete it first: cg destroy" ;;
    esac
    n=$(library_index 2>/dev/null | python3 -I -c 'import json,sys; print(len(json.load(sys.stdin).get("apps") or []))' 2>/dev/null) \
      || { ( die "AWS could not be asked about your saved games" ) || exit 3; }
    (( n == 0 )) || die "$n game$( (( n == 1 )) || echo s) still saved in AWS - delete them first, or keep using AWS: cg library list"
    other=$(library_elsewhere_json | python3 -I -c 'import json,sys
d = json.load(sys.stdin)
if d.get("error"): sys.exit(1)
print(sum(len(p.get("games") or []) for p in d.get("places") or []))' 2>/dev/null) \
      || { ( die "AWS could not be asked about games saved in other regions" ) || exit 3; }
    (( other == 0 )) || die "$other game$( (( other == 1 )) || echo s) still saved in another AWS region - see cg library elsewhere"
  fi
  cg_env_unset GAME_REGION || die "could not write .env"
  log_as ok "this laptop no longer plays on AWS"
  log "nothing in AWS was deleted; your access key stays in ~/.aws/credentials"
}

# aws_inventory_json - everything of cg's in this AWS account that a disconnect
# would delete, read live, with what each bills a month. An unknown price is
# null, never 0; "error" says AWS could not be asked, and then nothing else in
# it can be trusted.
aws_inventory_json() {
  local work acct b
  work=$(mktemp -d)
  acct=$(aws sts get-caller-identity --query Account --output text 2>/dev/null) || acct=""
  if [[ -z $acct ]]; then
    printf '{"error": "AWS could not be asked what is there", "items": [], "usd_month": null}\n'
    rm -rf "$work"; return 0
  fi
  # Machines cg launched, in any state that still bills or can come back.
  ec2 describe-instances --filters "Name=tag:Name,Values=$TS_HOST" \
      "Name=instance-state-name,Values=pending,running,stopping,stopped" \
      --query 'Reservations[].Instances[].[InstanceId,State.Name,InstanceType]' --output text \
      > "$work/machines" 2>/dev/null || echo ERR > "$work/machines"
  # The saved games cg uses, and every other region's (library elsewhere).
  b=$(cg_bucket 2>/dev/null) || b=""
  if [[ -n $b ]] && aws s3api head-bucket --bucket "$b" >/dev/null 2>&1; then
    printf '%s\t%s\n' "$b" "$REGION" > "$work/here"
    aws s3 ls "s3://$b" --recursive --summarize 2>/dev/null | awk '/Total Size:/{print $3}' > "$work/here.bytes"
    library_index 2>/dev/null > "$work/here.idx" || true
    # The saved Steam login lives in the same bucket, and goes with it - said.
    aws s3 ls "s3://$b/steam/account/" 2>/dev/null | grep . >/dev/null && echo yes > "$work/here.login"
  fi
  library_elsewhere_json > "$work/elsewhere" 2>/dev/null || true
  # Disks and disk images left over, which bill by the GB with nothing attached.
  ec2 describe-volumes --filters Name=status,Values=available \
      --query 'Volumes[].[VolumeId,Size]' --output text > "$work/volumes" 2>/dev/null || echo ERR > "$work/volumes"
  ec2 describe-images --owners self --query 'Images[].[ImageId,BlockDeviceMappings[0].Ebs.VolumeSize]' \
      --output text > "$work/images" 2>/dev/null || echo ERR > "$work/images"
  # Its settings in SSM - the watchdog's marks and each game's keep timer -
  # free, but cg's: in this region and every region that has saved games.
  local r regions
  regions=$(printf '%s\n' "$REGION"; python3 -I -c 'import json,sys
try: d = json.load(open(sys.argv[1]))
except Exception: sys.exit()
for p in (d or {}).get("places") or []:
    if p.get("region"): print(p["region"])' "$work/elsewhere" 2>/dev/null)
  for r in $(sort -u <<<"$regions"); do
    aws ssm get-parameters-by-path --region "$r" --path "/cloud-gaming/$TS_HOST" --recursive \
        --query 'Parameters[].Name' --output text 2>/dev/null | tr '\t' '\n' \
      | awk -v r="$r" 'NF && $0 != "None" {print r "\t" $0}' >> "$work/ssm"
  done
  cw_exists && echo yes > "$work/watchdog"
  aws budgets describe-budget --account-id "$acct" --budget-name "${TS_HOST}-monthly" >/dev/null 2>&1 \
    && echo yes > "$work/budget"
  WORK="$work" GB_S3="${CG_S3_USD_GB_MONTH:-}" GB_EBS="${CG_EBS_USD_GB_MONTH:-}" \
  GB_SNAP="${CG_SNAPSHOT_USD_GB_MONTH:-}" INR="${CG_INR_PER_USD:-}" REGION="$REGION" python3 -I -c '
import json, os
w = os.environ["WORK"]
def read(f):
    p = os.path.join(w, f)
    return open(p).read() if os.path.exists(p) else ""
def num(v):
    try: return float(v)
    except (TypeError, ValueError): return None
S3, EBS, SNAP = num(os.environ["GB_S3"]), num(os.environ["GB_EBS"]), num(os.environ["GB_SNAP"])
GB = 1073741824.0
month = lambda gb, rate: None if rate is None or gb is None else round(gb * rate, 2)
items, errors = [], []
def rows(f):
    t = read(f).strip()
    if t == "ERR": errors.append(f); return []
    return [l.split("\t") for l in t.splitlines() if l.strip() and l.strip() != "None"]
for iid, state, typ in [(r + ["", "", ""])[:3] for r in rows("machines")]:
    items.append({"kind": "machine", "label": "Machine", "detail": "%s, %s" % (typ, state),
                  "usd_month": None, "bills": True, "hourly": state in ("pending", "running")})
here = read("here").strip()
if here:
    bucket, region = here.split("\t")
    size = num(read("here.bytes").strip()) or 0
    try: n = len(json.loads(read("here.idx") or "{}").get("apps") or [])
    except Exception: n = 0
    login = " and the saved Steam login" if read("here.login").strip() else ""
    items.append({"kind": "games", "label": "Saved games", "region": region, "bucket": bucket, "games": n,
                  "detail": "%d game%s, %.1f GB%s" % (n, "" if n == 1 else "s", size / GB, login),
                  "usd_month": month(size / GB, S3), "bills": True})
try: el = json.loads(read("elsewhere") or "null")
except Exception: el = None
if not el or el.get("error"): errors.append("elsewhere")
else:
    for p in el.get("places") or []:
        if p.get("error"): errors.append("elsewhere"); continue
        n = len(p.get("games") or [])
        items.append({"kind": "games", "label": "Saved games elsewhere", "region": p["region"], "bucket": p["bucket"],
                      "games": n, "detail": "%d game%s, %.1f GB in %s%s" % (n, "" if n == 1 else "s", (p["bytes"] or 0) / GB, p["region"],
                                                                      " and a saved Steam login" if p.get("login") else ""),
                      "usd_month": p.get("usd_month"), "bills": True})
vols = rows("volumes")
if vols:
    gb = sum(num(v[1]) or 0 for v in vols if len(v) > 1)
    items.append({"kind": "disks", "label": "Leftover disks", "detail": "%d, %d GB" % (len(vols), gb),
                  "usd_month": month(gb, EBS), "bills": True})
imgs = rows("images")
if imgs:
    gb = sum(num(i[1]) or 0 for i in imgs if len(i) > 1)
    items.append({"kind": "images", "label": "Disk images", "detail": "%d, with their snapshots" % len(imgs),
                  "usd_month": month(gb, SNAP), "bills": True})
if read("watchdog").strip(): items.append({"kind": "watchdog", "label": "Cloud watchdog", "detail": "function, schedule, role, logs", "usd_month": 0, "bills": False})
if read("budget").strip():   items.append({"kind": "budget", "label": "Budget alert", "detail": "", "usd_month": 0, "bills": False})
marks = [l.split("\t") for l in read("ssm").splitlines() if "\t" in l]
if marks:
    items.append({"kind": "settings", "label": "Game timers", "detail": "%d setting%s in SSM" % (len(marks), "" if len(marks) == 1 else "s"),
                  "usd_month": 0, "bills": False, "names": [{"region": r, "name": n} for r, n in marks]})
known = [i["usd_month"] for i in items if i["usd_month"] is not None]
print(json.dumps({"error": ("AWS could not be asked: " + ", ".join(sorted(set(errors)))) if errors else None,
                  "region": os.environ["REGION"], "items": items,
                  "hourly": any(i.get("hourly") for i in items),
                  "usd_month": round(sum(known), 2) if len(known) == len(items) else None,
                  "inr_per_usd": num(os.environ["INR"])}, indent=2))'
  rm -rf "$work"
}

# cg aws disconnect [--plan] - this laptop stops playing on AWS, and leaves
# nothing there that bills: the machine, every region's saved games, leftover
# disks and images, the watchdog, the budget - cg destroy --all, every other
# region's archive, then a look to make sure. What stays is free and yours:
# the account, the access key it signs in with, region opt-ins and GPU quota.
# --plan only says what is there (with --json, as data). Saved games cannot be
# brought back, so it asks for DELETE first.
cmd_aws_disconnect() {
  local plan=0 inv left p
  [[ ${1:-} == --plan ]] && plan=1
  grep -q '^GAME_REGION=.' "$(cg_env_file)" 2>/dev/null \
    || { (( plan && JSON )) && echo '{"connected": false, "items": []}'; log "AWS is not set up on this laptop - nothing to disconnect"; return 0; }
  inv=$(aws_inventory_json)
  if (( plan )); then
    if (( JSON )); then printf '%s\n' "$inv"; return 0; fi
    INV="$inv" python3 -I -c '
import json, os
d = json.loads(os.environ["INV"])
if d["error"]: print("  " + d["error"])
for i in d["items"]: print("  %-22s %s" % (i["label"], i["detail"]))
if not d["items"]: print("  nothing of cg is left in AWS")'
    return 0
  fi
  [[ $(python3 -I -c 'import json,sys; print(json.load(sys.stdin)["error"] or "")' <<<"$inv") == "" ]] \
    || { ( die "AWS could not be asked what is there - nothing was deleted" ) || exit 3; }
  say "this deletes everything cg has in AWS"
  INV="$inv" python3 -I -c '
import json, os
for i in json.loads(os.environ["INV"])["items"]: print("  %-22s %s" % (i["label"], i["detail"]))' | cg_relay ''
  log "your saved games cannot be brought back; the account, its access key, region opt-ins and GPU quota stay"
  cg_ask_typed aws-disconnect "  type DELETE to confirm: " DELETE \
    || { log "not confirmed - nothing was deleted"; return 1; }

  # The machine, this region's archive, IAM, the watchdog, the budget, leftovers.
  GAME_S3_BUCKET=$(cg_bucket 2>/dev/null || true) cmd_destroy --all --force \
    || die "the delete stopped - see above; what is left is still listed by cg aws disconnect --plan"
  # Every other region's saved games.
  while IFS=$'\t' read -r b r; do
    [[ -n $b ]] || continue
    say "deleting the saved games in $r (s3://$b)"
    aws s3 rb "s3://$b" --force --region "$r" >/dev/null 2>&1 || log_as fail "could not delete s3://$b"
  done < <(python3 -I -c 'import json,sys
for i in json.load(sys.stdin)["items"]:
    if i["kind"] == "games" and i["label"] == "Saved games elsewhere": print(i["bucket"] + "\t" + i["region"])' <<<"$inv")

  # Its settings in SSM, every region they were found in - ten names a call,
  # the most delete-parameters takes.
  while IFS=$'\t' read -r r names; do
    [[ -n $r ]] || continue
    say "deleting cg's settings in $r"
    # shellcheck disable=SC2086
    aws ssm delete-parameters --region "$r" --names $names >/dev/null 2>&1 || log_as fail "could not delete settings in $r"
  done < <(python3 -I -c 'import json,sys
by = {}
for i in json.load(sys.stdin)["items"]:
    for m in i.get("names") or []: by.setdefault(m["region"], []).append(m["name"])
for r, ns in by.items():
    for k in range(0, len(ns), 10): print(r + "\t" + " ".join(ns[k:k + 10]))' <<<"$inv")

  # A look, not a hope: anything of cg's still there - billing or not - is
  # said, and AWS stays set up here so it can still be seen and deleted.
  say "checking nothing is left"
  inv=$(aws_inventory_json)
  left=$(python3 -I -c 'import json,sys
d = json.load(sys.stdin)
if d["error"]: print("?\t" + d["error"])
for i in d["items"]: print(i["label"] + "\t" + i["detail"])' <<<"$inv")
  if [[ -n $left ]]; then
    while IFS=$'\t' read -r p d; do log_as fail "still there: $p${d:+ - $d}"; done <<<"$left"
    die "not everything could be deleted - AWS is still set up here so it can be seen; try again"
  fi
  cg_env_unset GAME_REGION || die "could not write .env"
  log_as ok "AWS disconnected - nothing of cg is left billing, nor anything else of cg's"
  log "the account, its access key, region opt-ins and GPU quota were kept; they cost nothing"
}

cmd_watcher() {
  if (( WATCH )); then box 'journalctl -t idle-watchdog -f'; return; fi
  if (( JSON )); then watcher_json; return; fi
  say "guards"
  local s
  s=$(ec2 describe-instances --instance-ids "${INSTANCE_ID:-x}" \
      --query 'Reservations[0].Instances[0].State.Name' --output text 2>/dev/null || echo "none")
  # Rows say what they mean rather than having it read from their words:
  # a row saying something was NOT enabled contained "enabled", and got a tick.
  log_as "$([[ $s == running ]] && echo ok || echo info)" "instance          $s"
  stranded_spot_note "$REGION" "${INSTANCE_ID:-}"
  # Layer 2, on the box.
  if [[ $s == running ]] && box true 2>/dev/null; then
    # Same `|| echo` trap as documented in cmd_watchdog status: is-active prints
    # "inactive" and exits non-zero, so the fallback gets appended to a real
    # answer instead of replacing a missing one.
    local ohw
    ohw=$(box 'systemctl is-active idle-watchdog.timer 2>/dev/null' 2>/dev/null) || true
    ohw=${ohw//[$'\r\n']/}
    log_as "$([[ $ohw == active ]] && echo ok || echo warn)" "on-host watchdog  ${ohw:-unreachable}"
    # What it MUST be depends on the purchase model, so say which. The hint used
    # to read "must be 'stop'" unconditionally, which became wrong the moment
    # spot switched to one-time+terminate - a correct setting flagged as an
    # error, next to a guard people are reading precisely to check it.
    local sb want
    sb=$(ec2 describe-instance-attribute --instance-id "$INSTANCE_ID" \
         --attribute instanceInitiatedShutdownBehavior \
         --query 'InstanceInitiatedShutdownBehavior.Value' --output text 2>/dev/null)
    if [[ $(ec2 describe-instances --instance-ids "$INSTANCE_ID" \
            --query 'Reservations[0].Instances[0].InstanceLifecycle' --output text 2>/dev/null) == spot ]]
    then want=terminate; else want=stop; fi
    log_as "$([[ $sb == "$want" ]] && echo ok || echo fail)" \
      "shutdown action   $sb  <- must be '$want' $([[ $sb == "$want" ]] && echo "(ok)" || echo "(WRONG)")"
    cg_gap
    box 'journalctl -t idle-watchdog -n 8 --no-pager -o cat 2>/dev/null' | cg_relay '      ' || true
  else
    log_as info "on-host watchdog  (box not reachable)"
  fi
  # Layer 3, the cloud watchdog: the guard that keeps working when the box is gone.
  cg_gap
  cw_watcher_lines

  cg_gap
  local bud
  bud=$(aws budgets describe-budgets --account-id \
        "$(aws sts get-caller-identity --query Account --output text)" \
        --query "Budgets[?BudgetName=='${TS_HOST}-monthly'].BudgetLimit.Amount" \
        --output text 2>/dev/null || echo absent)
  log_as "$([[ $bud =~ ^[0-9.]+$ ]] && echo ok || echo warn)" "budget            $bud"
}

